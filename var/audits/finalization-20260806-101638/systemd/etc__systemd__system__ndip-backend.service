[Unit]
Description=NDIP Backend
After=network.target

[Service]
User=nawaf511
WorkingDirectory=/opt/empire-core/backend

ExecStart=/opt/empire-core/backend/venv/bin/gunicorn app.main:app \
-k uvicorn.workers.UvicornWorker \
-w 1 \
-b 0.0.0.0:9001

Restart=always

[Install]
WantedBy=multi-user.target
