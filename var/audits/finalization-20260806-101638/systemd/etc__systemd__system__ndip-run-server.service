[Unit]
Description=NDIP Managed Run Server
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/empire-core/backend
ExecStart=/opt/empire-core/backend/bin/managed_start_server.sh
ExecStop=/bin/bash -lc 'pkill -f "python3 run_server.py" || true; pkill -f "python run_server.py" || true; rm -f /opt/empire-core/logs/active_port.txt /opt/empire-core/logs/run_server.pid'
User=nawaf511
Group=nawaf511

[Install]
WantedBy=multi-user.target
