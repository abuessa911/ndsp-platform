[Unit]
Description=NDSP Public Sanitized Gateway
After=network.target

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/var/www/ndsp-public-gateway
Environment=PORT=9010
Environment=NDSP_UPSTREAM=http://127.0.0.1:9001
ExecStart=/usr/bin/node /var/www/ndsp-public-gateway/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
