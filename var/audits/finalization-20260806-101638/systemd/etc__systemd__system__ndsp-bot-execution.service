[Unit]
Description=NDSP Bot Execution Service
After=network.target ndsp-completed-decision.service

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/backend/services/bot_execution
Environment=NODE_ENV=production
Environment=NDSP_BOT_EXECUTION_PORT=9080
Environment=NDSP_COMPLETED_DECISION_URL=http://127.0.0.1:9078
EnvironmentFile=-/home/nawaf511/empire-core-new/backend/.env
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/services/bot_execution/main.cjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
