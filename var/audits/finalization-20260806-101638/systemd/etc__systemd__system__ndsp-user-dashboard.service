[Unit]
Description=NDSP User Dashboard Data Gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/nawaf511/empire-core-new/backend/auth_api
EnvironmentFile=-/etc/ndsp/ndsp-market-data.env
EnvironmentFile=-/home/nawaf511/empire-core-new/backend/.env
Environment=NDSP_USER_DASHBOARD_PORT=9021
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/auth_api/ndsp_user_dashboard_gateway.cjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
