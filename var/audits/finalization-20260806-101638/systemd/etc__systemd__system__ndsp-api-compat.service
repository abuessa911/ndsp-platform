[Unit]
Description=NDSP API Compatibility Gateway
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/home/nawaf511/empire-core-new/backend/auth_api
EnvironmentFile=-/etc/ndsp/ndsp-db.env
EnvironmentFile=-/etc/ndsp/ndsp-session.env
EnvironmentFile=-/home/nawaf511/empire-core-new/backend/auth_api/.env
Environment=NDSP_API_COMPAT_PORT=9022
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/auth_api/ndsp_api_compat_gateway.cjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
