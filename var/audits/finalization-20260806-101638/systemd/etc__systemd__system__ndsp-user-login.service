[Unit]
Description=NDSP User Login Gateway
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/backend/auth_api
Environment=NODE_ENV=production
Environment=PORT=9020
Environment=HOST=127.0.0.1
Environment=PGHOST=127.0.0.1
Environment=PGPORT=5432
Environment=PGDATABASE=ndsp_auth
Environment=PGUSER=postgres
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/auth_api/ndsp_user_login_gateway.cjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
