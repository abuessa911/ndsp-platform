[Unit]
Description=NDSP Password Reset Gateway
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/home/nawaf511/empire-core-new/backend/password_reset_gateway
EnvironmentFile=-/etc/ndsp/ndsp-db.env
EnvironmentFile=-/home/nawaf511/empire-core-new/backend/auth_api/.env
Environment=FRONTEND_URL=https://ndsp.app
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/password_reset_gateway/server.js
Restart=always
RestartSec=3
User=nawaf511

[Install]
WantedBy=multi-user.target
