[Unit]
Description=NDSP Enterprise Unified API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ndsp-enterprise-api
ExecStart=/opt/ndsp-enterprise-api/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 9088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
