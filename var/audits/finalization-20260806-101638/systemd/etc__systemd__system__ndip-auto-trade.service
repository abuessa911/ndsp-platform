[Unit]
Description=NDIP Autonomous Trade Cycle
After=ndip-run-server.service network-online.target
Requires=ndip-run-server.service

[Service]
Type=oneshot
User=nawaf511
Group=nawaf511
WorkingDirectory=/opt/empire-core/backend
EnvironmentFile=/etc/empire/secrets/ndip-autotrade.env
ExecStart=/usr/bin/python3 /opt/empire-core/backend/bin/autonomous_cycle_runner.py
