[Unit]
Description=NDSP Access Guard
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/home/nawaf511/empire-core-new/backend/ndsp-access-guard
Environment=PORT=9023
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/ndsp-access-guard/server.js
Restart=always
RestartSec=3
User=nawaf511
Group=nawaf511
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
