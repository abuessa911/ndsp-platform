[Unit]
Description=NDSP Platform Unified Backend Gateway 9001
After=network.target

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/backend/auth_api
Environment=NDSP_PLATFORM_GATEWAY_HOST=127.0.0.1
Environment=NDSP_PLATFORM_GATEWAY_PORT=9001
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/auth_api/ndsp_platform_gateway_9001.cjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
