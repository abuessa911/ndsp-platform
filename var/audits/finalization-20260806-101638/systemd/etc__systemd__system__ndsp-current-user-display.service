[Unit]
Description=NDSP Current User Display API
After=network.target postgresql.service

[Service]
Type=simple
User=postgres
WorkingDirectory=/opt/ndsp-current-user-display
Environment=NDSP_AUTH_DB_DSN=dbname=ndsp_auth user=postgres
ExecStart=/opt/ndsp-current-user-display/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 9074
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
