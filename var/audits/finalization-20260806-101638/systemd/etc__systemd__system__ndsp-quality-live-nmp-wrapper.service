[Unit]
Description=NDSP quality-live NMP wrapper 9082
After=network.target ndsp-quality-live-golden-wrapper.service
Wants=ndsp-quality-live-golden-wrapper.service

[Service]
Type=simple
User=root
Environment=NDSP_NMP_WRAPPER_UPSTREAM=http://127.0.0.1:9067
Environment=NDSP_NMP_WRAPPER_HOST=127.0.0.1
Environment=NDSP_NMP_WRAPPER_PORT=9082
ExecStart=/usr/bin/python3 /home/nawaf511/empire-core-new/backend/app/runtime/ndsp_quality_live_nmp_wrapper.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
