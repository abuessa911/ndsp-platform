[Unit]
Description=NDSP Real Canonical 16-Layer Runtime Sidecar V30
After=network-online.target ndsp-quality-live-nmp-wrapper.service
Wants=network-online.target
Requires=ndsp-quality-live-nmp-wrapper.service

[Service]
Type=simple
User=nawaf511
Group=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/nawaf511/empire-core-new
Environment=NDSP_PROJECT_ROOT=/home/nawaf511/empire-core-new
Environment=NDSP_UPSTREAM_BASE=http://127.0.0.1:9082
Environment=NDSP_CANONICAL_HOST=127.0.0.1
Environment=NDSP_CANONICAL_PORT=9085
Environment=NDSP_CANONICAL_RUNTIME_DIR=/home/nawaf511/empire-core-new/var/runtime/canonical-live-v30
Environment=NDSP_WEB_DATA_DIR=/var/www/ndsp-my/data
ExecStart=/usr/bin/python3 /home/nawaf511/empire-core-new/backend/app/runtime/ndsp_canonical_live_runtime_v30.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/nawaf511/empire-core-new/var/runtime/canonical-live-v30
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
