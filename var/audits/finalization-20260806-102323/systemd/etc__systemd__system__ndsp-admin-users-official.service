[Unit]
Description=NDSP Admin Official Users API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/home/nawaf511/empire-core-new/backend/admin_users_official_api
EnvironmentFile=-/etc/ndsp/ndsp-admin.env
EnvironmentFile=-/etc/ndsp/ndsp-db.env
Environment=HOST=127.0.0.1
Environment=PORT=9031
Environment=PGDATABASE=ndsp_auth
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/admin_users_official_api/server.js
Restart=on-failure
RestartSec=2
User=root
PrivateTmp=true
ProtectHome=false

[Install]
WantedBy=multi-user.target
