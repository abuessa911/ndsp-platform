[Unit]
Description=NDSP Completed Decision Service
After=network.target postgresql.service

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/backend/services/completed_decision
Environment=NODE_ENV=production
Environment=NDSP_COMPLETED_DECISION_PORT=9078
EnvironmentFile=-/home/nawaf511/empire-core-new/backend/.env
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/services/completed_decision/main.cjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
