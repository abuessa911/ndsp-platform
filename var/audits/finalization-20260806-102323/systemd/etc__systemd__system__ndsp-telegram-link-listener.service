[Unit]
Description=NDSP Telegram Link Listener
After=network-online.target postgresql.service ndsp-user-alert-channels.service

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/backend/ndsp-telegram-link-listener
Environment=NODE_PATH=/home/nawaf511/empire-core-new/backend/ndsp-access-guard/node_modules
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/ndsp-telegram-link-listener/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
