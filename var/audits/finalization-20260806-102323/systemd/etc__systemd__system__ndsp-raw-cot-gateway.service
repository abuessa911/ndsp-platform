[Unit]
Description=NDSP Raw COT Gateway
After=network.target

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/apps/ndsp-raw-cot-gateway
ExecStart=/home/nawaf511/empire-core-new/apps/ndsp-raw-cot-gateway/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 9076
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
