[Unit]
Description=NDIP API Service
After=network.target

[Service]
User=nawaf511
Group=nawaf511
WorkingDirectory=/opt/empire/api
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m uvicorn ndip_api:app --host 0.0.0.0 --port 9000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
