[Unit]
Description=NDSP Trial Registration Gateway
After=network.target postgresql.service

[Service]
EnvironmentFile=-/etc/ndsp/ndsp-admin.env
Type=simple
WorkingDirectory=/home/nawaf511/empire-core-new/backend/auth_api
EnvironmentFile=-/etc/ndsp/ndsp-db.env
EnvironmentFile=-/etc/ndsp/ndsp-mail.env
Environment=NDSP_TRIAL_REGISTER_PORT=9019
Environment=NDSP_TRIAL_DAYS=16
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/auth_api/ndsp_trial_register_gateway.cjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
