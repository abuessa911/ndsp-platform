[Unit]
Description=NDSP Change Password Gateway
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=postgres
Group=postgres
WorkingDirectory=/opt/ndsp-change-password-gateway
Environment=DATABASE_URL=dbname=ndsp_auth user=postgres
ExecStart=/opt/ndsp-change-password-gateway/venv/bin/uvicorn app:app --host 127.0.0.1 --port 9069
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
