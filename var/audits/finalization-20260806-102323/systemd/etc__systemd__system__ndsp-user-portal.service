[Unit]
Description=NDSP User Portal - Production Next.js On 3100
After=network.target

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/apps/user-portal
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=0.0.0.0
Environment=NEXT_PUBLIC_API_URL=https://api.ndsp.app
Environment=NEXT_PUBLIC_WS_URL=wss://stream.ndsp.app
ExecStart=/usr/bin/pnpm start -- -H 0.0.0.0 -p 3100
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
