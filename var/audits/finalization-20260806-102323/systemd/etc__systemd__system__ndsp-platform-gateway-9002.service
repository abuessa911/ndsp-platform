[Unit]
Description=NDSP Platform Gateway 9002 Recovery Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ndsp-platform-gateway-9002
ExecStart=/usr/bin/python3 /opt/ndsp-platform-gateway-9002/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
