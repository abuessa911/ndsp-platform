[Unit]
Description=NDSP Commercial Auth Payment Staging V1.13
After=postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ndsp_commercial_staging
Group=ndsp_commercial_staging
WorkingDirectory=/opt/ndsp-commercial-auth-payment-staging/releases/20260730_103616-source-staging-v1-13/source
EnvironmentFile=/etc/ndsp/commercial-auth-payment-staging.env
ExecStart=/opt/ndsp-commercial-auth-payment-staging/releases/20260730_103616-source-staging-v1-13/run-staging.sh
Restart=on-failure
RestartSec=3
PrivateNetwork=true
IPAddressAllow=localhost
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadOnlyPaths=/opt/ndsp-commercial-auth-payment-staging/releases/20260730_103616-source-staging-v1-13 /var/run/postgresql
InaccessiblePaths=/home/nawaf511/empire-core-new/backend /var/www/ndsp-my /etc/nginx /opt/ndsp-auth-core-clean -/run/docker.sock -/var/run/docker.sock -/run/containerd -/run/dbus -/run/systemd/private -/run/user
ReadWritePaths=/var/lib/ndsp-commercial-auth-payment-staging
RuntimeDirectory=ndsp-commercial-auth-payment-staging
RuntimeDirectoryMode=0700
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
