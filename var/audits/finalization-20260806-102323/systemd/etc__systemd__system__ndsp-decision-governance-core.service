[Unit]
Description=NDSP Decision Governance Core
After=network.target ndsp-completed-decision.service

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/backend/services/decision_governance_core
Environment=NODE_ENV=production
Environment=NDSP_GOVERNANCE_PORT=9079
Environment=NDSP_COMPLETED_DECISION_URL=http://127.0.0.1:9078
EnvironmentFile=-/home/nawaf511/empire-core-new/backend/.env
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/services/decision_governance_core/main.cjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
