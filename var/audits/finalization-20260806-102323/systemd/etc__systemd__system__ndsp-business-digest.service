[Unit]
Description=NDSP Daily Business Digest V205
After=ndsp-business-ops.service

[Service]
TimeoutStartSec=45s
TimeoutStopSec=10s
KillMode=control-group
Type=oneshot
User=nawaf511
Group=nawaf511
EnvironmentFile=/etc/ndsp/business-ops.env
ExecStart=/usr/bin/python3 /usr/local/lib/ndsp-business-ops/daily_digest.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/ndsp-business-ops /home/nawaf511/ndsp_launch_reports
