[Unit]
Description=NDIP v6 Alert Worker
After=network.target ndip-api.service

[Service]
Type=simple
WorkingDirectory=/home/nawaf511/ndip-backend
EnvironmentFile=/home/nawaf511/ndip-backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/nawaf511/ndip-backend/venv/bin/python -u -m app.worker_alerts_v6
Restart=always
RestartSec=10
User=nawaf511
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
