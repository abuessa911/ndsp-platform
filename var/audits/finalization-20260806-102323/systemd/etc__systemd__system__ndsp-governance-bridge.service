[Unit]
Description=NDSP Governance Bridge 9044
After=network.target

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/apps/ndsp-governance-bridge
Environment=PORT=9044
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/apps/ndsp-governance-bridge/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
