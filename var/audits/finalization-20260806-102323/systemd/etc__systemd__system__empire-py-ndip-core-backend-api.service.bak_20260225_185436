[Unit]
Description=Empire Python Service (NDIP Backend API)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/empire-clean/prod/ndip-core/backend/api
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/empire-clean/venvs/empire-py-ndip-core-backend-api/bin/python -m uvicorn main:app --host 127.0.0.1 --port 9102
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
Environment=NDIP_DB_PATH=/opt/empire-clean/data/ndip.sqlite3
