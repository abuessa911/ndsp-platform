[Unit]
Description=NDSP Scenario Levels Adapter
After=network-online.target ndsp-live-market-adapter.service
Wants=network-online.target

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/backend
Environment=NODE_ENV=production
Environment=NDSP_SCENARIO_LEVELS_PORT=9034
Environment=NDSP_LIVE_ADAPTER_PORT=9033
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/ndsp_scenario_levels_adapter.cjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
