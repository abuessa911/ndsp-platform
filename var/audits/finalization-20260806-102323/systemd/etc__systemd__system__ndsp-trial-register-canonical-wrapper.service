[Unit]
Description=NDSP Trial Register Canonical Wrapper
After=network.target postgresql.service ndsp-trial-register.service
Wants=postgresql.service ndsp-trial-register.service

[Service]
Type=simple
WorkingDirectory=/home/nawaf511/empire-core-new/backend/ndsp-trial-register-canonical-wrapper
Environment=PORT=9041
Environment=NDSP_REGISTER_UPSTREAM=http://127.0.0.1:9019
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/ndsp-trial-register-canonical-wrapper/server.js
Restart=always
RestartSec=2
User=nawaf511
Group=nawaf511

[Install]
WantedBy=multi-user.target
