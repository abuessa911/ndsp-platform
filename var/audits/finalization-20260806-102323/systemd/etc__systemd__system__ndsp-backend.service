[Unit]
Description=NDSP Official Backend API
After=network.target postgresql.service

[Service]
Type=simple
User=nawaf511
WorkingDirectory=/home/nawaf511/empire-core-new/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/nawaf511/empire-core-new/backend/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
