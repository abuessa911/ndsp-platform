    snapshot=seat_snapshot()

    with connect() as connection:
        users=[
            dict(row)
            for row in connection.execute(
                """
                SELECT
                    email,
                    user_id,
                    trial_started_at,
                    trial_ends_at,
                    duration_days,
                    is_internal,
                    entitlement_status,
                    plan,
                    suspended,
                    notes,
                    updated_at
                FROM trial_clock
                ORDER BY created_at DESC
                LIMIT 500
                """
            ).fetchall()
        ]

        consent_count=connection.execute(
            "SELECT COUNT(*) AS c FROM legal_consents"
        ).fetchone()["c"]

        audit_rows=[
            dict(row)
            for row in connection.execute(
                """
                SELECT
                    actor_email,
                    action,
                    target_email,
                    details_json,
                    created_at
                FROM audit_log
                ORDER BY id DESC
                LIMIT 100
                """
            ).fetchall()
        ]

    for user in users:
        user["computed_status"]=status_for(user)
        user["entitlement_allowed"]=active_trial(user)
        user["days_remaining"]=max(
            0,
            int(
                (
                    parse_date(user["trial_ends_at"])-now()
                ).total_seconds()
                / 86400
            ),
        ) if parse_date(user["trial_ends_at"]) else 0

    return {
        "ok":True,
        "service":"ndsp-launch-control-v167",
        "seat_control":snapshot,
        "consent_version":CONSENT_VERSION,
        "consent_record_count":int(consent_count),
        "users":users,
        "audit_log":audit_rows,
    }

def apply_admin_action(actor,target,action,note):
    action=action.strip().lower()
    target=target.strip().lower()
    allowed_actions={
        "suspend",
        "reactivate",
        "expire",
        "cancel",
        "mark_paid",
        "restore_trial",
        "extend_16_days",
    }

    if action not in allowed_actions:
        raise ValueError("UNSUPPORTED_ACTION")

    with LOCK:
        connection=connect()

        try:
            connection.execute("BEGIN IMMEDIATE")
            row=connection.execute(
                """
                SELECT * FROM trial_clock
                WHERE lower(email)=lower(?)
                """,
                (target,),
            ).fetchone()

            if not row:
                raise ValueError("USER_NOT_FOUND")

            values={
                "suspended":int(row["suspended"] or 0),
                "entitlement_status":str(
                    row["entitlement_status"] or "trial"
                ),
                "plan":str(row["plan"] or "trial"),
                "trial_started_at":row["trial_started_at"],
                "trial_ends_at":row["trial_ends_at"],
            }

            if action=="suspend":
                values["suspended"]=1
                values["entitlement_status"]="suspended"
            elif action=="reactivate":
                values["suspended"]=0

                if parse_date(values["trial_ends_at"])>now():
                    values["entitlement_status"]="trial"
                else:
                    values["entitlement_status"]="expired"
            elif action=="expire":
                values["suspended"]=0
                values["entitlement_status"]="expired"
                values["trial_ends_at"]=iso(
                    now()-dt.timedelta(seconds=1)
                )
            elif action=="cancel":
                values["suspended"]=0
                values["entitlement_status"]="cancelled"
            elif action=="mark_paid":
                values["suspended"]=0
                values["entitlement_status"]="paid"
                values["plan"]="professional"
            elif action=="restore_trial":
                values["suspended"]=0
                values["entitlement_status"]="trial"
            elif action=="extend_16_days":
                started=now()
                values["suspended"]=0
                values["entitlement_status"]="trial"
                values["plan"]="trial"
                values["trial_started_at"]=iso(started)
                values["trial_ends_at"]=iso(
                    started+dt.timedelta(days=TRIAL_DAYS)
                )

            connection.execute(
                """
                UPDATE trial_clock
                SET suspended=?,
                    entitlement_status=?,
                    plan=?,
                    trial_started_at=?,
                    trial_ends_at=?,
                    notes=?,
                    updated_at=?
                WHERE lower(email)=lower(?)
                """,
                (
                    values["suspended"],
                    values["entitlement_status"],
                    values["plan"],
                    values["trial_started_at"],
                    values["trial_ends_at"],
                    note[:500],
                    iso(now()),
                    target,
                ),
            )

            connection.execute(
                """
                INSERT INTO audit_log(
                    actor_email,
                    action,
                    target_email,
                    details_json,
                    created_at
                )
                VALUES(?,?,?,?,?)
                """,
                (
                    actor,
                    action,
                    target,
                    json.dumps(
                        {
                            "note":note,
                            "result":values,
                        },
                        ensure_ascii=False,
                    ),
                    iso(now()),
                ),
            )
            connection.execute("COMMIT")
        except Exception:
            try:
                connection.execute("ROLLBACK")
            except Exception:
                pass
            raise
        finally:
            connection.close()

