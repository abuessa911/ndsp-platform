def flatten(value,output=None):
    if output is None:
        output=[]

    if isinstance(value,dict):
        for key,item in value.items():
            output.append((str(key).lower(),item))
            flatten(item,output)
    elif isinstance(value,list):
        for item in value:
            flatten(item,output)

    return output

def first_value(data,terms):
    rows=flatten(data)

    for term in terms:
        for key,value in rows:
            if (
                term in key
                and not isinstance(value,(dict,list))
                and value not in (None,"")
            ):
                return str(value)

    return ""

def identity_from(data,headers=None):
    headers=headers or {}
    user_id=first_value(
        data,
        ["user_id","account_id","subject","sub","id"],
    )
    email=first_value(
        data,
        ["email_address","user_email","email"],
    ).strip().lower()

    if not user_id:
        user_id=str(headers.get("x-ndsp-user-id","")).strip()

    if not email:
        email=str(headers.get("x-ndsp-user-email","")).strip().lower()

    return user_id,email

def role_from(data):
    role=first_value(
        data,
        ["user_role","account_role","role","type"],
    ).strip().lower()
    return role

def plan_from(data):
    return first_value(
        data,
        [
            "subscription_plan",
            "package",
            "plan",
            "subscription",
        ],
    ).strip().lower()

def is_admin_session(data):
    _,email=identity_from(data)
    role=role_from(data)

    return (
        email==OWNER_EMAIL
        or role in {
            "owner",
            "admin",
            "administrator",
            "superadmin",
            "super_admin",
        }
    )

def user_key(user_id,email):
    if user_id:
        return "id:"+str(user_id)

    if email:
        return "email:"+email.lower()

    return ""

def cleanup_reservations(connection):
    connection.execute(
        "DELETE FROM seat_reservations WHERE expires_at<=?",
        (iso(now()),),
    )

def record_for(user_id,email,connection=None):
    own=connection is None
    connection=connection or connect()
    row=None
    key=user_key(user_id,email)

    try:
        if key:
            row=connection.execute(
                "SELECT * FROM trial_clock WHERE user_key=?",
                (key,),
            ).fetchone()

        if row is None and email:
            row=connection.execute(
                """
                SELECT * FROM trial_clock
                WHERE lower(email)=lower(?)
                """,
                (email,),
            ).fetchone()

        if row is None and user_id:
            row=connection.execute(
                "SELECT * FROM trial_clock WHERE user_id=?",
                (str(user_id),),
            ).fetchone()
    finally:
        if own:
            connection.close()

    return dict(row) if row else None

def active_trial(row,at=None):
    at=at or now()

    if not row:
        return False

    if int(row.get("is_internal") or 0)==1:
        return True

    if int(row.get("suspended") or 0)==1:
        return False

    status=str(row.get("entitlement_status") or "trial").lower()

    if status=="paid":
        return True

    if status in {"cancelled","expired","suspended"}:
        return False

    end=parse_date(row.get("trial_ends_at"))
    return bool(end and end>at)

def status_for(row,at=None):
    at=at or now()

    if not row:
        return "UNTRACKED"

    if int(row.get("suspended") or 0)==1:
        return "SUSPENDED"

    status=str(row.get("entitlement_status") or "trial").lower()

    if status=="paid":
        return "PAID_ACTIVE"

    if status=="cancelled":
        return "CANCELLED"

    end=parse_date(row.get("trial_ends_at"))

    if not end or end<=at:
        return "EXPIRED"

    return "ACTIVE"

def seat_snapshot(connection=None):
    own=connection is None
    connection=connection or connect()

    try:
        cleanup_reservations(connection)
        current=iso(now())

        active=connection.execute(
            """
            SELECT COUNT(*) AS c
            FROM trial_clock
            WHERE is_internal=0
              AND suspended=0
              AND lower(entitlement_status)='trial'
              AND trial_ends_at>?
            """,
            (current,),
        ).fetchone()["c"]

        reserved=connection.execute(
            """
            SELECT COUNT(*) AS c
            FROM seat_reservations
            WHERE expires_at>?
            """,
            (current,),
        ).fetchone()["c"]

        paid=connection.execute(
            """
            SELECT COUNT(*) AS c
            FROM trial_clock
            WHERE is_internal=0
              AND suspended=0
              AND lower(entitlement_status)='paid'
            """
        ).fetchone()["c"]

        expired=connection.execute(
            """
            SELECT COUNT(*) AS c
            FROM trial_clock
            WHERE is_internal=0
              AND (
                lower(entitlement_status) IN (
                    'expired',
                    'cancelled',
                    'suspended'
                )
                OR suspended=1
                OR (
                    lower(entitlement_status)='trial'
                    AND trial_ends_at<=?
                )
              )
            """,
            (current,),
        ).fetchone()["c"]
    finally:
        if own:
            connection.close()

    remaining=max(0,MAX_TRIAL_SEATS-active-reserved)

    return {
        "max_trial_seats":MAX_TRIAL_SEATS,
        "active_trial_seats":int(active),
        "reserved_trial_seats":int(reserved),
        "paid_users":int(paid),
        "inactive_or_expired":int(expired),
        "remaining_trial_seats":int(remaining),
        "registration_allowed":remaining>0,
        "capacity_reached":remaining<=0,
        "message_ar":(
            "التسجيل متاح ضمن المرحلة التجريبية المحدودة."
            if remaining>0
            else CAPACITY_MESSAGE_AR
        ),
        "message_en":(
            "Registration is available for the limited trial."
            if remaining>0
            else CAPACITY_MESSAGE_EN
        ),
    }

def reserve_seat(email):
    email=email.strip().lower()

    if email in INTERNAL_EMAILS:
        return {
            "allowed":True,
            "token":"INTERNAL",
            "reason":"INTERNAL",
        }

    token=secrets.token_urlsafe(24)
    created=now()
    expires=created+dt.timedelta(minutes=5)

    with LOCK:
        connection=connect()

        try:
            connection.execute("BEGIN IMMEDIATE")
            cleanup_reservations(connection)

            existing=connection.execute(
                """
                SELECT user_key
                FROM trial_clock
                WHERE lower(email)=lower(?)
                """,
                (email,),
            ).fetchone()

            if existing:
                connection.execute("COMMIT")
                return {
                    "allowed":True,
                    "token":"EXISTING",
                    "reason":"EXISTING",
                }

            snapshot=seat_snapshot(connection)

            if not snapshot["registration_allowed"]:
                connection.execute("ROLLBACK")
                return {
                    "allowed":False,
                    "token":"",
                    "reason":"CAPACITY_REACHED",
                    "snapshot":snapshot,
                }

            connection.execute(
                """
                INSERT INTO seat_reservations(
                    token,
                    email,
                    created_at,
                    expires_at
                )
                VALUES(?,?,?,?)
                """,
                (
                    token,
                    email,
                    iso(created),
                    iso(expires),
                ),
            )
            connection.execute("COMMIT")

            return {
                "allowed":True,
                "token":token,
                "reason":"RESERVED",
            }
        except Exception:
            try:
                connection.execute("ROLLBACK")
            except Exception:
                pass
            raise
        finally:
            connection.close()

def release_reservation(token):
    if token in {"","INTERNAL","EXISTING"}:
        return

    with connect() as connection:
        connection.execute(
            "DELETE FROM seat_reservations WHERE token=?",
            (token,),
        )

