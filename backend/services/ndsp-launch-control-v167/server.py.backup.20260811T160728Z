lex-wrap:wrap}\n.status-pill{\n  display:inline-flex;align-items:center;gap:8px;\n  min-height:38px;padding:8px 12px;border-radius:999px;\n  border:1px solid rgba(94,226,160,.24);\n  background:rgba(94,226,160,.08);color:var(--ok);\n  font-size:12px;font-weight:800;white-space:nowrap;\n}\n.dot{width:8px;height:8px;border-radius:50%;background:currentColor;box-shadow:0 0 12px currentColor}\n.top-link{\n  min-height:40px;display:inline-flex;align-items:center;justify-content:center;\n  padding:9px 14px;border-radius:12px;border:1px solid var(--line);\n  background:#111;color:#fff;font-size:13px;font-weight:800;\n}\n.hero{\n  position:relative;overflow:hidden;margin-top:18px;\n  padding:clamp(24px,5vw,58px);\n  border:1px solid rgba(227,189,89,.2);\n  border-radius:28px;\n  background:\n    linear-gradient(135deg,rgba(227,189,89,.11),transparent 38%),\n    linear-gradient(180deg,rgba(18,17,13,.98),rgba(8,8,8,.98));\n  box-shadow:0 28px 90px rgba(0,0,0,.34);\n}\n.hero:after{\n  content:"";position:absolute;inset:auto -10% -70% auto;\n  width:420px;height:420px;border-radius:50%;\n  border:1px solid rgba(227,189,89,.12);\n  box-shadow:0 0 0 54px rgba(227,189,89,.025),0 0 0 108px rgba(227,189,89,.018);\n}\n.eyebrow{\n  display:inline-flex;align-items:center;gap:9px;\n  color:var(--gold-light);font-size:12px;font-weight:900;\n  letter-spacing:.08em;text-transform:uppercase;\n}\n.eyebrow:before{content:"";width:36px;height:1px;background:var(--gold)}\nh1{\n  position:relative;z-index:1;\n  margin:16px 0 12px;\n  max-width:820px;\n  font-size:clamp(34px,7vw,72px);\n  line-height:1.08;\n  letter-spacing:-.035em;\n}\n.hero-copy{\n  position:relative;z-index:1;\n  max-width:760px;color:#bcb7ad;\n  font-size:clamp(16px,2vw,20px);line-height:1.9;\n}\n.hero-actions{\n  position:relative;z-index:1;\n  display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;\n}\n.primary,.secondary{\n  min-height:48px;display:inline-flex;align-items:center;justify-content:center;\n  padding:12px 18px;border-radius:14px;font-weight:900;font-size:14px;\n}\n.primary{\n  background:linear-gradient(180deg,var(--gold-light),var(--gold-dark));\n  color:#090805;box-shadow:0 14px 38px rgba(227,189,89,.16);\n}\n.secondary{border:1px solid var(--line);background:#101010;color:#fff}\n.session-card{\n  position:absolute;left:clamp(20px,4vw,52px);top:clamp(20px,4vw,50px);\n  width:min(330px,38%);z-index:2;\n  padding:18px;border:1px solid rgba(227,189,89,.18);\n  border-radius:20px;background:rgba(6,6,6,.74);backdrop-filter:blur(14px);\n}\n.session-label{color:var(--muted);font-size:11px}\n.session-email{\n  margin-top:8px;direction:ltr;text-align:left;\n  font-size:13px;font-weight:800;overflow-wrap:anywhere;\n}\n.session-role{margin-top:12px;color:var(--gold);font-size:12px;font-weight:900}\n.metrics{\n  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));\n  gap:14px;margin-top:18px;\n}\n.metric-card{\n  min-height:142px;padding:20px;\n  border:1px solid var(--line);border-radius:20px;\n  background:linear-gradient(180deg,rgba(17,17,16,.98),rgba(9,9,9,.98));\n}\n.metric-value{\n  color:var(--gold-light);font-size:clamp(30px,4vw,48px);\n  font-weight:1000;line-height:1;direction:rtl;\n}\n.metric-label{margin-top:14px;color:var(--muted);font-size:14px}\n.metric-note{margin-top:7px;color:#77736c;font-size:11px}\n.section-head{\n  display:flex;align-items:flex-end;justify-content:space-between;\n  gap:14px;margin:34px 0 14px;\n}\n.section-title{margin:0;font-size:clamp(23px,4vw,34px)}\n.section-copy{margin:5px 0 0;color:var(--muted);font-size:14px}\n.grid{\n  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;\n}\n.module{\n  position:relative;min-height:220px;padding:22px;\n  border:1px solid var(--line);border-radius:22px;\n  background:\n    radial-gradient(circle at 90% 5%,rgba(227,189,89,.09),transparent 32%),\n    linear-gradient(180deg,#11100d,#090909);\n  transition:transform .18s ease,border-color .18s ease;\n}\n.module:hover{transform:translateY(-2px);border-color:var(--line-strong)}\n.module-index{color:var(--gold);font-size:12px;font-weight:900;direction:ltr}\n.module h3{margin:18px 0 8px;font-size:21px}\n.module p{margin:0;color:var(--muted);font-size:14px;line-height:1.75}\n.module-link{\n  position:absolute;right:22px;bottom:20px;\n  color:var(--gold-light);font-size:13px;font-weight:900;\n}\n.ops{\n  display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-top:14px;\n}\n.panel{\n  padding:22px;border:1px solid var(--line);border-radius:22px;\n  background:rgba(12,12,11,.94);\n}\n.panel h3{margin:0 0 16px;font-size:18px}\n.checks{display:grid;gap:10px}\n.check{\n  display:flex;align-items:center;justify-content:space-between;gap:14px;\n  padding:13px 14px;border:1px solid #292419;border-radius:14px;background:#090909;\n}\n.check-name{font-size:13px;color:#ddd8cf}\n.check-state{font-size:12px;font-weight:900;color:var(--ok)}\n.check-state.warn{color:var(--warn)}\n.release{\n  display:flex;align-items:center;justify-content:space-between;gap:14px;\n  padding:14px 0;border-bottom:1px solid #262117;\n}\n.release:last-child{border-bottom:0}\n.release-name{font-weight:900}\n.release-note{margin-top:4px;color:var(--muted);font-size:12px}\n.release-tag{color:var(--gold);font-size:12px;font-weight:900;white-space:nowrap}\n.message{\n  min-height:26px;margin-top:16px;color:var(--gold);\n  font-size:13px;line-height:1.7;\n}\n.footer{\n  display:flex;align-items:center;justify-content:space-between;gap:16px;\n  margin:28px 0 8px;padding-top:18px;border-top:1px solid #211d15;\n  color:#706c64;font-size:11px;\n}\n@media(max-width:1000px){\n  .session-card{position:relative;left:auto;top:auto;width:100%;margin-top:24px}\n  .metrics{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .ops{grid-template-columns:1fr}\n}\n@media(max-width:640px){\n  .shell{padding:12px}\n  .topbar{align-items:flex-start;border-radius:16px}\n  .brand-sub{display:none}\n  .status-pill{display:none}\n  .hero{padding:24px 18px;border-radius:22px}\n  h1{font-size:38px}\n  .hero-copy{font-size:15px}\n  .hero-actions{display:grid;grid-template-columns:1fr}\n  .primary,.secondary{width:100%}\n  .metrics{gap:10px}\n  .metric-card{min-height:126px;padding:16px;border-radius:17px}\n  .metric-value{font-size:34px}\n  .grid{grid-template-columns:1fr}\n  .module{min-height:190px}\n  .section-head{display:block}\n  .footer{display:block;line-height:1.8}\n}\n</style>\n</head>\n<body>\n<div class="shell" data-release="NDSP_OWNER_DASHBOARD_V173">\n  <nav class="topbar">\n    <div class="brand">\n      <div class="mark">N</div>\n      <div class="brand-copy">\n        <div class="brand-title">NDSP — Nawaf Decision Support Platform</div>\n        <div class="brand-sub">OWNER GOVERNANCE CONSOLE · RELEASE V173</div>\n      </div>\n    </div>\n    <div class="top-actions">\n      <span class="status-pill"><span class="dot"></span><span id="topStatus">متصل</span></span>\n      <a class="top-link" href="/portal-v50/">فتح المنصة</a>\n    </div>\n  </nav>\n\n  <section class="hero">\n    <div class="eyebrow">مركز الإدارة العليا</div>\n    <h1>إدارة المنصة من واجهة واحدة واضحة ومحكومة.</h1>\n    <p class="hero-copy">\n      تحكم بالمستخدمين والمقاعد التجريبية والصلاحيات، وراجع حالة التشغيل\n      ومسارات المنصة دون الرجوع إلى الواجهة القديمة أو النصوص الثابتة.\n    </p>\n    <div class="hero-actions">\n      <a class="primary" href="/admin/launch-control/">إدارة المستخدمين والمقاعد</a>\n      <a class="secondary" href="/portal-v50/">معاينة بوابة المستخدم</a>\n    </div>\n    <aside class="session-card">\n      <div class="session-label">جلسة المالك الحالية</div>\n      <div id="ownerEmail" class="session-email">جارٍ التحقق...</div>\n      <div id="ownerRole" class="session-role">OWNER</div>\n    </aside>\n  </section>\n\n  <section class="metrics" aria-label="مؤشرات الإطلاق">\n    <article class="metric-card">\n      <div id="usedSeats" class="metric-value">—</div>\n      <div class="metric-label">المقاعد المستخدمة</div>\n      <div class="metric-note">من أصل 50 مقعدًا تجريبيًا</div>\n    </article>\n    <article class="metric-card">\n      <div id="remainingSeats" class="metric-value">—</div>\n      <div class="metric-label">المقاعد المتبقية</div>\n      <div class="metric-note">تتوقف التسجيلات تلقائيًا عند الصفر</div>\n    </article>\n    <article class="metric-card">\n      <div id="paidUsers" class="metric-value">—</div>\n      <div class="metric-label">المستخدمون المدفوعون</div>\n      <div class="metric-note">خارج الإطلاق التجريبي الحالي</div>\n    </article>\n    <article class="metric-card">\n      <div id="consents" class="metric-value">—</div>\n      <div class="metric-label">الموافقات المحفوظة</div>\n      <div class="metric-note">نسخة قانونية وهوية وتوقيت</div>\n    </article>\n  </section>\n\n  <div class="section-head">\n    <div>\n      <h2 class="section-title">مراكز التحكم</h2>\n      <p class="section-copy">وصول مباشر إلى أهم وظائف الإدارة والتشغيل.</p>\n    </div>\n  </div>\n\n  <section class="grid">\n    <a class="module" href="/admin/launch-control/">\n      <div class="module-index">01 · USERS</div>\n      <h3>المستخدمون والصلاحيات</h3>\n      <p>إدارة التجارب، التمديد، الإيقاف، الإلغاء، والتحويل إلى حساب مدفوع.</p>\n      <span class="module-link">فتح لوحة الإطلاق ←</span>\n    </a>\n    <a class="module" href="/portal-v50/">\n      <div class="module-index">02 · PORTAL</div>\n      <h3>بوابة المستخدم</h3>\n      <p>معاينة التجربة الفعلية للمستخدم وجميع صفحات دعم القرار والأسواق.</p>\n      <span class="module-link">فتح البوابة ←</span>\n    </a>\n    <a class="module" href="/register/">\n      <div class="module-index">03 · ONBOARDING</div>\n      <h3>التسجيل والتجربة</h3>\n      <p>فحص رحلة التسجيل الحالية ورسالة اكتمال المقاعد والتجربة ذات 16 يومًا.</p>\n      <span class="module-link">فتح التسجيل ←</span>\n    </a>\n    <a class="module" href="/api/launch/status">\n      <div class="module-index">04 · CAPACITY</div>\n      <h3>حالة المقاعد المباشرة</h3>\n      <p>عرض العقد العام الحالي لعدد المقاعد، التسجيل المتاح، وحالة السعة.</p>\n      <span class="module-link">عرض الحالة ←</span>\n    </a>\n    <a class="module" href="/api/health">\n      <div class="module-index">05 · HEALTH</div>\n      <h3>صحة الخدمات</h3>\n      <p>فحص نقطة الصحة العامة والتأكد من استجابة البنية التشغيلية.</p>\n      <span class="module-link">فحص الصحة ←</span>\n    </a>\n    <a class="module" href="/forgot-password.html">\n      <div class="module-index">06 · RECOVERY</div>\n      <h3>استعادة الحساب</h3>\n      <p>فتح مسار إعادة تعيين كلمة المرور المعتمد للحسابات المسجلة.</p>\n      <span class="module-link">فتح الاستعادة ←</span>\n    </a>\n  </section>\n\n  <section class="ops">\n    <article class="panel">\n      <h3>الحالة التشغيلية</h3>\n      <div class="checks">\n        <div class="check"><span class="check-name">جلسة المالك</span><span id="sessionState" class="check-state">جارٍ الفحص</span></div>\n        <div class="check"><span class="check-name">خدمة التحكم بالإطلاق</span><span id="serviceState" class="check-state">جارٍ الفحص</span></div>\n        <div class="check"><span class="check-name">التسجيل التجريبي</span><span id="registrationState" class="check-state warn">جارٍ الفحص</span></div>\n        <div class="check"><span class="check-name">حد المقاعد</span><span id="capacityState" class="check-state">50</span></div>\n      </div>\n      <div id="ownerMessage" class="message" role="status" aria-live="polite"></div>\n    </article>\n\n    <article class="panel">\n      <h3>الإصدارات الحية</h3>\n      <div class="release">\n        <div><div class="release-name">جوهر القرار العام</div><div class="release-note">النسخة التقنية المعتمدة</div></div>\n        <span class="release-tag">V143</span>\n      </div>\n      <div class="release">\n        <div><div class="release-name">التحكم بالإطلاق</div><div class="release-note">المقاعد والصلاحيات والتجربة</div></div>\n        <span class="release-tag">V167</span>\n      </div>\n      <div class="release">\n        <div><div class="release-name">لوحة المستخدمين</div><div class="release-note">بطاقات متجاوبة للجوال</div></div>\n        <span class="release-tag">V169</span>\n      </div>\n      <div class="release">\n        <div><div class="release-name">مركز المالك</div><div class="release-note">الهوية الحديثة الحالية</div></div>\n        <span class="release-tag">V173</span>\n      </div>\n    </article>\n  </section>\n\n  <footer class="footer">\n    <span>NDSP — واجهة إدارية محكومة وليست منصة تنفيذ أو أوامر تداول.</span>\n    <span id="lastUpdated">آخر تحديث: —</span>\n  </footer>\n</div>\n<script src="/admin/?asset=owner-js&v=173" defer></script>\n</body>\n</html>\n'

def owner_dashboard_script():
    return '(function(){\n"use strict";\n\nconst byId=function(id){return document.getElementById(id);};\n\nfunction findValue(value,keys,depth){\n  if(depth>7||value===null||value===undefined)return "";\n\n  if(Array.isArray(value)){\n    for(const item of value){\n      const found=findValue(item,keys,depth+1);\n      if(found)return found;\n    }\n    return "";\n  }\n\n  if(typeof value!=="object")return "";\n\n  for(const key of keys){\n    if(Object.prototype.hasOwnProperty.call(value,key)){\n      const current=value[key];\n      if(current!==null&&current!==undefined&&String(current).trim()){\n        return String(current).trim();\n      }\n    }\n  }\n\n  for(const current of Object.values(value)){\n    const found=findValue(current,keys,depth+1);\n    if(found)return found;\n  }\n\n  return "";\n}\n\nfunction setText(id,value){\n  const element=byId(id);\n  if(element)element.textContent=String(value);\n}\n\nfunction setState(id,text,kind){\n  const element=byId(id);\n  if(!element)return;\n  element.textContent=text;\n  element.classList.toggle("warn",kind==="warn");\n  element.style.color=kind==="bad"?"#ff8989":"";\n}\n\nasync function getJson(url){\n  const response=await fetch(url,{\n    credentials:"include",\n    cache:"no-store",\n    headers:{"Accept":"application/json"}\n  });\n\n  if(response.status===401||response.status===403){\n    location.href="/login/?next="+encodeURIComponent("/admin/");\n    throw new Error("AUTH_REQUIRED");\n  }\n\n  if(!response.ok){\n    throw new Error(url+" HTTP "+response.status);\n  }\n\n  return response.json();\n}\n\nasync function load(){\n  setText("ownerMessage","جارٍ تحميل بيانات الإدارة العليا...");\n\n  try{\n    const results=await Promise.all([\n      getJson("/api/auth/session"),\n      getJson("/api/admin/launch-control"),\n      getJson("/api/launch/status")\n    ]);\n\n    const session=results[0]||{};\n    const admin=results[1]||{};\n    const launch=results[2]||{};\n    const seats=admin.seat_control||launch||{};\n\n    const email=findValue(session,["email","user_email"],0)||\n      admin.actor_email||\n      "حساب المالك";\n\n    const role=findValue(session,["role","user_role","account_role"],0)||\n      "owner";\n\n    const used=Number(seats.active_trial_seats||0);\n    const maximum=Number(seats.max_trial_seats||50);\n    const remaining=Number(seats.remaining_trial_seats??Math.max(0,maximum-used));\n    const paid=Number(seats.paid_users||0);\n    const consentCount=Number(admin.consent_record_count||0);\n    const registrationAllowed=Boolean(seats.registration_allowed);\n\n    setText("ownerEmail",email);\n    setText("ownerRole",String(role).toUpperCase());\n    setText("usedSeats",used+" من "+maximum);\n    setText("remainingSeats",remaining);\n    setText("paidUsers",paid);\n    setText("consents",consentCount);\n    setText("topStatus","متصل وآمن");\n    setState("sessionState","نشطة","ok");\n    setState("serviceState","متصلة","ok");\n    setState(\n      "registrationState",\n      registrationAllowed?"متاح":"مغلق",\n      registrationAllowed?"ok":"warn"\n    );\n    setText("capacityState",maximum+" مقعدًا");\n    setText(\n      "ownerMessage",\n      "تم تحميل الجلسة وحالة الإطلاق وبيانات المقاعد بنجاح."\n    );\n    setText(\n      "lastUpdated",\n      "آخر تحديث: "+new Date().toLocaleString("ar-SA")\n    );\n  }catch(error){\n    if(String(error&&error.message)==="AUTH_REQUIRED")return;\n\n    console.error("NDSP_OWNER_V173_LOAD_ERROR",error);\n    setText("topStatus","تعذر التحقق");\n    setState("sessionState","تعذر الفحص","bad");\n    setState("serviceState","تعذر الفحص","bad");\n    setState("registrationState","غير معروف","warn");\n    setText(\n      "ownerMessage",\n      "تعذر تحميل بعض بيانات لوحة المالك. أعد تحديث الصفحة، وإن استمرت المشكلة راجع خدمة التحكم بالإطلاق."\n    );\n  }\n}\n\nload();\n})();\n'

class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version="HTTP/1.1"

    def log_message(self,fmt,*args):
        print(
            "%s - - [%s] %s"
            % (
                self.client_address[0],
                self.log_date_time_string(),
                fmt%args,
            ),
            flush=True,
        )

    def body(self):
        length=int(self.headers.get("Content-Length","0") or "0")
        return self.rfile.read(length) if length>0 else b""

    def common(self):
        self.send_header("X-NDSP-Launch-Control",MARKER)
        self.send_header("Cache-Control","no-store")

    def send_json(self,status,data,headers=None):
        raw=json.dumps(
            data,
            ensure_ascii=False,
            separators=(",",":"),
        ).encode()

        self.send_response(status)
        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8",
        )

        for key,value in headers or []:
            if key.lower() not in {
                "content-length",
                "content-type",
                "connection",
                "transfer-encoding",
                "content-encoding",
                "x-ndsp-launch-control",
            }:
                self.send_header(key,value)

        self.common()
        self.send_header("Content-Length",str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def send_raw(self,status,raw,headers=None):
        self.send_response(status)

        for key,value in headers or []:
            if key.lower() not in {
                "content-length",
                "connection",
                "transfer-encoding",
                "content-encoding",
                "x-ndsp-launch-control",
            }:
                self.send_header(key,value)

        self.common()
        self.send_header("Content-Length",str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def send_javascript(self,status,text):
        raw=text.encode("utf-8")
        self.send_response(status)
        self.send_header(
            "Content-Type",
            "application/javascript; charset=utf-8",
        )
        self.common()
        self.send_header("Content-Length",str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def send_html(self,status,text):
        raw=text.encode()
        self.send_response(status)
        self.send_header(
            "Content-Type",
            "text/html; charset=utf-8",
        )
        self.common()
        self.send_header("Content-Length",str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def client_ip(self):
        forwarded=self.headers.get("X-Forwarded-For","").split(",")[0].strip()
        return forwarded or self.client_address[0]

    def require_admin(self):
        headers=dict(self.headers.items())
        status,_,_,data=session_data(headers)

        if status!=200 or not isinstance(data,dict):
            return None

        if not is_admin_session(data):
            return None

        return data

    def do_GET(self):
        path=urllib.parse.urlsplit(self.path).path
        headers=dict(self.headers.items())

        if path=="/health":
            self.send_json(
                200,
                {
                    "ok":True,
                    "service":"ndsp-launch-control-v167",
                    "port":PORT,
                    "max_trial_seats":MAX_TRIAL_SEATS,
                    "database":DB_PATH,
                },
            )
            return

        if path=="/internal/capacity-message-test":
            if self.client_address[0] not in {"127.0.0.1","::1"}:
                self.send_json(404,{"ok":False})
                return

            self.send_json(
                409,
                {
                    "ok":False,
                    "code":"TRIAL_CAPACITY_REACHED",
                    "message":CAPACITY_MESSAGE_AR,
                    "message_ar":CAPACITY_MESSAGE_AR,
                    "message_en":CAPACITY_MESSAGE_EN,
                    "max_trial_seats":MAX_TRIAL_SEATS,
                },
            )
            return

        if path in {
            "/api/launch/status",
            "/api/trial/seats",
        }:
            self.send_json(
                200,
                {
                    "ok":True,
                    "service":"ndsp-launch-control-v167",
                    **seat_snapshot(),
                },
            )
            return

        if path=="/api/auth/session":
            status,response_headers,raw,data=session_data(headers)

            if status!=200 or not isinstance(data,dict):
                self.send_raw(status,raw,response_headers)
                return

            user_id,email=identity_from(data,headers)
            row=record_for(user_id,email)
            self.send_json(
                200,
                merge_session(data,row),
                response_headers,
            )
            return

        if path=="/api/trial/status":
            session_status,_,_,session=session_data(headers)
            upstream_status,response_headers,raw,data=request_upstream(
                TRIAL_STATUS_URL,
                "GET",
                headers,
            )

            if upstream_status!=200 or not isinstance(data,dict):
                self.send_raw(
                    upstream_status,
                    raw,
                    response_headers,
                )
                return

            user_id,email=identity_from(
                session if isinstance(session,dict) else {},
                headers,
            )
            row=record_for(user_id,email)
            output=dict(data)
            output["seat_control"]=seat_snapshot()

            if row:
                payload=trial_payload(row)
                output.update(payload)
                trial=output.get("trial")

                if not isinstance(trial,dict):
                    trial={}

                trial.update(payload)
                trial["duration_days"]=TRIAL_DAYS
                output["trial"]=trial

            self.send_json(200,output,response_headers)
            return

        if path=="/api/entitlements/me":
            status,_,_,data=session_data(headers)

            if status!=200 or not isinstance(data,dict):
                self.send_json(
                    401,
                    {"ok":False,"error":"AUTH_REQUIRED"},
                )
                return

            user_id,email=identity_from(data,headers)
            row=record_for(user_id,email)
            decision=entitlement_decision(data,row)
            self.send_json(
                200,
                {
                    "ok":True,
                    "entitlement":decision,
                    "seat_control":seat_snapshot(),
                    "trial":trial_payload(row) if row else None,
                },
            )
            return

        if path=="/api/auth/decision-room-access":
            upstream_status,response_headers,raw,data=request_upstream(
                DECISION_ACCESS_URL,
                "GET",
                headers,
            )

            if upstream_status<200 or upstream_status>=300:
                self.send_raw(
                    upstream_status,
                    raw,
                    response_headers,
                )
                return

            status,_,_,session=session_data(headers)

            if status!=200 or not isinstance(session,dict):
                self.send_json(
                    401,
                    {
                        "ok":False,
                        "error":"AUTH_REQUIRED",
                    },
                )
                return

            user_id,email=identity_from(session,headers)
            row=record_for(user_id,email)
            decision=entitlement_decision(session,row)

            if not decision["allowed"]:
                self.send_json(
                    403,
                    {
                        "ok":False,
                        "code":"ENTITLEMENT_DENIED",
                        "status":decision["status"],
                        "message_ar":"انتهت أو توقفت صلاحية الوصول لهذا الحساب.",
                        "message_en":"This account no longer has active access.",
                        "entitlement":decision,
                    },
                )
                return

            self.send_raw(upstream_status,raw,response_headers)
            return

        if path in {
            "/admin",
            "/admin/",
            "/owner",
            "/owner/",
        }:
            admin=self.require_admin()

            if not admin:
                self.send_response(302)
                self.send_header(
                    "Location",
                    "/login/?next=%2Fadmin%2F",
                )
                self.common()
                self.send_header("Content-Length","0")
                self.end_headers()
                return

            query=urllib.parse.parse_qs(
                urllib.parse.urlsplit(self.path).query
            )

            if query.get("asset")==["owner-js"]:
                self.send_javascript(
                    200,
                    owner_dashboard_script(),
                )
                return

            self.send_html(
                200,
                owner_dashboard_page(),
            )
            return

        if path in {
            "/admin/launch-control",
            "/admin/launch-control/",
        }:
            admin=self.require_admin()

            if not admin:
                self.send_response(302)
                self.send_header(
                    "Location",
                    "/login/?next=%2Fadmin%2Flaunch-control%2F",
                )
                self.common()
                self.send_header("Content-Length","0")
                self.end_headers()
                return

            query=urllib.parse.parse_qs(
                urllib.parse.urlsplit(self.path).query
            )

            if query.get("asset")==["js"]:
                self.send_javascript(200,admin_script())
                return

            self.send_html(200,admin_page())
            return

        if path=="/api/admin/launch-control":
            admin=self.require_admin()

            if not admin:
                self.send_json(
                    403,
                    {"ok":False,"error":"ADMIN_REQUIRED"},
                )
                return

            _,actor=identity_from(admin)
            output=admin_snapshot()
            output["admin_token"]=admin_token(actor)
            output["actor_email"]=actor
            self.send_json(200,output)
            return

        if path=="/api/register":
            self.send_json(
                405,
                {
                    "ok":False,
                    "error":"METHOD_NOT_ALLOWED",
                    "required_method":"POST",
                },
                [("Allow","POST")],
            )
            return

        self.send_json(404,{"ok":False,"error":"NOT_FOUND"})

    def do_POST(self):
        path=urllib.parse.urlsplit(self.path).path
        headers=dict(self.headers.items())
        raw_body=self.body()

        if path=="/api/register":
            try:
                request_data=json.loads(raw_body.decode())
            except Exception:
                self.send_json(
                    400,
                    {
                        "ok":False,
                        "error":"INVALID_JSON",
                    },
                )
                return

            email=str(
                request_data.get("email")
                or request_data.get("user_email")
                or ""
            ).strip().lower()

            if not email:
                self.send_json(
                    422,
                    {
                        "ok":False,
                        "error":"EMAIL_REQUIRED",
                    },
                )
                return

            reservation=reserve_seat(email)

            if not reservation["allowed"]:
                snapshot=reservation["snapshot"]
                self.send_json(
                    409,
                    {
                        "ok":False,
                        "code":"TRIAL_CAPACITY_REACHED",
                        "message":CAPACITY_MESSAGE_AR,
                        "message_ar":CAPACITY_MESSAGE_AR,
                        "message_en":CAPACITY_MESSAGE_EN,
                        **snapshot,
                    },
                )
                return

            token=reservation["token"]

            try:
                status,response_headers,raw,data=request_upstream(
                    REGISTER_URL,
                    "POST",
                    headers,
                    raw_body,
                )

                if status in {200,201}:
                    response_data=data if isinstance(data,dict) else {}
                    user_id,response_email=identity_from(
                        response_data,
                        headers,
                    )
                    final_email=response_email or email
                    finalize_registration(
                        token,
                        user_id,
                        final_email,
                        request_data,
                        self.client_ip(),
                        self.headers.get("User-Agent",""),
                    )
                else:
                    release_reservation(token)

                self.send_raw(status,raw,response_headers)
            except Exception as error:
                release_reservation(token)
                self.send_json(
                    502,
                    {
                        "ok":False,
                        "error":"REGISTER_UPSTREAM_FAILURE",
                        "detail":str(error)[:240],
                    },
                )
            return

        if path=="/api/admin/launch-control/action":
            admin=self.require_admin()

            if not admin:
                self.send_json(
                    403,
                    {"ok":False,"error":"ADMIN_REQUIRED"},
                )
                return

            _,actor=identity_from(admin)
            origin=self.headers.get("Origin","")
            token=self.headers.get("X-NDSP-Admin-Token","")

            if origin and "my.ndsp.app" not in origin:
                self.send_json(
                    403,
                    {"ok":False,"error":"INVALID_ORIGIN"},
                )
                return

            if not validate_admin_token(actor,token):
                self.send_json(
                    403,
                    {"ok":False,"error":"INVALID_ADMIN_TOKEN"},
                )
                return

            try:
                payload=json.loads(raw_body.decode())
                target=str(payload.get("email") or "")
                action=str(payload.get("action") or "")
                note=str(payload.get("note") or "")
                apply_admin_action(
                    actor,
                    target,
                    action,
                    note,
                )
            except ValueError as error:
                self.send_json(
                    422,
                    {
                        "ok":False,
                        "error":str(error),
                    },
                )
                return
            except Exception as error:
                self.send_json(
                    500,
                    {
                        "ok":False,
                        "error":"ADMIN_ACTION_FAILED",
                        "detail":str(error)[:240],
                    },
                )
                return

            self.send_json(
                200,
                {
                    "ok":True,
                    "message_ar":"تم تنفيذ الإجراء وتسجيله في سجل الإدارة.",
                },
            )
            return

        self.send_json(404,{"ok":False,"error":"NOT_FOUND"})

def self_test():
    global DB_PATH,MAX_TRIAL_SEATS,INTERNAL_EMAILS
    original_db=DB_PATH
    original_max=MAX_TRIAL_SEATS
    original_internal=set(INTERNAL_EMAILS)
    test_db=original_db+".selftest"

    try:
        if os.path.exists(test_db):
            os.unlink(test_db)

        DB_PATH=test_db
        MAX_TRIAL_SEATS=1
        INTERNAL_EMAILS={"internal@example.com"}
        init_db()

        first=reserve_seat("one@example.com")
        second=reserve_seat("two@example.com")

        assert first["allowed"] is True
        assert second["allowed"] is False
        assert second["reason"]=="CAPACITY_REACHED"

        release_reservation(first["token"])
        request={
            "email":"one@example.com",
            "terms_accepted":True,
            "privacy_accepted":True,
            "disclaimer_accepted":True,
        }
        finalize_registration(
            "",
            "u1",
            "one@example.com",
            request,
            "127.0.0.1",
            "self-test",
        )

        row=record_for("u1","one@example.com")
        assert status_for(row)=="ACTIVE"
        assert active_trial(row) is True

        with connect() as connection:
            connection.execute(
                """
                UPDATE trial_clock
                SET trial_ends_at=?,
                    entitlement_status='trial'
                WHERE user_key='id:u1'
                """,
                (iso(now()-dt.timedelta(seconds=1)),),
            )

        row=record_for("u1","one@example.com")
        assert status_for(row)=="EXPIRED"
        assert active_trial(row) is False

        with connect() as connection:
            connection.execute(
                """
                UPDATE trial_clock
                SET entitlement_status='paid',
                    suspended=0
                WHERE user_key='id:u1'
                """
            )

        row=record_for("u1","one@example.com")
        assert status_for(row)=="PAID_ACTIVE"
        assert active_trial(row) is True

        with connect() as connection:
            connection.execute(
                """
                UPDATE trial_clock
                SET entitlement_status='cancelled'
                WHERE user_key='id:u1'
                """
            )

        row=record_for("u1","one@example.com")
        assert status_for(row)=="CANCELLED"
        assert active_trial(row) is False

        cancelled_decision=entitlement_decision(
            {"user":{"id":"u1","email":"one@example.com","role":"user"}},
            row,
        )
        assert cancelled_decision["allowed"] is False

        with connect() as connection:
            connection.execute(
                """
                UPDATE trial_clock
                SET entitlement_status='paid',
                    suspended=0
                WHERE user_key='id:u1'
                """
            )

        row=record_for("u1","one@example.com")
        paid_decision=entitlement_decision(
            {"user":{"id":"u1","email":"one@example.com","role":"professional"}},
            row,
        )
        assert paid_decision["allowed"] is True

        owner_decision=entitlement_decision(
            {"user":{"id":"owner","email":OWNER_EMAIL,"role":"owner"}},
            None,
        )
        assert owner_decision["allowed"] is True

        with connect() as connection:
            consent=connection.execute(
                """
                SELECT COUNT(*) AS c
                FROM legal_consents
                WHERE lower(email)='one@example.com'
                  AND terms_accepted=1
                  AND privacy_accepted=1
                  AND disclaimer_accepted=1
                """
            ).fetchone()["c"]

        assert consent==1

        print("ATOMIC_SEAT_CAP_SELF_TEST=PASS")
        print("TRIAL_EXPIRY_TRANSITION_SELF_TEST=PASS")
        print("ENTITLEMENT_MATRIX_SELF_TEST=PASS")
        print("LEGAL_CONSENT_PERSISTENCE_SELF_TEST=PASS")
    finally:
        DB_PATH=original_db
        MAX_TRIAL_SEATS=original_max
        INTERNAL_EMAILS=original_internal

        for suffix in ("","-wal","-shm"):
            try:
                os.unlink(test_db+suffix)
            except FileNotFoundError:
                pass

