def trial_payload(row):
    start=parse_date(row["trial_started_at"])
    end=parse_date(row["trial_ends_at"])
    remaining_seconds=(end-now()).total_seconds()
    remaining=max(0,int((remaining_seconds+86399)//86400))
    current_status=status_for(row)
    allowed=active_trial(row)

    return {
        "trial_started_at":iso(start),
        "trial_ends_at":iso(end),
        "trial_days":TRIAL_DAYS,
        "trial_days_remaining":remaining,
        "trial_active":(
            current_status=="ACTIVE"
            or int(row.get("is_internal") or 0)==1
        ),
        "trial_status":current_status,
        "trial_clock_source":row["source"],
        "trial_clock_authoritative":True,
        "trial_clock_server_recorded":True,
        "entitlement_status":current_status,
        "entitlement_allowed":allowed,
        "entitlement_plan":row.get("plan") or "trial",
        "entitlement_reason":current_status,
        "seat_counted":int(row.get("is_internal") or 0)==0,
        "internal_account":int(row.get("is_internal") or 0)==1,
    }

def filtered_request_headers(headers):
    output={}

    for key,value in headers.items():
        if key.lower() in {
            "host",
            "content-length",
            "connection",
            "accept-encoding",
        }:
            continue
        output[key]=value

    return output

def request_upstream(url,method,headers,body=b""):
    target=urllib.parse.urlsplit(url)
    path=target.path or "/"

    if target.query:
        path+="?"+target.query

    if target.scheme=="https":
        connection=http.client.HTTPSConnection(
            target.hostname,
            target.port or 443,
            timeout=30,
            context=ssl.create_default_context(),
        )
    else:
        connection=http.client.HTTPConnection(
            target.hostname,
            target.port or 80,
            timeout=30,
        )

    request_headers=filtered_request_headers(headers)

    if body:
        request_headers["Content-Length"]=str(len(body))

    connection.request(
        method,
        path,
        body=body if body else None,
        headers=request_headers,
    )

    response=connection.getresponse()
    raw=response.read()
    response_headers=response.getheaders()
    status=response.status
    connection.close()

    try:
        data=json.loads(raw.decode("utf-8"))
    except Exception:
        data=None

    return status,response_headers,raw,data

def session_data(headers):
    status,response_headers,raw,data=request_upstream(
        SESSION_URL,
        "GET",
        headers,
    )
    return status,response_headers,raw,data

def merge_session(data,row):
    output=dict(data) if isinstance(data,dict) else {}
    snapshot=seat_snapshot()
    output["launch_control"]=snapshot

    if row:
        payload=trial_payload(row)
        output.update(payload)
        nested=output.get("trial")

        if not isinstance(nested,dict):
            nested={}

        nested.update(payload)
        nested["duration_days"]=TRIAL_DAYS
        output["trial"]=nested

    return output

def entitlement_decision(data,row):
    user_id,email=identity_from(data)
    role=role_from(data)
    plan=plan_from(data)

    if is_admin_session(data):
        return {
            "allowed":True,
            "status":"OWNER_ADMIN",
            "reason":"OWNER_ADMIN",
            "role":role or "owner",
            "plan":plan or "owner",
            "user_id":user_id,
            "email":email,
        }

    if row:
        status=status_for(row)
        allowed=active_trial(row)
        return {
            "allowed":allowed,
            "status":status,
            "reason":status,
            "role":role or "user",
            "plan":row.get("plan") or plan or "trial",
            "user_id":user_id,
            "email":email,
        }

    return {
        "allowed":True,
        "status":"UPSTREAM_ACCOUNT",
        "reason":"UPSTREAM_AUTHORIZATION",
        "role":role or "user",
        "plan":plan or "existing",
        "user_id":user_id,
        "email":email,
    }

