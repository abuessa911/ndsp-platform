def admin_script():
    return '(function(){\n"use strict";\n\nlet token="";\nlet users=[];\n\nconst elements={\n  used:document.getElementById("used"),\n  remaining:document.getElementById("remaining"),\n  paid:document.getElementById("paid"),\n  consents:document.getElementById("consents"),\n  search:document.getElementById("search"),\n  refresh:document.getElementById("refreshButton"),\n  grid:document.getElementById("usersGrid"),\n  message:document.getElementById("msg")\n};\n\nfunction escapeHtml(value){\n  return String(value??"").replace(/[&<>"\']/g,function(character){\n    return {\n      "&":"&amp;",\n      "<":"&lt;",\n      ">":"&gt;",\n      \'"\':"&quot;",\n      "\'":"&#39;"\n    }[character];\n  });\n}\n\nfunction setMessage(text,isError){\n  if(!elements.message)return;\n  elements.message.textContent=String(text||"");\n  elements.message.style.color=isError?"#ff8a8a":"#e1bd5b";\n}\n\nfunction statusArabic(status){\n  const map={\n    ACTIVE:"نشط",\n    PAID_ACTIVE:"مدفوع نشط",\n    EXPIRED:"منتهي",\n    CANCELLED:"ملغي",\n    SUSPENDED:"موقوف",\n    UNTRACKED:"غير متتبع"\n  };\n  return map[String(status||"").toUpperCase()]||String(status||"—");\n}\n\nfunction actionOptions(){\n  return [\n    ["suspend","إيقاف الحساب"],\n    ["reactivate","إعادة التفعيل"],\n    ["extend_16_days","تمديد التجربة 16 يومًا"],\n    ["mark_paid","تحويل إلى مدفوع"],\n    ["expire","إنهاء التجربة الآن"],\n    ["cancel","إلغاء الحساب"],\n    ["restore_trial","إعادة الحساب كتجريبي"]\n  ].map(function(item){\n    return \'<option value="\'+item[0]+\'">\'+item[1]+\'</option>\';\n  }).join("");\n}\n\nfunction render(){\n  if(!elements.grid)return;\n\n  const query=elements.search\n    ? elements.search.value.trim().toLowerCase()\n    : "";\n\n  const filtered=users.filter(function(user){\n    return !query ||\n      String(user.email||"").toLowerCase().includes(query);\n  });\n\n  if(filtered.length===0){\n    elements.grid.innerHTML=\n      \'<div class="empty">لا توجد حسابات مطابقة للبحث.</div>\';\n    return;\n  }\n\n  elements.grid.innerHTML=filtered.map(function(user){\n    const encoded=encodeURIComponent(user.email||"");\n    const internal=Boolean(user.is_internal);\n    const remaining=Number(user.days_remaining||0);\n\n    return `\n      <article class="user-card">\n        <div class="user-top">\n          <div class="user-email">${escapeHtml(user.email||"—")}</div>\n          <div class="badges">\n            <span class="badge">${escapeHtml(statusArabic(user.computed_status))}</span>\n            ${internal?\'<span class="badge internal">اختبار داخلي</span>\':""}\n          </div>\n        </div>\n\n        <div class="details">\n          <div class="detail">\n            <div class="detail-label">الخطة</div>\n            <div class="detail-value">${escapeHtml(user.plan||"—")}</div>\n          </div>\n          <div class="detail">\n            <div class="detail-label">الأيام المتبقية</div>\n            <div class="detail-value">${escapeHtml(remaining)}</div>\n          </div>\n          <div class="detail">\n            <div class="detail-label">بداية التجربة</div>\n            <div class="detail-value" dir="ltr">${escapeHtml(user.trial_started_at||"—")}</div>\n          </div>\n          <div class="detail">\n            <div class="detail-label">نهاية التجربة</div>\n            <div class="detail-value" dir="ltr">${escapeHtml(user.trial_ends_at||"—")}</div>\n          </div>\n          <div class="detail">\n            <div class="detail-label">يُحتسب ضمن المقاعد</div>\n            <div class="detail-value">${internal?"لا":"نعم"}</div>\n          </div>\n          <div class="detail">\n            <div class="detail-label">معرّف المستخدم</div>\n            <div class="detail-value">${escapeHtml(user.user_id||"—")}</div>\n          </div>\n        </div>\n\n        <div class="actions">\n          <select id="action-${encoded}" aria-label="الإجراء الإداري">\n            ${actionOptions()}\n          </select>\n          <button type="button" data-email="${encoded}">تنفيذ الإجراء</button>\n        </div>\n      </article>`;\n  }).join("");\n\n  elements.grid.querySelectorAll("button[data-email]").forEach(function(button){\n    button.addEventListener("click",function(){\n      runAction(button.getAttribute("data-email")||"");\n    });\n  });\n}\n\nasync function loadData(){\n  ["used","remaining","paid","consents"].forEach(function(key){\n    if(elements[key])elements[key].textContent="...";\n  });\n\n  setMessage("جارٍ تحميل بيانات لوحة الإدارة...",false);\n\n  try{\n    const response=await fetch(\n      "/api/admin/launch-control",\n      {\n        credentials:"include",\n        cache:"no-store",\n        headers:{"Accept":"application/json"}\n      }\n    );\n\n    if(response.status===401||response.status===403){\n      location.href="/login/?next="+\n        encodeURIComponent("/admin/launch-control/");\n      return;\n    }\n\n    if(!response.ok){\n      throw new Error("HTTP "+response.status);\n    }\n\n    const data=await response.json();\n    token=data.admin_token||"";\n    users=Array.isArray(data.users)?data.users:[];\n    const seats=data.seat_control||{};\n    const used=Number(seats.active_trial_seats||0);\n    const maximum=Number(seats.max_trial_seats||50);\n\n    if(elements.used){\n      elements.used.textContent=used+" من "+maximum;\n    }\n    if(elements.remaining){\n      elements.remaining.textContent=String(\n        seats.remaining_trial_seats??0\n      );\n    }\n    if(elements.paid){\n      elements.paid.textContent=String(\n        seats.paid_users??0\n      );\n    }\n    if(elements.consents){\n      elements.consents.textContent=String(\n        data.consent_record_count??0\n      );\n    }\n\n    setMessage(\n      users.length===0\n        ? "لوحة الإدارة تعمل. لا توجد حسابات حتى الآن."\n        : "تم تحديث بيانات لوحة الإدارة.",\n      false\n    );\n\n    render();\n  }catch(error){\n    console.error("NDSP_ADMIN_V169_LOAD_ERROR",error);\n    setMessage(\n      "تعذر تحميل بيانات لوحة الإدارة. حدّث الصفحة، وإن استمرت المشكلة راجع خدمة V167.",\n      true\n    );\n  }\n}\n\nasync function runAction(encoded){\n  const email=decodeURIComponent(encoded);\n  const select=document.getElementById("action-"+encoded);\n\n  if(!select)return;\n\n  const action=select.value;\n\n  if(!confirm("تنفيذ الإجراء المحدد على الحساب؟"))return;\n\n  setMessage("جارٍ تنفيذ الإجراء...",false);\n\n  try{\n    const response=await fetch(\n      "/api/admin/launch-control/action",\n      {\n        method:"POST",\n        credentials:"include",\n        cache:"no-store",\n        headers:{\n          "Content-Type":"application/json",\n          "Accept":"application/json",\n          "X-NDSP-Admin-Token":token\n        },\n        body:JSON.stringify({\n          email:email,\n          action:action,\n          note:"Admin launch-control action from responsive V169"\n        })\n      }\n    );\n\n    const data=await response.json().catch(function(){\n      return {};\n    });\n\n    if(!response.ok){\n      throw new Error(\n        data.error||\n        data.message_ar||\n        ("HTTP "+response.status)\n      );\n    }\n\n    setMessage(\n      data.message_ar||"تم تنفيذ الإجراء.",\n      false\n    );\n    await loadData();\n  }catch(error){\n    setMessage(\n      "فشل تنفيذ الإجراء: "+String(error.message||error),\n      true\n    );\n  }\n}\n\nif(elements.search){\n  elements.search.addEventListener("input",render);\n}\nif(elements.refresh){\n  elements.refresh.addEventListener("click",loadData);\n}\n\nwindow.ndspAdminRefresh=loadData;\nloadData();\n})();\n'

