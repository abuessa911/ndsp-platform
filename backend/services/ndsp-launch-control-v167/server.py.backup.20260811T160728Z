def admin_token(email):
    slot=int(time.time()//1800)
    message=f"{email}|{slot}".encode()
    digest=hmac.new(
        ADMIN_SECRET.encode(),
        message,
        hashlib.sha256,
    ).hexdigest()
    return f"{slot}.{digest}"

def validate_admin_token(email,token):
    try:
        slot_text,digest=token.split(".",1)
        slot=int(slot_text)
    except Exception:
        return False

    current=int(time.time()//1800)

    if abs(current-slot)>1:
        return False

    expected=hmac.new(
        ADMIN_SECRET.encode(),
        f"{email}|{slot}".encode(),
        hashlib.sha256,
    ).hexdigest()

    return hmac.compare_digest(expected,digest)

