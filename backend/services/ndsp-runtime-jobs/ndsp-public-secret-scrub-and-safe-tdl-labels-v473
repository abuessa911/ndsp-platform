#!/usr/bin/env python3
import json
import os
import re
from pathlib import Path

LIVE = Path("/var/www/ndsp-my")
DATA = LIVE / "data" / "command-center-real.json"

# Internal/source terms are scrubbed on the server side only.
# This file is not served publicly.
REPLACEMENTS = [
    ("Commitments of Traders", "البيانات الزمنية الحاكمة"),
    ("Asset Managers", "الفئة التمركزية طويلة المدى"),
    ("Leveraged Funds", "الفئة المضاربية قصيرة المدى"),
    ("Dealer Intermediary", "الفئة الوسيطة"),
    ("Non-Commercials", "الفئة المضاربية"),
    ("NonCommercials", "الفئة المضاربية"),
    ("NonCommercial", "الفئة المضاربية"),
    ("Commercials", "الفئة التمركزية"),
    ("COT", "البيانات الزمنية"),
    ("Dealer", "الفئة الوسيطة"),
    ("مدراء الأصول", "الفئة التمركزية طويلة المدى"),
    ("أصحاب الرافعات المالية", "الفئة المضاربية قصيرة المدى"),
    ("صناديق الرافعات المالية", "الفئة المضاربية قصيرة المدى"),
    ("الرافعات المالية", "الفئة المضاربية قصيرة المدى"),
    ("المتاجرين", "الفئة النشطة"),
]

TEXT_SUFFIXES = {
    ".html", ".js", ".css", ".json", ".txt", ".svg", ".map", ".md"
}

SKIP_DIRS = {
    "node_modules", ".git", "__pycache__"
}

def scrub_string(value: str) -> str:
    out = value
    for a, b in REPLACEMENTS:
        out = out.replace(a, b)
    return out

def scrub_obj(obj):
    if isinstance(obj, dict):
        return {scrub_string(str(k)): scrub_obj(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [scrub_obj(v) for v in obj]
    if isinstance(obj, str):
        return scrub_string(obj)
    return obj

def normalize_unknown(v):
    if v is None:
        return "غير مؤكد"
    s = str(v).strip()
    if not s or s.upper() in {"UNKNOWN", "UNSPECIFIED", "NONE", "NULL"}:
        return "غير مؤكد"
    return scrub_string(s)

def pressure_label(v):
    s = str(v or "").upper()
    if any(x in s for x in ["BEAR", "DOWN", "SELL", "SHORT", "هابط"]):
        return "ضغط هابط"
    if any(x in s for x in ["BULL", "UP", "BUY", "LONG", "صاعد"]):
        return "ضغط صاعد"
    return "غير مؤكد"

def enrich_data_contract():
    if not DATA.exists():
        return {"data_exists": False}
    try:
        d = json.loads(DATA.read_text(encoding="utf-8"))
    except Exception as e:
        return {"data_error": str(e)}

    d = scrub_obj(d)
    items = d.get("items") if isinstance(d.get("items"), list) else []

    for item in items:
        if not isinstance(item, dict):
            continue

        direction_nature = item.get("direction_nature") if isinstance(item.get("direction_nature"), dict) else {}
        tdl_tracks = item.get("tdl_tracks") if isinstance(item.get("tdl_tracks"), dict) else {}

        ext = direction_nature.get("extended_explicit") if isinstance(direction_nature.get("extended_explicit"), dict) else {}
        imp = direction_nature.get("narrow_implicit") if isinstance(direction_nature.get("narrow_implicit"), dict) else {}

        mnl = tdl_tracks.get("tdl_mnl") if isinstance(tdl_tracks.get("tdl_mnl"), dict) else {}
        tds = tdl_tracks.get("tdl_s") if isinstance(tdl_tracks.get("tdl_s"), dict) else {}

        mnl_dir = mnl.get("direction") or mnl.get("state") or mnl.get("bias")
        s_dir = tds.get("direction") or tds.get("state") or tds.get("bias")
        ext_state = ext.get("state") or ext.get("direction") or ext.get("bias")
        imp_state = imp.get("state") or imp.get("direction") or imp.get("bias")

        item["tdl_public_display"] = {
            "tdl_mnl_label": "TDL-M&L — تمركزي طويل المدى",
            "tdl_mnl_control_days": "الاثنين والجمعة",
            "tdl_mnl_public_state": f"{pressure_label(mnl_dir)} تمركزي طويل المدى",
            "tdl_s_label": "TDL-S — مضاربي قصير المدى",
            "tdl_s_control_days": "الثلاثاء، الأربعاء، الخميس — والسبت والأحد للكريبتو فقط",
            "tdl_s_public_state": f"{pressure_label(s_dir)} مضاربي قصير المدى",
            "extended_label": "على المكشوف — أفق ممتد",
            "extended_public_state": f"{pressure_label(ext_state)} — أفق ممتد",
            "narrow_label": "غير صريح — أفق ضيق",
            "narrow_public_state": f"{pressure_label(imp_state)} — أفق ضيق",
            "display_policy": "Public-safe labels only"
        }

        # Never expose raw internal/source labels in display fields.
        item["tdl_tracks"] = scrub_obj(item.get("tdl_tracks"))
        item["direction_nature"] = scrub_obj(item.get("direction_nature"))

    d["public_display_terms_sanitized"] = True
    d["public_tdl_labels_version"] = "NDSP_V4.7.3_SAFE_PUBLIC_TDL_LABELS"
    DATA.write_text(json.dumps(d, ensure_ascii=False, indent=2), encoding="utf-8")

    return {
        "data_exists": True,
        "items": len(items),
        "version": d.get("version"),
        "public_display_terms_sanitized": d.get("public_display_terms_sanitized"),
        "public_tdl_labels_version": d.get("public_tdl_labels_version")
    }

def scrub_live_text_files():
    changed = 0
    scanned = 0
    for path in LIVE.rglob("*"):
        if not path.is_file():
            continue
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        if path.suffix.lower() not in TEXT_SUFFIXES:
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue
        scanned += 1
        new = scrub_string(text)
        # Convert visible raw UNKNOWN only in public files.
        new = re.sub(r"\bUNKNOWN\b", "غير مؤكد", new)
        if new != text:
            path.write_text(new, encoding="utf-8")
            changed += 1
    return {"scanned_text_files": scanned, "changed_text_files": changed}

result = {
    "data": enrich_data_contract(),
    "files": scrub_live_text_files()
}
print(json.dumps(result, ensure_ascii=False))
