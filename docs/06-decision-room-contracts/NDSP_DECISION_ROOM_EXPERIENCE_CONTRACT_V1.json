  "signal_badge_rules": {
    "section_label_ar": "قواعد ظهور بادجات الإشارات والأختام",
    "rules": [
      {
        "badge_id": "GOLDEN_UNDER_MONITORING",
        "label_ar": "ذهبية تحت المتابعة",
        "show_when": [
          "golden_signal.available == true",
          "golden_signal.state == UNDER_MONITORING",
          "risk_state != BLOCKED"
        ],
        "hide_when": [
          "data_status == STALE",
          "governance_block == true"
        ],
        "message_ar": "تظهر عندما تكون القراءة قوية لكنها غير مكتملة."
      },
      {
        "badge_id": "ENHANCED_NEEDS_CONFIRMATION",
        "label_ar": "ذهبية معززة تحتاج تأكيد",
        "show_when": [
          "enhanced_golden_signal.available == true",
          "enhanced_golden_signal.state == NEEDS_CONFIRMATION",
          "nmp.status == AVAILABLE",
          "remaining_confirmations.length > 0"
        ],
        "message_ar": "تظهر عندما تقترب القراءة المعززة من الاكتمال لكنها تنتظر شروطًا إضافية."
      },
      {
        "badge_id": "COMPLETED_READING",
        "label_ar": "قراءة مكتملة",
        "show_when": [
          "single_truth_state.canonical_state == COMPLETED_READING",
          "completion_checklist.is_completed == true",
          "validation_gates.all_required_gates_passed == true"
        ],
        "message_ar": "تظهر كقراءة مكتملة حسب منطق NDSP، وليست صفقة."
      },
      {
        "badge_id": "CAUTION",
        "label_ar": "بحذر",
        "show_when": [
          "risk_state == CAUTION",
          "why_not_completed.exists == true"
        ],
        "message_ar": "تظهر عندما توجد عوامل داعمة لكن الحذر يمنع الاكتمال."
      },
      {
        "badge_id": "DEVILS_ADVOCATE_WARNING",
        "label_ar": "محامي الشيطان يحذر",
        "show_when": [
          "devils_advocate.status == WARNING"
        ],
        "message_ar": "تظهر عندما توجد اعتراضات داخلية لا تصل إلى الحجب."
      },
      {
        "badge_id": "DEVILS_ADVOCATE_BLOCK",
        "label_ar": "محامي الشيطان حجب القراءة",
        "show_when": [
          "devils_advocate.status == BLOCKED"
        ],
        "message_ar": "تظهر عندما يمنع الاعتراض الداخلي عرض القراءة كقراءة صالحة."
      }
    ],
    "ui_rule_ar": "البادج يشرح حالة قراءة، ولا يجوز عرضه كأمر أو توصية."
  },
