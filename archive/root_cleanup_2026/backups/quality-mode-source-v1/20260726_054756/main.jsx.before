function SupportPage() {
  const { state } = useDecision();
  const { t, lang } = useTranslate();

  const draftKey =
    "ndsp.commercial.support.draft.v1";

  const savedDraft =
    readJsonStorage(
      draftKey,
      {}
    );

  const [form, setForm] = useState({
    category:
      savedDraft.category ||
      "technical",
    subject:
      savedDraft.subject ||
      "",
    message:
      savedDraft.message ||
      "",
    email:
      savedDraft.email ||
      ""
  });

  const [submitState, setSubmitState] =
    useState({
      status: "idle",
      message: "",
      reference: ""
    });

  useEffect(() => {
    localStorage.setItem(
      draftKey,
      JSON.stringify(form)
    );
  }, [form]);

  const patchForm = (patch) => {
    setForm((current) => ({
      ...current,
      ...patch
    }));
  };

  const submit = async (event) => {
    event.preventDefault();

    if (
      !form.subject.trim() ||
      !form.message.trim()
    ) {
      setSubmitState({
        status: "error",
        message:
          lang === "ar"
            ? "اكتب عنوان الطلب وتفاصيله قبل الإرسال."
            : "Enter the request subject and details before submitting.",
        reference: ""
      });
      return;
    }

    setSubmitState({
      status: "loading",
      message:
        lang === "ar"
          ? "جارٍ إرسال الطلب…"
          : "Submitting request…",
      reference: ""
    });

    try {
      const result =
        await submitSupportTicket({
          ...form,
          symbol: state.symbol,
          market: state.market,
          timeframe: state.timeframe,
          readingType: state.mode,
          viewLevel: state.view,
          lang: state.lang,
          page:
            window.location.pathname,
          createdAt:
            new Date().toISOString()
        });

      const reference =
        result?.body?.ticket_id ||
        result?.body?.id ||
        result?.body?.reference ||
        "";

      setSubmitState({
        status: "success",
        message:
          lang === "ar"
            ? "تم استلام طلب الدعم بنجاح."
            : "The support request was received successfully.",
        reference:
          reference
            ? String(reference)
            : ""
      });

      setForm((current) => ({
        ...current,
        subject: "",
        message: ""
      }));
    } catch (error) {
      setSubmitState({
        status: "error",
        message:
          lang === "ar"
            ? "واجهة الدعم جاهزة، لكن خدمة استقبال التذاكر الخلفية غير متاحة حاليًا. تم الاحتفاظ بالمسودة على هذا الجهاز."
            : "The support interface is ready, but the backend ticket service is currently unavailable. The draft remains saved on this device.",
        reference: ""
      });
    }
  };

  return (
    <>
      <PageHeader
        title={t("support")}
        subtitle={
          lang === "ar"
            ? "إرسال طلب دعم مرتبط بسياق القراءة الحالية"
            : "Submit a support request linked to the current reading context"
        }
      />

      <div className="content-grid two support-grid">
        <Card
          title={
            lang === "ar"
              ? "طلب دعم جديد"
              : "New support request"
          }
        >
          <form
            className="support-form"
            onSubmit={submit}
          >
            <label>
              <span>
                {
                  lang === "ar"
                    ? "نوع الطلب"
                    : "Request type"
                }
              </span>

              <select
                value={form.category}
                onChange={(event) =>
                  patchForm({
                    category:
                      event.target.value
                  })
                }
              >
                <option value="technical">
                  {
                    lang === "ar"
                      ? "مشكلة تقنية"
                      : "Technical issue"
                  }
                </option>

                <option value="account">
                  {
                    lang === "ar"
                      ? "الحساب والاشتراك"
                      : "Account and subscription"
                  }
                </option>

                <option value="data">
                  {
                    lang === "ar"
                      ? "بيانات وقراءات"
                      : "Data and readings"
                  }
                </option>

                <option value="other">
                  {
                    lang === "ar"
                      ? "أخرى"
                      : "Other"
                  }
                </option>
              </select>
            </label>

            <label>
              <span>
                {
                  lang === "ar"
                    ? "البريد للتواصل"
                    : "Contact email"
                }
              </span>

              <input
                type="email"
                value={form.email}
                onChange={(event) =>
                  patchForm({
                    email:
                      event.target.value
                  })
                }
                placeholder="name@example.com"
              />
            </label>

            <label>
              <span>
                {
                  lang === "ar"
                    ? "عنوان الطلب"
                    : "Subject"
                }
              </span>

              <input
                type="text"
                value={form.subject}
                onChange={(event) =>
                  patchForm({
                    subject:
                      event.target.value
                  })
                }
              />
            </label>

            <label>
              <span>
                {
                  lang === "ar"
                    ? "التفاصيل"
                    : "Details"
                }
              </span>

              <textarea
                rows="7"
                value={form.message}
                onChange={(event) =>
                  patchForm({
                    message:
                      event.target.value
                  })
                }
              />
            </label>

            <button
              className="button primary"
              type="submit"
              disabled={
                submitState.status ===
                "loading"
              }
            >
              {
                submitState.status ===
                "loading"
                  ? (
                      lang === "ar"
                        ? "جارٍ الإرسال…"
                        : "Submitting…"
                    )
                  : (
                      lang === "ar"
                        ? "إرسال الطلب"
                        : "Submit request"
                    )
              }
            </button>
          </form>

          {
            submitState.status !== "idle"
              ? (
                  <div
                    className={
                      `support-result ${
                        submitState.status
                      }`
                    }
                  >
                    <strong>
                      {submitState.message}
                    </strong>

                    {
                      submitState.reference
                        ? (
                            <small>
                              {
                                lang === "ar"
                                  ? "المرجع"
                                  : "Reference"
                              }
                              :{" "}
                              {
                                submitState.reference
                              }
                            </small>
                          )
                        : null
                    }
                  </div>
                )
              : null
          }
        </Card>

        <Card
          title={
            lang === "ar"
              ? "سياق الطلب"
              : "Request context"
          }
        >
          <div className="advanced-list">
            <span>
              {t("market")}
              <b>
                {marketLabel(
                  state.market,
                  lang
                )}
              </b>
            </span>

            <span>
              {t("asset")}
              <b>{state.symbol}</b>
            </span>

            <span>
              {t("timeframe")}
              <b>{state.timeframe}</b>
            </span>

            <span>
              {t("readingType")}
              <b>{t(state.mode)}</b>
            </span>
          </div>

          <div className="callout">
            <Icon name="info"/>
            <p>
              {
                lang === "ar"
                  ? "لا تظهر رسالة نجاح إلا بعد قبول الطلب من خدمة الدعم الخلفية."
                  : "A success message appears only after the backend support service accepts the request."
              }
            </p>
          </div>
        </Card>
      </div>
    </>
  );
}

function AccountPage() {
  const { t } = useTranslate();
  const access = useAccessState();
  return <><PageHeader title={t("account")}/><div className="account-grid"><Card title={t("account")}><p>{access.authenticated === false ? t("authRequired") : access.authenticated === true ? t("live") : t("noUserData")}</p></Card><Card title={t("plans")}><pre className="json-view">{access.entitlement ? JSON.stringify(access.entitlement, null, 2) : t("planUnavailable")}</pre></Card><Card title="Trial registration"><Badge tone={access.registration?.registration_allowed ? "success" : "muted"}>{access.registration?.registration_allowed ? t("registrationAvailable") : t("registrationUnavailable")}</Badge></Card></div></>;
}

function PlansPage() {
  const { t } = useTranslate();
  return <><PageHeader title={t("plans")}/><div className="plans-grid"><Card title={t("plans")}><p>{t("planUnavailable")}</p></Card><Card title="Billing"><div className="callout warning"><Icon name="warning"/><p>{t("billingUnavailable")}</p></div></Card></div></>;
}

function SettingsPage() {
  const {
    density,
    setDensity
  } = useDecision();

  const { t, lang } = useTranslate();

  return (
    <>
      <PageHeader title={t("settings")}/>

      <div className="settings-grid">
        <Card title={t("sourceStatus")}>
          <div className="radio-stack">
            <label>
              <input
                type="radio"
                checked
                readOnly
              />

              <span>
                <b>{t("live")}</b>
                <small>
                  {t("commercialNotice")}
                </small>
              </span>
            </label>
          </div>
        </Card>

        <Card title={t("appearance")}>
          <p className="setting-explanation">
            {
              lang === "ar"
                ? "المظهر هنا يحدد كثافة عرض الصفحة والمسافات بين العناصر، ولا يغير ألوان المنصة أو بياناتها."
                : "Appearance here controls page density and spacing; it does not change platform colors or data."
            }
          </p>

          <div className="radio-stack">
            <label>
              <input
                type="radio"
                name="density"
                checked={
                  density ===
                  "comfortable"
                }
                onChange={() =>
                  setDensity(
                    "comfortable"
                  )
                }
              />

              <span>
                <b>{t("comfortable")}</b>
                <small>
                  {
                    lang === "ar"
                      ? "مسافات أكبر وقراءة أهدأ، مع ظهور محتوى أقل في الشاشة."
                      : "More spacing and calmer reading, with less content visible at once."
                  }
                </small>
              </span>
            </label>

            <label>
              <input
                type="radio"
                name="density"
                checked={
                  density === "compact"
                }
                onChange={() =>
                  setDensity("compact")
                }
              />

              <span>
                <b>{t("compact")}</b>
                <small>
                  {
                    lang === "ar"
                      ? "مسافات أقل لعرض محتوى أكثر دون تغيير حجم البيانات أو معناها."
                      : "Less spacing to show more content without changing data size or meaning."
                  }
                </small>
              </span>
            </label>
          </div>
        </Card>
      </div>
    </>
  );
}

function ContextPage() {
  const { state, patch } = useDecision();
  const { navigate } = useNavigation();
  const { t, lang } = useTranslate();
  const [draft, setDraft] = useState(state);
  const assets = ASSETS.filter((asset) => asset.market === draft.market);
  return <><PageHeader title={t("changeContext")}/><Card title={t("changeContext")}><div className="context-form"><label><span>{t("market")}</span><select value={draft.market} onChange={(event) => { const market = event.target.value; setDraft((current) => ({ ...current, market, symbol: ASSETS.find((asset) => asset.market === market)?.symbol || current.symbol })); }}>{MARKETS.map((market) => <option value={market} key={market}>{marketLabel(market, lang)}</option>)}</select></label><label><span>{t("asset")}</span><select value={draft.symbol} onChange={(event) => setDraft((current) => ({ ...current, symbol: event.target.value }))}>{assets.map((asset) => <option value={asset.symbol} key={asset.symbol}>{assetName(asset, lang)} · {asset.symbol}</option>)}</select></label><label><span>{t("timeframe")}</span><select value={draft.timeframe} onChange={(event) => setDraft((current) => ({ ...current, timeframe: event.target.value }))}>{TIMEFRAMES.map((timeframe) => <option key={timeframe}>{timeframe}</option>)}</select></label><label><span>{t("readingType")}</span><select value={draft.mode} onChange={(event) => setDraft((current) => ({ ...current, mode: event.target.value }))}><option value="investment">{t("investment")}</option><option value="speculative">{t("speculative")}</option></select></label><label><span>{t("viewLevel")}</span><select value={draft.view} onChange={(event) => setDraft((current) => ({ ...current, view: event.target.value }))}><option value="beginner">{t("beginner")}</option><option value="professional">{t("professional")}</option></select></label></div><div className="form-actions"><button className="button secondary" onClick={() => setDraft(state)}>{t("reset")}</button><button className="button primary" onClick={() => { patch(draft, { newSession: true, push: true }); navigate("/command-center"); }}>{t("confirm")}</button></div></Card></>;
}

function TrialExpiredPage() {
  const { t } = useTranslate();
  const { navigate } = useNavigation();
  return <div className="center-page"><Icon name="lock" size={52}/><h1>{t("trialExpired")}</h1><p>{t("planUnavailable")}</p><button className="button primary" onClick={() => navigate("/plans")}>{t("plans")}</button></div>;
}
function NotFoundPage() {
  const { navigate } = useNavigation();
  return <div className="center-page"><span className="error-code">404</span><button className="button primary" onClick={() => navigate("/command-center")}><Icon name="home"/> Home</button></div>;
}

function AppRoutes() {
  const { route, navigate } = useNavigation();
  useEffect(() => { if (route === "/") navigate("/command-center", { replace: true }); }, [route, navigate]);
  const routes = {
    "/command-center": <CommandCenterPage/>,
    "/markets": <MarketsPage/>,
    "/prices-chart": <PricesChartPage/>,
    "/opportunities": <OpportunitiesPage/>,
    "/decision-room": <DecisionRoomPage/>,
    "/portfolio": <PortfolioPage/>,
    "/scenarios": <ScenariosPage/>,
    "/layers": <LayersPage/>,
    "/risk": <RiskPage/>,
    "/completed": <CompletedPage/>,
    "/data-health": <DataHealthPage/>,
    "/alerts": <AlertsPage/>,
    "/guide": <GuidePage/>,
    "/support": <SupportPage/>,
    "/account": <AccountPage/>,
    "/plans": <PlansPage/>,
    "/settings": <SettingsPage/>,
    "/context": <ContextPage/>,
    "/trial-expired": <TrialExpiredPage/>
  };
  return routes[route] || <NotFoundPage/>;
}

function AppShell() {
  const { t } = useTranslate();
  return <div className="app-shell"><Topbar/><ContextStrip/><main className="page-container"><AppRoutes/></main><footer className="footer"><span>© 2026 NDSP</span><span>{t("explanatoryOnly")}</span></footer><LegalModal/></div>;
}

class AppErrorBoundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      error: null
    };
  }

  static getDerivedStateFromError(error) {
    return {
      error
    };
  }

  componentDidCatch(error, info) {
    console.error(
      "NDSP_ROUTE_RENDER_ERROR",
      error,
      info
    );
  }

  render() {
    if (!this.state.error) {
      return this.props.children;
    }

    const ar =
      document.documentElement.lang === "ar" ||
      new URLSearchParams(
        window.location.search
      ).get("lang") === "ar";

    return (
      <div
        className="route-error-state"
        dir={ar ? "rtl" : "ltr"}
      >
        <Icon name="warning" size={42}/>

        <h1>
          {
            ar
              ? "تعذر عرض الصفحة"
              : "Unable to render the page"
          }
        </h1>

        <p>
          {
            ar
              ? "تم منع الشاشة السوداء. أعد تحميل الصفحة، وإذا استمرت المشكلة استخدم مركز الدعم وأرفق اسم الصفحة."
              : "A blank screen was prevented. Reload the page; if the issue persists, use Support and include the page name."
          }
        </p>

        <button
          className="button primary"
          onClick={() =>
            window.location.reload()
          }
        >
          {
            ar
              ? "إعادة تحميل الصفحة"
              : "Reload page"
          }
        </button>
      </div>
    );
  }
}

function App() {
  return (
    <React.StrictMode>
      <DecisionProvider>
        <BrowserRouter>
          <AppErrorBoundary>
            <AppShell/>
          </AppErrorBoundary>
        </BrowserRouter>
      </DecisionProvider>
    </React.StrictMode>
  );
}

createRoot(document.getElementById("root")).render(<App/>);
