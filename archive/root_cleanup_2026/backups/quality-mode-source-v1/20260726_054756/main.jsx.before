function newSession() {
  return `s-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
}

function normalizeContext(input = {}) {
  const next = { ...DEFAULT_CONTEXT, ...input };
  if (!["ar", "en"].includes(next.lang)) next.lang = "ar";
  if (!["investment", "speculative"].includes(next.mode)) next.mode = "investment";
  if (!["beginner", "professional"].includes(next.view)) next.view = "beginner";
  if (!MARKETS.includes(next.market)) next.market = "CRYPTO";
  if (!ASSETS.some((asset) => asset.market === next.market && asset.symbol === next.symbol)) {
    next.symbol = ASSETS.find((asset) => asset.market === next.market)?.symbol || "BTCUSDT";
  }
  if (!TIMEFRAMES.includes(next.timeframe)) next.timeframe = "weekly";
  if (!next.session) next.session = newSession();
  return next;
}

function readJsonStorage(key, fallback) {
  try {
    const value = localStorage.getItem(key);
    return value ? JSON.parse(value) : fallback;
  } catch {
    return fallback;
  }
}

function queryContext() {
  const params = new URLSearchParams(window.location.search);
  const value = {};
  CONTEXT_KEYS.forEach((key) => {
    if (params.has(key)) value[key] = params.get(key);
  });
  return value;
}

function updateContextQuery(state, replace = true) {
  const url = new URL(window.location.href);
  CONTEXT_KEYS.forEach((key) => url.searchParams.set(key, state[key]));
  history[replace ? "replaceState" : "pushState"](null, "", `${url.pathname}${url.search}${url.hash}`);
}

function routeFromLocation() {
  let path = window.location.pathname;
  if (APP_BASE && path.startsWith(APP_BASE)) path = path.slice(APP_BASE.length) || "/";
  path = path.replace(/\/+$/, "") || "/";
  return path;
}

const NavigationContext = createContext(null);
function BrowserRouter({ children }) {
  const [route, setRoute] = useState(routeFromLocation);
  useEffect(() => {
    const onPop = () => setRoute(routeFromLocation());
    addEventListener("popstate", onPop);
    return () => removeEventListener("popstate", onPop);
  }, []);
  const navigate = useCallback((to, { replace = false } = {}) => {
    const path = to.startsWith("/") ? to : `/${to}`;
    const url = `${APP_BASE}${path}${window.location.search}`;
    history[replace ? "replaceState" : "pushState"](null, "", url);
    setRoute(path.replace(/\/+$/, "") || "/");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }, []);
  return <NavigationContext.Provider value={{ route, navigate }}>{children}</NavigationContext.Provider>;
}
function useNavigation() {
  const value = useContext(NavigationContext);
  if (!value) throw new Error("Navigation context is missing");
  return value;
}

const DecisionContext = createContext(null);
function DecisionProvider({ children }) {
  const [state, setState] = useState(() => normalizeContext({
    ...readJsonStorage(CONTEXT_STORAGE, {}),
    ...queryContext()
  }));
  const [accepted, setAccepted] = useState(() => localStorage.getItem(LEGAL_STORAGE) === "yes");
  const [density, setDensityState] = useState(() => localStorage.getItem(DENSITY_STORAGE) || "comfortable");

  useEffect(() => {
    document.documentElement.lang = state.lang;
    document.documentElement.dir = state.lang === "ar" ? "rtl" : "ltr";
    document.body.dataset.density = density;
    localStorage.setItem(CONTEXT_STORAGE, JSON.stringify(state));
    localStorage.setItem(DENSITY_STORAGE, density);
    updateContextQuery(state, true);
  }, [state, density]);

  useEffect(() => {
    const onPop = () => setState(normalizeContext({ ...readJsonStorage(CONTEXT_STORAGE, {}), ...queryContext() }));
    addEventListener("popstate", onPop);
    return () => removeEventListener("popstate", onPop);
  }, []);

  const patch = useCallback((partial, options = {}) => {
    setState((current) => {
      const next = normalizeContext({
        ...current,
        ...partial,
        ...(options.newSession ? { session: newSession() } : {})
      });
      if (options.push) updateContextQuery(next, false);
      return next;
    });
  }, []);

  const acceptLegal = useCallback(() => {
    localStorage.setItem(LEGAL_STORAGE, "yes");
    setAccepted(true);
  }, []);

  const setDensity = useCallback((value) => {
    setDensityState(value === "compact" ? "compact" : "comfortable");
  }, []);

  const value = useMemo(() => ({
    state,
    patch,
    dataMode: "live",
    accepted,
    acceptLegal,
    density,
    setDensity
  }), [state, patch, accepted, acceptLegal, density, setDensity]);

  return <DecisionContext.Provider value={value}>{children}</DecisionContext.Provider>;
}
function useDecision() {
  const value = useContext(DecisionContext);
  if (!value) throw new Error("Decision context is missing");
  return value;
}

function useTranslate() {
  const { state } = useDecision();
  const lang = state.lang;
  const t = useCallback((key) => I18N[lang]?.[key] ?? key, [lang]);
  return { lang, t };
}

async function fetchJson(path, { signal, timeout = 15000 } = {}) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeout);
  const abort = () => controller.abort();
  signal?.addEventListener("abort", abort, { once: true });
  try {
    const response = await fetch(path, {
      signal: controller.signal,
      cache: "no-store",
      credentials: "same-origin",
      headers: { Accept: "application/json" }
    });
    const contentType = response.headers.get("content-type") || "";
    const body = contentType.includes("json") ? await response.json() : await response.text();
    if (!response.ok) {
      const error = new Error(`HTTP_${response.status}`);
      error.status = response.status;
      error.body = body;
      throw error;
    }
    return body;
  } finally {
    clearTimeout(timer);
    signal?.removeEventListener("abort", abort);
  }
}

function numeric(value) {
  if (value === null || value === undefined || value === "") return null;
  if (typeof value === "number") return Number.isFinite(value) ? value : null;
  if (typeof value === "string") {
    const cleaned = value.replace(/,/g, "").trim();
    const parsed = Number(cleaned);
    return Number.isFinite(parsed) ? parsed : null;
  }
  if (typeof value === "object") {
    for (const key of ["price", "value", "level", "raw_value", "rawValue"]) {
      const parsed = numeric(value[key]);
      if (parsed !== null) return parsed;
    }
  }
  return null;
}

function formatNumber(value, lang = "ar", digits = 2) {
  const parsed = numeric(value);
  if (parsed === null) return "—";
  return new Intl.NumberFormat(lang === "ar" ? "ar-SA" : "en-US", {
    maximumFractionDigits: digits
  }).format(parsed);
}

function formatDate(value, lang = "ar") {
  if (!value) return "—";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "—";
  return date.toLocaleString(lang === "ar" ? "ar-SA" : "en-US");
}

function assetName(asset, lang) {
  return lang === "ar" ? asset.nameAr : asset.nameEn;
}
function marketLabel(market, lang) {
  const labels = {
    CRYPTO: { ar: "العملات الرقمية", en: "Crypto" },
    FOREX: { ar: "العملات", en: "Forex" },
    METALS: { ar: "المعادن", en: "Metals" },
    COMMODITIES: { ar: "السلع", en: "Commodities" },
    INDICES: { ar: "المؤشرات", en: "Indices" },
    BONDS: { ar: "السندات", en: "Bonds" },
    ENERGY: { ar: "الطاقة", en: "Energy" }
  };
  return labels[market]?.[lang] || market;
}
function findAsset(symbol) {
  return ASSETS.find((asset) => asset.symbol === symbol) || ASSETS[0];
}

function normalizeQuality(payload) {
  if (!payload || typeof payload !== "object") return null;

  const scenario = payload.scenario || {};
  const levels = payload.scenario_levels || scenario.scenario_levels || {};
  const scoreInputs = payload.score_inputs || {};
  const allowed = payload.allowed_public_outputs || {};
  const market = payload.live_market_analysis || {};
  const technical =
    payload.technical_indicators ||
    payload.indicators ||
    market.indicators ||
    {};
  const blockers = scoreInputs.blockers || payload.blockers || {};
  const tdl = scoreInputs.tdl || {};
  const correction = scoreInputs.correction || {};
  const momentum = scoreInputs.momentum || {};
  const macro = scoreInputs.macro || {};
  const nmp = payload.nmp || {};
  const golden =
    payload.golden_spotlight ||
    payload.public_explainability?.golden_alignment ||
    {};

  return {
    raw: payload,
    ok: payload.ok === true,
    instrument: {
      symbol: payload.instrument?.symbol || payload.symbol || null,
      market: payload.instrument?.market || payload.market || null,
      timeframe:
        payload.instrument?.timeframe ||
        payload.timeframe ||
        null,
      livePrice: numeric(
        payload.instrument?.live_price ??
        payload.live_price
      )
    },
    scenario: {
      state:
        scenario.scenario_state ||
        payload.scenario_state ||
        null,
      directionalContext:
        scenario.scenario_directional_context ||
        payload.scenario_directional_context ||
        allowed.market_state ||
        null,
      activation: numeric(
        levels.activation ??
        scenario.scenario_activation_level ??
        payload.scenario_activation_level
      ),
      arrival: numeric(
        levels.arrival ??
        scenario.scenario_arrival_level ??
        payload.scenario_arrival_level
      ),
      review: numeric(
        levels.review ??
        scenario.scenario_review_zone ??
        scenario.scenario_review_level ??
        payload.scenario_review_zone ??
        payload.scenario_review_level
      ),
      invalidation: numeric(
        levels.invalidation ??
        scenario.scenario_invalidation_level ??
        payload.scenario_invalidation_level
      ),
      confidenceBand:
        scenario.scenario_confidence_band ||
        allowed.horizon_strength ||
        null,
      timeHorizon:
        scenario.scenario_time_horizon ||
        allowed.reading_horizon ||
        payload.time_horizon ||
        null,
      riskNote:
        scenario.scenario_risk_note ||
        allowed.caution_reason ||
        payload.caution_reason ||
        null,
      updatedAt:
        scenario.scenario_last_updated ||
        payload.generated_at ||
        payload.updated_at ||
        null
    },
    decisionQuality: numeric(
      allowed.decision_quality ??
      payload.decision_quality
    ),
    alignmentScore: numeric(
      tdl.alignment_score ??
      payload.alignment_score
    ),
    confirmationScore: numeric(
      correction.confirmation_score ??
      payload.confirmation_score
    ),
    macdHistogram: numeric(
      momentum.macd_histogram ??
      momentum.macdHistogram ??
      technical.macd_histogram ??
      technical.macdHistogram ??
      technical.macd?.histogram ??
      market.macd_histogram ??
      market.selected_timeframe_macd_histogram ??
      payload.macd_histogram
    ),
    obvSlope: numeric(
      momentum.obv_slope ??
      momentum.obvSlope ??
      technical.obv_slope ??
      technical.obvSlope ??
      market.obv_slope ??
      market.selected_timeframe_obv_slope ??
      payload.obv_slope
    ),
    cciValue: numeric(
      momentum.cci_value ??
      momentum.cciValue ??
      technical.cci_value ??
      technical.cciValue ??
      technical.cci ??
      market.cci_value ??
      market.selected_timeframe_cci ??
      payload.cci_value
    ),
    usdPressureScore: numeric(
      macro.usd_pressure_score ??
      payload.usd_pressure_score
    ),
    blockers: {
      count: numeric(blockers.count) ?? 0,
      codes: Array.isArray(blockers.codes)
        ? blockers.codes
        : Array.isArray(payload.blocker_codes)
          ? payload.blocker_codes
          : []
    },
    nmp: {
      status:
        nmp.status ||
        payload.nmp_status ||
        scenario.nmp_status ||
        payload.nmp_availability ||
        null,
      level: numeric(
        nmp.level ??
        nmp.value ??
        nmp.price ??
        nmp.mid ??
        payload.nmp_level ??
        payload.nmp_value ??
        payload.nmp_price ??
        payload.nmp_reference_level ??
        allowed.nmp_level ??
        allowed.nmp_value ??
        allowed.nmp?.level ??
        levels.nmp ??
        scenario.scenario_nmp_level ??
        scenario.nmp_level ??
        scenario.nmp_value
      ),
      rangeLow: numeric(
        nmp.low ??
        nmp.min ??
        payload.nmp_low ??
        payload.nmp_min ??
        scenario.nmp_low ??
        scenario.nmp_min
      ),
      rangeHigh: numeric(
        nmp.high ??
        nmp.max ??
        payload.nmp_high ??
        payload.nmp_max ??
        scenario.nmp_high ??
        scenario.nmp_max
      ),
      note:
        nmp.note ||
        allowed.nmp_note ||
        payload.nmp_note ||
        scenario.nmp_note ||
        null
    },
    golden: {
      status:
        golden.status ||
        payload.golden_status ||
        null,
      label:
        golden.label ||
        payload.golden_label ||
        null,
      summary:
        golden.summary ||
        golden.reason ||
        payload.golden_reason_public ||
        null
    },
    liveChangePct: numeric(
      market.price_change_24h_pct
    ),
    sourceStatus: "live",
    sourceMode: payload.source_mode || null,
    generatedAt:
      payload.generated_at ||
      scenario.scenario_last_updated ||
      null,
    decisionLayers: Array.isArray(payload.decision_layers)
      ? payload.decision_layers
      : [],
    launchReadiness:
      payload.launch_readiness ||
      null
  };
}

const qualityCache = new Map();
const candlesCache = new Map();
function cacheFresh(entry, maxAge) {
  return entry && Date.now() - entry.time < maxAge;
}

async function loadQuality(symbol, timeframe, signal) {
  const key = `${symbol}|${timeframe}`;
  const cached = qualityCache.get(key);
  if (cacheFresh(cached, 20_000)) return cached.value;
  const payload = await fetchJson(`/api/decision/quality-live?symbol=${encodeURIComponent(symbol)}&timeframe=${encodeURIComponent(timeframe)}`, { signal });
  const value = normalizeQuality(payload);
  if (!value) throw new Error("INVALID_QUALITY_PAYLOAD");
  qualityCache.set(key, { time: Date.now(), value });
  return value;
}

function useQuality(symbol, timeframe) {
  const [state, setState] = useState({ status: "loading", value: null, error: null });
  const [revision, setRevision] = useState(0);
  const retry = useCallback(() => setRevision((value) => value + 1), []);
  useEffect(() => {
    const controller = new AbortController();
    setState((current) => ({ ...current, status: "loading", error: null }));
    loadQuality(symbol, timeframe, controller.signal)
      .then((value) => setState({ status: "ready", value, error: null }))
      .catch((error) => {
        if (error.name !== "AbortError") setState({ status: "error", value: null, error });
      });
    return () => controller.abort();
  }, [symbol, timeframe, revision]);
  return { ...state, retry };
}

function normalizeCandles(payload) {
  const rows = Array.isArray(payload) ? payload : payload?.candles || payload?.items || payload?.data || [];
  return rows
    .map((row) => ({
      time: numeric(row.time ?? row.timestamp ?? row.open_time ?? row.t),
      open: numeric(row.open ?? row.o),
      high: numeric(row.high ?? row.h),
      low: numeric(row.low ?? row.l),
      close: numeric(row.close ?? row.c),
      volume: numeric(row.volume ?? row.v)
    }))
    .filter((row) => [row.time, row.open, row.high, row.low, row.close].every((value) => value !== null));
}

function candleInterval(timeframe) {
  return ({ "15m": "15m", "1h": "1h", "4h": "4h", daily: "1d", weekly: "1w" })[timeframe] || timeframe;
}

async function loadCandles(symbol, timeframe, signal) {
  const key = `${symbol}|${timeframe}`;
  const cached = candlesCache.get(key);
  if (cacheFresh(cached, 30_000)) return cached.value;
  const interval = candleInterval(timeframe);
  const payload = await fetchJson(`/api/market/candles?symbol=${encodeURIComponent(symbol)}&timeframe=${encodeURIComponent(timeframe)}&interval=${encodeURIComponent(interval)}&limit=100`, { signal, timeout: 20_000 });
  const value = normalizeCandles(payload);
  if (!value.length) throw new Error("EMPTY_CANDLE_PAYLOAD");
  candlesCache.set(key, { time: Date.now(), value });
  return value;
}

function useCandles(symbol, timeframe) {
  const [state, setState] = useState({ status: "loading", value: [], error: null });
  const [revision, setRevision] = useState(0);
  const retry = useCallback(() => setRevision((value) => value + 1), []);
  useEffect(() => {
    const controller = new AbortController();
    setState((current) => ({ ...current, status: "loading", error: null }));
    loadCandles(symbol, timeframe, controller.signal)
      .then((value) => setState({ status: "ready", value, error: null }))
      .catch((error) => {
        if (error.name !== "AbortError") setState({ status: "error", value: [], error });
      });
    return () => controller.abort();
  }, [symbol, timeframe, revision]);
  return { ...state, retry };
}

async function mapWithConcurrency(items, limit, mapper) {
  const results = new Array(items.length);
  let index = 0;
  async function worker() {
    while (index < items.length) {
      const current = index++;
      try {
        results[current] = { status: "fulfilled", value: await mapper(items[current], current) };
      } catch (reason) {
        results[current] = { status: "rejected", reason };
      }
    }
  }
  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
  return results;
}

function useMarketUniverse(timeframe) {
  const [state, setState] = useState({ status: "loading", rows: [], error: null });
  const [revision, setRevision] = useState(0);
  const retry = useCallback(() => setRevision((value) => value + 1), []);
  useEffect(() => {
    const controller = new AbortController();
    setState((current) => ({ ...current, status: "loading", error: null }));
    mapWithConcurrency(ASSETS, 4, async (asset) => ({
      ...asset,
      quality: await loadQuality(asset.symbol, timeframe, controller.signal)
    }))
      .then((results) => {
        const rows = results.map((result, index) => result.status === "fulfilled"
          ? result.value
          : { ...ASSETS[index], quality: null, error: result.reason });
        setState({ status: "ready", rows, error: null });
      })
      .catch((error) => {
        if (error.name !== "AbortError") setState({ status: "error", rows: [], error });
      });
    return () => controller.abort();
  }, [timeframe, revision]);
  return { ...state, retry };
}

function useCompletedDecisions() {
  const [state, setState] = useState({ status: "loading", rows: [], error: null });
  const [revision, setRevision] = useState(0);
  const retry = useCallback(() => setRevision((value) => value + 1), []);
  useEffect(() => {
    const controller = new AbortController();
    setState({ status: "loading", rows: [], error: null });
    fetchJson("/api/completed-decisions", { signal: controller.signal, timeout: 20_000 })
      .then((payload) => {
        const rows = Array.isArray(payload) ? payload : payload?.items || payload?.decisions || [];
        setState({ status: "ready", rows, error: null });
      })
      .catch((error) => {
        if (error.name !== "AbortError") {
          setState({ status: error.status === 401 ? "auth" : "error", rows: [], error });
        }
      });
    return () => controller.abort();
  }, [revision]);
  return { ...state, retry };
}

function useAccessState() {
  const [state, setState] = useState({
    status: "loading",
    authenticated: null,
    entitlement: null,
    trial: null,
    registration: null,
    error: null
  });
  useEffect(() => {
    const controller = new AbortController();
    Promise.allSettled([
      fetchJson("/api/entitlements/me", { signal: controller.signal }),
      fetchJson("/api/trial/status", { signal: controller.signal })
    ]).then(([entitlementResult, trialResult]) => {
      const entitlement = entitlementResult.status === "fulfilled" ? entitlementResult.value : null;
      const trialPayload = trialResult.status === "fulfilled" ? trialResult.value : null;
      const authError = entitlementResult.status === "rejected" ? entitlementResult.reason : null;
      setState({
        status: "ready",
        authenticated: entitlement ? true : authError?.status === 401 ? false : null,
        entitlement,
        trial: entitlement?.trial || entitlement?.subscription?.trial || null,
        registration: trialPayload?.seat_control || trialPayload?.trial || null,
        error: authError && authError.status !== 401 ? authError : null
      });
    });
    return () => controller.abort();
  }, []);
  return state;
}

function useNewsEvents(symbol, lang) {
  const [state, setState] = useState({
    status: "loading",
    news: [],
    events: []
  });

  useEffect(() => {
    const controller = new AbortController();
    const locale = lang === "ar" ? "ar-SA" : "en-US";

    const newsQuery = new URLSearchParams({
      symbol,
      limit: "8",
      lang,
      language: lang,
      locale,
      translated: "true"
    });

    const eventsQuery = new URLSearchParams({
      limit: "8",
      lang,
      language: lang,
      locale,
      translated: "true"
    });

    Promise.allSettled([
      fetchJson(`/api/news?${newsQuery.toString()}`, {
        signal: controller.signal
      }),
      fetchJson(`/api/events?${eventsQuery.toString()}`, {
        signal: controller.signal
      })
    ]).then(([newsResult, eventsResult]) => {
      const newsPayload =
        newsResult.status === "fulfilled"
          ? newsResult.value
          : null;

      const eventsPayload =
        eventsResult.status === "fulfilled"
          ? eventsResult.value
          : null;

      setState({
        status: "ready",
        news: Array.isArray(newsPayload)
          ? newsPayload
          : newsPayload?.items || newsPayload?.news || [],
        events: Array.isArray(eventsPayload)
          ? eventsPayload
          : eventsPayload?.items || eventsPayload?.events || []
      });
    });

    return () => controller.abort();
  }, [symbol, lang]);

  return state;
}

function stateKey(value) {
  const code = String(value || "").toUpperCase();
  if (code.includes("EXECUTED") || code === "COMPLETE") return "executed";
  if (code.includes("ARMED")) return "armed";
  if (code.includes("ALLOWED")) return "allowed";
  if (code.includes("BLOCK")) return "blocked";
  return "underMonitoring";
}
function directionKey(value) {
  const text = String(value || "").toUpperCase();
  if (text.includes("هابط") || text.includes("NEGATIVE") || text.includes("BEAR")) return "bearish";
  if (text.includes("صاعد") || text.includes("POSITIVE") || text.includes("BULL")) return "bullish";
  return "neutral";
}
function toneFromNumber(value) {
  const number = numeric(value);
  if (number === null) return "muted";
  return number >= 0 ? "success" : "danger";
}

function riskLevel(quality) {
  if (!quality) return { key: "high", tone: "danger" };
  if ((quality.blockers?.count || 0) >= 2) {
    return { key: "high", tone: "danger" };
  }
  if ((quality.blockers?.count || 0) === 1) {
    return { key: "medium", tone: "warning" };
  }
  return { key: "low", tone: "success" };
}

function translateStateToken(value, t, lang) {
  const key = stateKey(value);
  const labels = {
    ar: {
      blocked: "غير مكتمل",
      allowed: "مسموح",
      armed: "جاهز للتأكيد",
      executed: "مكتمل",
      underMonitoring: "تحت المتابعة"
    },
    en: {
      blocked: "Blocked",
      allowed: "Allowed",
      armed: "Armed",
      executed: "Executed",
      underMonitoring: "Under Monitoring"
    }
  };
  return labels[lang]?.[key] || t(key);
}

function translateNmpStatus(value, lang, t) {
  const code = String(value || "").trim().toUpperCase();
  if (!code) return t("unavailable");
  if (code === "AVAILABLE") {
    return lang === "ar" ? "متاحة" : "Available";
  }
  if (code === "UNAVAILABLE") {
    return lang === "ar" ? "غير متاحة" : "Unavailable";
  }
  return value;
}

function sanitizeUserFacingText(value, lang, fallback = "") {
  let text = String(value || "").trim();

  if (!text) return fallback;

  text = text
    .replace(/بيانات\s+البيانات/gu, "البيانات")
    .replace(/الحاكمة\s+الحاكمة/gu, "الحاكمة")
    .replace(/المؤسسية/gu, "")
    .replace(/[A-Z][A-Z0-9_]{3,}/g, "")
    .replace(/inputs_incomplete/gi, "")
    .replace(/\s+/g, " ")
    .trim();

  for (let index = 0; index < 3; index += 1) {
    text = text.replace(
      /(^|\s)([^\s،؛,.!?]+)(?:\s+\2)+(?=\s|$)/giu,
      "$1$2"
    );
  }

  text = text
    .replace(/\s+([،؛,.!?])/g, "$1")
    .replace(/\s+/g, " ")
    .trim();

  return text || fallback;
}

function goldenStatusLabel(value, lang, t) {
  const code = String(value || "").trim().toUpperCase();

  if (
    code.includes("INCOMPLETE") ||
    code.includes("PENDING") ||
    code.includes("MONITOR")
  ) {
    return t("underMonitoring");
  }

  if (
    code.includes("COMPLETE") ||
    code.includes("AVAILABLE") ||
    code.includes("ACTIVE")
  ) {
    return lang === "ar" ? "متاحة" : "Available";
  }

  return sanitizeUserFacingText(
    value,
    lang,
    t("underMonitoring")
  );
}

function goldenPublicSummary(q, lang, t) {
  const fallback = lang === "ar"
    ? "الإشارة الذهبية تحت المتابعة حتى تكتمل شروطها الحاكمة."
    : "The golden signal remains under monitoring until its governing conditions are complete.";

  const raw = sanitizeUserFacingText(
    q?.golden?.summary,
    lang,
    fallback
  );

  if (
    /بيانات\s+البيانات|الحاكمة\s+الحاكمة|المؤسسية|[A-Z][A-Z0-9_]{3,}/u.test(
      String(q?.golden?.summary || "")
    )
  ) {
    return fallback;
  }

  return raw;
}

function enhancedGoldenPublicText(q, lang) {
  const active = Boolean(
    q?.raw?.enhanced_golden_alignment_active
  );

  return active
    ? (
        lang === "ar"
          ? "الإشارة الذهبية المعززة مكتملة وفق المدخلات الحاكمة المتاحة."
          : "The enhanced golden signal is complete under the available governing inputs."
      )
    : (
        lang === "ar"
          ? "الإشارة الذهبية المعززة تحت المتابعة حتى تكتمل شروطها الحاكمة."
          : "The enhanced golden signal remains under monitoring until its governing conditions are complete."
      );
}

function publicNmpNote(q, lang) {
  const available =
    numeric(q?.nmp?.level) !== null ||
    numeric(q?.nmp?.rangeLow) !== null ||
    numeric(q?.nmp?.rangeHigh) !== null ||
    String(q?.nmp?.status || "").toUpperCase() === "AVAILABLE";

  return available
    ? (
        lang === "ar"
          ? "مستوى NMP متاح لهذه القراءة ويعرض كمرجع تفسيري محكوم."
          : "The NMP level is available for this reading and is shown as a governed explanatory reference."
      )
    : (
        lang === "ar"
          ? "لم يرسل المصدر الحي مستوى NMP لهذه القراءة."
          : "The live source did not return an NMP level for this reading."
      );
}

function nmpPrimaryValue(q, lang) {
  if (numeric(q?.nmp?.level) !== null) {
    return formatNumber(q.nmp.level, lang, 4);
  }

  if (
    numeric(q?.nmp?.rangeLow) !== null ||
    numeric(q?.nmp?.rangeHigh) !== null
  ) {
    return `${formatNumber(
      q?.nmp?.rangeLow,
      lang,
      4
    )} — ${formatNumber(
      q?.nmp?.rangeHigh,
      lang,
      4
    )}`;
  }

  return "—";
}

function horizonProfile(q, state, lang) {
  const timeframe = String(
    state?.timeframe ||
    q?.instrument?.timeframe ||
    ""
  ).toLowerCase();

  const raw = String(
    q?.scenario?.timeHorizon ||
    ""
  ).trim();

  const scope = ["daily", "weekly"].includes(timeframe)
    ? (lang === "ar" ? "ممتد" : "Extended")
    : ["15m", "1h", "4h"].includes(timeframe)
      ? (lang === "ar" ? "ضيق" : "Narrow")
      : (lang === "ar" ? "غير محدد" : "Unspecified");

  const exposure =
    /اختراق|كسر|break|breakout|explicit|مكشوف/i.test(raw)
      ? (lang === "ar" ? "على المكشوف" : "Explicit")
      : (lang === "ar" ? "غير صريح" : "Implicit");

  return {
    scope,
    exposure,
    note:
      raw ||
      (
        lang === "ar"
          ? "لم يرسل المصدر وصفًا إضافيًا للأفق."
          : "The source did not return an additional horizon description."
      )
  };
}



function HorizonContext({ q, state, lang, compact = false }) {
  const profile = horizonProfile(q, state, lang);

  return (
    <div className={`horizon-context ${compact ? "compact" : ""}`}>
      <Badge tone="muted">
        {lang === "ar"
          ? `نوع الأفق: ${profile.scope}`
          : `Horizon type: ${profile.scope}`}
      </Badge>

      <Badge tone="muted">
        {lang === "ar"
          ? `حالة الأفق: ${profile.exposure}`
          : `Horizon state: ${profile.exposure}`}
      </Badge>

      {!compact ? <small>{profile.note}</small> : null}
    </div>
  );
}

function sourceMetricValue(value, lang, digits = 2) {
  return numeric(value) === null
    ? (lang === "ar" ? "غير متاح من المصدر الحي" : "Unavailable from live source")
    : formatNumber(value, lang, digits);
}

function isCompletedDecision(row) {
  const code = String(resolveCompletedState(row) || "")
    .trim()
    .toUpperCase();

  return ["COMPLETE", "COMPLETED", "EXECUTED"].includes(code);
}

function blockerReasonLabel(code, lang) {
  const value = String(code || "").trim().toUpperCase();

  const labels = {
    GOLDEN_GOVERNING_INPUTS_INCOMPLETE: {
      ar: "مدخلات الإشارة الذهبية الحاكمة غير مكتملة.",
      en: "Golden-signal governing inputs are incomplete."
    },
    TDL_ALIGNMENT_INCOMPLETE: {
      ar: "محاذاة TDL غير مكتملة.",
      en: "TDL alignment is incomplete."
    },
    CONFIRMATION_INCOMPLETE: {
      ar: "شروط التأكيد غير مكتملة.",
      en: "Confirmation conditions are incomplete."
    },
    NMP_UNAVAILABLE: {
      ar: "مستوى NMP غير متاح من المصدر الحي لهذه القراءة.",
      en: "The NMP level is unavailable from the live source for this reading."
    },
    MOMENTUM_INCOMPLETE: {
      ar: "معطيات الزخم غير مكتملة.",
      en: "Momentum inputs are incomplete."
    },
    MACRO_FILTER_INCOMPLETE: {
      ar: "مرشح السياق الكلي غير مكتمل.",
      en: "The macro context filter is incomplete."
    },
    USD_MACRO_INCOMPLETE: {
      ar: "قراءة ضغط الدولار غير مكتملة.",
      en: "The USD-pressure reading is incomplete."
    }
  };

  return labels[value]?.[lang] || (
    lang === "ar"
      ? "شرط حاكم لم يرسل المصدر اسمه التفصيلي."
      : "The source did not return the detailed name of this governing condition."
  );
}

function blockerReasonList(q, lang) {
  const declaredCount = Math.max(
    0,
    numeric(q?.blockers?.count) || 0
  );

  const reasons = [];
  const push = (reason) => {
    if (reason && !reasons.includes(reason)) {
      reasons.push(reason);
    }
  };

  const codes = Array.isArray(q?.blockers?.codes)
    ? q.blockers.codes.filter(Boolean)
    : [];

  codes.forEach((code) => {
    push(blockerReasonLabel(code, lang));
  });

  const goldenCode = String(
    q?.golden?.status || ""
  ).toUpperCase();

  if (
    declaredCount > 0 &&
    (
      goldenCode.includes("INCOMPLETE") ||
      goldenCode.includes("PENDING")
    )
  ) {
    push(
      lang === "ar"
        ? "مدخلات الإشارة الذهبية الحاكمة غير مكتملة."
        : "Golden-signal governing inputs are incomplete."
    );
  }

  if (
    declaredCount > 0 &&
    String(q?.nmp?.status || "").toUpperCase() === "UNAVAILABLE"
  ) {
    push(
      lang === "ar"
        ? "مستوى NMP غير متاح من المصدر الحي لهذه القراءة."
        : "The NMP level is unavailable from the live source for this reading."
    );
  }

  if (
    declaredCount > 0 &&
    numeric(q?.confirmationScore) !== null &&
    numeric(q?.confirmationScore) < 100
  ) {
    push(
      lang === "ar"
        ? "شروط التأكيد لم تصل إلى الاكتمال."
        : "Confirmation conditions have not reached completion."
    );
  }

  while (reasons.length < declaredCount) {
    push(
      lang === "ar"
        ? `شرط حاكم رقم ${reasons.length + 1} لم يرسل المصدر اسمه التفصيلي.`
        : `The source did not return the detailed name of governing condition ${reasons.length + 1}.`
    );
  }

  if (!reasons.length) {
    push(
      lang === "ar"
        ? "لا توجد أسباب عدم اكتمال معلنة."
        : "No incompletion reasons were reported."
    );
  }

  return reasons;
}

function pickFirstValue(item, keys) {
  for (const key of keys) {
    const value = item?.[key];
    if (
      value !== undefined &&
      value !== null &&
      String(value).trim() !== ""
    ) {
      return value;
    }
  }
  return "";
}

function localizedNewsTitle(item, lang) {
  if (lang === "ar") {
    return pickFirstValue(item, [
      "title_ar",
      "titleAr",
      "arabic_title",
      "ar_title",
      "translated_title_ar",
      "translatedTitleAr",
      "localized_title_ar",
      "summary_ar",
      "name_ar"
    ]) || pickFirstValue(item?.translations?.ar || {}, [
      "title",
      "name",
      "summary"
    ]);
  }

  return pickFirstValue(item, [
    "title_en",
    "titleEn",
    "english_title",
    "en_title",
    "translated_title_en",
    "translatedTitleEn",
    "localized_title_en",
    "name_en",
    "title",
    "name"
  ]);
}

function localizedNewsMeta(item, lang) {
  if (lang === "ar") {
    return pickFirstValue(item, [
      "source_ar",
      "sourceAr",
      "arabic_source",
      "country_ar",
      "category_ar",
      "source",
      "country",
      "category"
    ]);
  }

  return pickFirstValue(item, [
    "source_en",
    "sourceEn",
    "english_source",
    "country_en",
    "category_en",
    "source",
    "country",
    "category"
  ]);
}

function hasLocalizedNewsText(item, lang) {
  return Boolean(localizedNewsTitle(item, lang));
}

function resolveCompletedAsset(row, lang) {
  if (lang === "ar") {
    return (
      row?.asset_name_ar ||
      row?.asset_name ||
      row?.name_ar ||
      row?.name ||
      row?.symbol ||
      row?.asset_id ||
      "—"
    );
  }

  return (
    row?.asset_name_en ||
    row?.asset_name ||
    row?.name_en ||
    row?.name ||
    row?.symbol ||
    row?.asset_id ||
    "—"
  );
}

function resolveCompletedState(row) {
  return (
    row?.decision_status ||
    row?.decision_state ||
    row?.scenario_state ||
    row?.state ||
    row?.status ||
    row?.quality?.scenario?.state ||
    row?.allowed_public_outputs?.scenario_state ||
    null
  );
}

function completedTimeframeInfo(row, fallbackTimeframe) {
  const direct =
    row?.timeframe ||
    row?.instrument?.timeframe ||
    row?.quality?.instrument?.timeframe ||
    row?.reading_timeframe ||
    null;

  if (direct) {
    return {
      value: direct,
      inherited: false
    };
  }

  const horizon =
    row?.follow_up_horizon ||
    row?.reading_horizon ||
    row?.scenario?.time_horizon ||
    null;

  if (horizon) {
    return {
      value: horizon,
      inherited: false
    };
  }

  return {
    value: fallbackTimeframe || "—",
    inherited: Boolean(fallbackTimeframe)
  };
}

function eventLabel(value, lang) {
  const labels = {
    stateChange: {
      ar: "تغير الحالة",
      en: "State change"
    },
    activation: {
      ar: "التفعيل",
      en: "Activation"
    },
    stale: {
      ar: "تقادم البيانات",
      en: "Stale data"
    }
  };

  return labels[value]?.[lang] || value;
}

function normalizeAlertStore(raw) {
  if (Array.isArray(raw)) {
    return {
      rules: raw.map((rule) => ({
        ...rule,
        channels: {
          email: Boolean(rule?.channels?.email),
          telegram: Boolean(rule?.channels?.telegram)
        }
      })),
      channels: {
        email: "",
        emailEnabled: false,
        telegramBotToken: "",
        telegramChatId: "",
        telegramEnabled: false
      }
    };
  }

  return {
    rules: Array.isArray(raw?.rules)
      ? raw.rules.map((rule) => ({
          ...rule,
          channels: {
            email: Boolean(rule?.channels?.email),
            telegram: Boolean(rule?.channels?.telegram)
          }
        }))
      : [],
    channels: {
      email: raw?.channels?.email || "",
      emailEnabled: Boolean(raw?.channels?.emailEnabled),
      telegramBotToken: raw?.channels?.telegramBotToken || "",
      telegramChatId: raw?.channels?.telegramChatId || "",
      telegramEnabled: Boolean(raw?.channels?.telegramEnabled)
    }
  };
}

async function submitSupportTicket(payload) {
  const endpoints = [
    "/api/support/tickets",
    "/api/support"
  ];

  let lastError = null;

  for (const endpoint of endpoints) {
    try {
      const response = await fetch(endpoint, {
        method: "POST",
        cache: "no-store",
        credentials: "same-origin",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json"
        },
        body: JSON.stringify(payload)
      });

      const contentType =
        response.headers.get("content-type") || "";

      const body = contentType.includes("json")
        ? await response.json()
        : await response.text();

      if (response.ok) {
        return {
          endpoint,
          body
        };
      }

      if (
        response.status !== 404 &&
        response.status !== 405
      ) {
        const error = new Error(
          `HTTP_${response.status}`
        );
        error.status = response.status;
        error.body = body;
        throw error;
      }

      lastError = new Error(
        `HTTP_${response.status}`
      );
    } catch (error) {
      lastError = error;
      if (
        error?.status !== 404 &&
        error?.status !== 405
      ) {
        break;
      }
    }
  }

  throw lastError || new Error(
    "SUPPORT_ENDPOINT_UNAVAILABLE"
  );
}

function Icon({ name, size = 20 }) {
  const glyphs = {
    menu: "☰", close: "×", globe: "◎", bell: "◉", chart: "⌁", arrow: "←",
    refresh: "↻", fullscreen: "⛶", search: "⌕", plus: "+", trash: "⌫",
    warning: "!", lock: "◈", info: "i", home: "⌂", check: "✓", user: "◌"
  };
  return <span className="icon" style={{ fontSize: size }} aria-hidden="true">{glyphs[name] || "•"}</span>;
}

function Badge({ children, tone = "muted" }) {
  return <span className={`badge ${tone}`}>{children}</span>;
}
function Metric({ label, value, hint, tone = "muted" }) {
  return <div className={`metric ${tone}`}><span>{label}</span><strong>{value ?? "—"}</strong>{hint ? <small>{hint}</small> : null}</div>;
}
function Card({ title, subtitle, actions, children, className = "", id }) {
  return <section id={id} className={`card ${className}`.trim()}>
    {(title || actions) ? <div className="card-head"><div>{title ? <h2>{title}</h2> : null}{subtitle ? <p>{subtitle}</p> : null}</div>{actions}</div> : null}
    <div className="card-body">{children}</div>
  </section>;
}
function PageHeader({ title, subtitle, actions }) {
  return <div className="page-head"><div><h1>{title}</h1>{subtitle ? <p>{subtitle}</p> : null}</div>{actions}</div>;
}
function EmptyState({ type = "empty", message, onRetry }) {
  const { t } = useTranslate();
  return <div className={`empty-state ${type}`}><Icon name={type === "error" ? "warning" : type === "loading" ? "refresh" : "info"} size={32}/><strong>{message || t(type)}</strong>{onRetry ? <button className="button secondary" onClick={onRetry}>{t("retry")}</button> : null}</div>;
}
function DataMeta({ updatedAt }) {
  const { t, lang } = useTranslate();
  return <div className="data-meta"><Badge tone="success">{t("live")}</Badge><span>{t("lastUpdated")}: {formatDate(updatedAt, lang)}</span></div>;
}

function Radar({ values, labels }) {
  const safeValues = values.map((value) => Math.max(0, Math.min(100, numeric(value) ?? 0)));
  const displayValues = safeValues.map((value) => Math.round(value));
  const count = safeValues.length;
  const point = (index, percentage = 100) => {
    const angle = -Math.PI / 2 + index * Math.PI * 2 / count;
    const radius = 92 * percentage / 100;
    return [130 + Math.cos(angle) * radius, 130 + Math.sin(angle) * radius];
  };
  const polygon = safeValues.map((value, index) => point(index, value).join(",")).join(" ");
  return <div className="radar-wrap">
    <svg viewBox="0 0 260 260" role="img" aria-label={labels.join(", ")}>
      {[25, 50, 75, 100].map((ring) => <polygon key={ring} points={safeValues.map((_, index) => point(index, ring).join(",")).join(" ")} className="radar-ring" />)}
      {safeValues.map((_, index) => <line key={index} x1="130" y1="130" x2={point(index)[0]} y2={point(index)[1]} className="radar-axis" />)}
      <polygon points={polygon} className="radar-value" />
      {safeValues.map((value, index) => <circle key={index} cx={point(index, value)[0]} cy={point(index, value)[1]} r="3" className="radar-dot" />)}
    </svg>
    <div className="radar-legend">{labels.map((label, index) => <span className="radar-item" key={label}><i/><em>{label}</em><b>{displayValues[index]}%</b></span>)}</div>
  </div>;
}

