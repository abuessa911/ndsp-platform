const NDSP_SOURCE_DATA_COVERAGE_VERSION = "V1_2";

const APP_BASE = (import.meta.env.BASE_URL || "/portal/").replace(/\/+$/, "");
const CONTEXT_KEYS = ["lang", "market", "symbol", "timeframe", "mode", "view", "session"];
const CONTEXT_STORAGE = "ndsp.commercial.context.v1";
const LEGAL_STORAGE = "ndsp.commercial.legal.v1";
