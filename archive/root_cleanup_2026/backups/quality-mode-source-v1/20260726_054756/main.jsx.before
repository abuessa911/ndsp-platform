function chartNumber(value) {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : null;
}

function chartTimeValue(value) {
  if (value === null || value === undefined || value === "") {
    return 0;
  }

  if (typeof value === "number") {
    return value < 10_000_000_000 ? value * 1000 : value;
  }

  const numericValue = Number(value);

  if (Number.isFinite(numericValue)) {
    return numericValue < 10_000_000_000
      ? numericValue * 1000
      : numericValue;
  }

  const parsed = Date.parse(String(value));
  return Number.isFinite(parsed) ? parsed : 0;
}

function chartTimeLabel(value, lang, includeTime = true) {
  const milliseconds = chartTimeValue(value);

  if (!milliseconds) {
    return "—";
  }

  const date = new Date(milliseconds);

  if (Number.isNaN(date.getTime())) {
    return String(value || "—");
  }

  return new Intl.DateTimeFormat(
    lang === "ar" ? "ar-SA" : "en-US",
    includeTime
      ? {
          year: "numeric",
          month: "short",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit"
        }
      : {
          year: "numeric",
          month: "short",
          day: "2-digit"
        }
  ).format(date);
}

function normalizeChartCandles(payload) {
  const candidates = [
    payload,
    payload?.candles,
    payload?.data,
    payload?.rows,
    payload?.result,
    payload?.values,
    payload?.items,
    payload?.data?.candles,
    payload?.result?.candles
  ];

  const rows = candidates.find(Array.isArray) || [];

  const normalized = rows
    .map((row, index) => {
      const open = chartNumber(
        row?.open ??
        row?.o ??
        row?.open_price
      );

      const high = chartNumber(
        row?.high ??
        row?.h ??
        row?.high_price
      );

      const low = chartNumber(
        row?.low ??
        row?.l ??
        row?.low_price
      );

      const close = chartNumber(
        row?.close ??
        row?.c ??
        row?.close_price
      );

      const volume = chartNumber(
        row?.volume ??
        row?.v ??
        row?.base_volume ??
        0
      );

      const time =
        row?.time ??
        row?.timestamp ??
        row?.datetime ??
        row?.date ??
        row?.t ??
        index;

      if (
        open === null ||
        high === null ||
        low === null ||
        close === null
      ) {
        return null;
      }

      return {
        time,
        open,
        high,
        low,
        close,
        volume: volume ?? 0
      };
    })
    .filter(Boolean)
    .sort(
      (first, second) =>
        chartTimeValue(first.time) -
        chartTimeValue(second.time)
    );

  const deduplicated = [];
  const keys = new Set();

  for (const row of normalized) {
    const key = [
      chartTimeValue(row.time),
      row.open,
      row.high,
      row.low,
      row.close
    ].join("|");

    if (keys.has(key)) {
      continue;
    }

    keys.add(key);
    deduplicated.push(row);
  }

  return deduplicated;
}

function useChartCandles(symbol, timeframe, limit) {
  const [state, setState] = useState({
    status: "loading",
    value: [],
    error: null,
    endpoint: null
  });

  const [revision, setRevision] = useState(0);

  const retry = () =>
    setRevision((value) => value + 1);

  useEffect(() => {
    const controller = new AbortController();
    let active = true;

    setState({
      status: "loading",
      value: [],
      error: null,
      endpoint: null
    });

    const query = new URLSearchParams({
      symbol: String(symbol || "").trim().toUpperCase(),
      timeframe: String(timeframe || "").trim(),
      interval: String(timeframe || "").trim(),
      limit: String(limit)
    }).toString();

    const endpoints = [
      `/api/market/candles?${query}`,
      `/api/market-data/candles?${query}`,
      `/api/ohlcv?${query}`,
      `/api/candles?${query}`,
      `/api/market/ohlcv?${query}`,
      `/api/technical/candles?${query}`
    ];

    const run = async () => {
      const failures = [];

      for (const endpoint of endpoints) {
        try {
          const payload = await fetchJson(
            endpoint,
            {
              signal: controller.signal,
              timeout: 20_000
            }
          );

          const rows = normalizeChartCandles(payload);

          if (!rows.length) {
            failures.push(`${endpoint}:EMPTY`);
            continue;
          }

          if (!active) {
            return;
          }

          setState({
            status: "ready",
            value: rows,
            error: null,
            endpoint
          });

          return;
        } catch (error) {
          failures.push(
            `${endpoint}:${error?.message || "FAILED"}`
          );
        }
      }

      if (!active) {
        return;
      }

      setState({
        status: "error",
        value: [],
        error: failures.join(" | "),
        endpoint: null
      });
    };

    run();

    return () => {
      active = false;
      controller.abort();
    };
  }, [symbol, timeframe, limit, revision]);

  return {
    ...state,
    retry
  };
}

function calculateRsi(candles, period = 14) {
  const result = Array(candles.length).fill(null);

  if (candles.length <= period) {
    return result;
  }

  let averageGain = 0;
  let averageLoss = 0;

  for (let index = 1; index <= period; index += 1) {
    const change =
      candles[index].close -
      candles[index - 1].close;

    averageGain += Math.max(change, 0);
    averageLoss += Math.max(-change, 0);
  }

  averageGain /= period;
  averageLoss /= period;

  const firstRs =
    averageLoss === 0
      ? Infinity
      : averageGain / averageLoss;

  result[period] =
    averageLoss === 0
      ? 100
      : 100 - 100 / (1 + firstRs);

  for (
    let index = period + 1;
    index < candles.length;
    index += 1
  ) {
    const change =
      candles[index].close -
      candles[index - 1].close;

    const gain = Math.max(change, 0);
    const loss = Math.max(-change, 0);

    averageGain =
      (
        averageGain *
        (period - 1) +
        gain
      ) /
      period;

    averageLoss =
      (
        averageLoss *
        (period - 1) +
        loss
      ) /
      period;

    result[index] =
      averageLoss === 0
        ? 100
        : 100 -
          100 /
          (
            1 +
            averageGain /
            averageLoss
          );
  }

  return result;
}

function calculateEma(values, period) {
  const result = Array(values.length).fill(null);
  const multiplier = 2 / (period + 1);

  let previous = null;

  values.forEach((value, index) => {
    const numericValue = chartNumber(value);

    if (numericValue === null) {
      return;
    }

    previous =
      previous === null
        ? numericValue
        : numericValue *
          multiplier +
          previous *
          (1 - multiplier);

    result[index] = previous;
  });

  return result;
}

function calculateMacdHistogram(candles) {
  const closes = candles.map((row) => row.close);
  const fast = calculateEma(closes, 12);
  const slow = calculateEma(closes, 26);

  const macd = closes.map((_, index) => {
    if (
      fast[index] === null ||
      slow[index] === null
    ) {
      return null;
    }

    return fast[index] - slow[index];
  });

  const signal = calculateEma(macd, 9);

  return macd.map((value, index) => {
    if (
      value === null ||
      signal[index] === null
    ) {
      return null;
    }

    return value - signal[index];
  });
}

function calculateObv(candles) {
  const result = Array(candles.length).fill(null);

  if (!candles.length) {
    return result;
  }

  let value = 0;
  result[0] = value;

  for (
    let index = 1;
    index < candles.length;
    index += 1
  ) {
    if (
      candles[index].close >
      candles[index - 1].close
    ) {
      value += candles[index].volume || 0;
    } else if (
      candles[index].close <
      candles[index - 1].close
    ) {
      value -= candles[index].volume || 0;
    }

    result[index] = value;
  }

  return result;
}

function calculateCci(candles, period = 20) {
  const result = Array(candles.length).fill(null);

  const typicalPrices = candles.map(
    (row) =>
      (
        row.high +
        row.low +
        row.close
      ) /
      3
  );

  for (
    let index = period - 1;
    index < candles.length;
    index += 1
  ) {
    const window = typicalPrices.slice(
      index - period + 1,
      index + 1
    );

    const average =
      window.reduce(
        (sum, value) => sum + value,
        0
      ) /
      period;

    const meanDeviation =
      window.reduce(
        (sum, value) =>
          sum +
          Math.abs(value - average),
        0
      ) /
      period;

    result[index] =
      meanDeviation === 0
        ? 0
        : (
            typicalPrices[index] -
            average
          ) /
          (
            0.015 *
            meanDeviation
          );
  }

  return result;
}

function chartIndicatorSeries(candles) {
  return {
    rsi: calculateRsi(candles),
    macd: calculateMacdHistogram(candles),
    obv: calculateObv(candles),
    cci: calculateCci(candles)
  };
}

function IndicatorPanel({
  id,
  label,
  values,
  start,
  end,
  lang
}) {
  const width = 960;
  const height = 150;
  const box = {
    top: 18,
    right: 72,
    bottom: 24,
    left: 18
  };

  const visible = values
    .slice(start, end)
    .map((value, index) => ({
      value: chartNumber(value),
      index
    }));

  const valid = visible.filter(
    (row) => row.value !== null
  );

  if (!valid.length) {
    return (
      <div className="indicator-panel">
        <div className="indicator-panel-head">
          <strong>{label}</strong>
          <span>—</span>
        </div>
        <div className="indicator-panel-empty">
          {CHART_COPY[lang].noIndicatorData}
        </div>
      </div>
    );
  }

  let minimum = Math.min(
    ...valid.map((row) => row.value)
  );

  let maximum = Math.max(
    ...valid.map((row) => row.value)
  );

  const referenceLines = [];

  if (id === "rsi") {
    minimum = 0;
    maximum = 100;
    referenceLines.push(30, 70);
  } else if (id === "cci") {
    minimum = Math.min(minimum, -120);
    maximum = Math.max(maximum, 120);
    referenceLines.push(-100, 100);
  } else if (id === "macd") {
    const absolute = Math.max(
      Math.abs(minimum),
      Math.abs(maximum),
      0.000001
    );

    minimum = -absolute;
    maximum = absolute;
    referenceLines.push(0);
  }

  if (maximum === minimum) {
    maximum += 1;
    minimum -= 1;
  }

  const plotWidth =
    width -
    box.left -
    box.right;

  const plotHeight =
    height -
    box.top -
    box.bottom;

  const x = (index) =>
    box.left +
    index *
    plotWidth /
    Math.max(
      visible.length - 1,
      1
    );

  const y = (value) =>
    box.top +
    (
      maximum -
      value
    ) *
    plotHeight /
    (
      maximum -
      minimum
    );

  const path = valid
    .map(
      (row, index) =>
        `${index === 0 ? "M" : "L"}${x(row.index)},${y(row.value)}`
    )
    .join(" ");

  const last =
    valid[
      valid.length - 1
    ]?.value;

  return (
    <div className="indicator-panel">
      <div className="indicator-panel-head">
        <strong>{label}</strong>
        <span>
          {formatNumber(last, lang, 3)}
        </span>
      </div>

      <svg
        className="indicator-svg"
        viewBox="0 0 960 150"
        role="img"
        aria-label={label}
      >
        {[0, 0.5, 1].map((part) => (
          <line
            key={part}
            x1={box.left}
            x2={
              width -
              box.right
            }
            y1={
              box.top +
              part *
              plotHeight
            }
            y2={
              box.top +
              part *
              plotHeight
            }
            className="indicator-grid-line"
          />
        ))}

        {referenceLines.map((value) => (
          <line
            key={value}
            x1={box.left}
            x2={
              width -
              box.right
            }
            y1={y(value)}
            y2={y(value)}
            className="indicator-reference-line"
          />
        ))}

        {id === "macd"
          ? valid.map((row) => {
              const zeroY = y(0);
              const valueY = y(row.value);

              return (
                <rect
                  key={row.index}
                  x={
                    x(row.index) -
                    Math.max(
                      1,
                      plotWidth /
                      Math.max(
                        visible.length,
                        1
                      ) *
                      0.32
                    )
                  }
                  width={Math.max(
                    2,
                    plotWidth /
                    Math.max(
                      visible.length,
                      1
                    ) *
                    0.64
                  )}
                  y={Math.min(
                    zeroY,
                    valueY
                  )}
                  height={Math.max(
                    1,
                    Math.abs(
                      zeroY -
                      valueY
                    )
                  )}
                  className={
                    row.value >= 0
                      ? "indicator-bar-up"
                      : "indicator-bar-down"
                  }
                />
              );
            })
          : (
              <path
                d={path}
                className="indicator-line"
              />
            )}

        <text
          x={width - box.right + 8}
          y={box.top + 4}
          className="indicator-axis-label"
        >
          {formatNumber(maximum, lang, 2)}
        </text>

        <text
          x={width - box.right + 8}
          y={
            height -
            box.bottom
          }
          className="indicator-axis-label"
        >
          {formatNumber(minimum, lang, 2)}
        </text>
      </svg>
    </div>
  );
}

const CHART_COMPACT_SOURCE_VERSION = "V3";

function CandleChart({
  candles,
  levels,
  nmpRange,
  nmpLevel,
  lang,
  t,
  activeIndicators,
  contextKey,
  legend
}) {
  const total = candles.length;

  const initialSize = Math.min(
    80,
    Math.max(total, 20)
  );

  const [windowSize, setWindowSize] =
    useState(initialSize);

  const [windowEnd, setWindowEnd] =
    useState(total);

  const [drag, setDrag] =
    useState(null);

  const [hover, setHover] =
    useState(null);

  useEffect(() => {
    const nextSize = Math.min(
      80,
      Math.max(total, 20)
    );

    setWindowSize(nextSize);
    setWindowEnd(total);
    setDrag(null);
    setHover(null);
  }, [contextKey, total]);

  if (!total) {
    return <EmptyState/>;
  }

  const clampedSize = Math.min(
    Math.max(
      windowSize,
      Math.min(20, total)
    ),
    total
  );

  const clampedEnd = Math.min(
    Math.max(
      windowEnd,
      clampedSize
    ),
    total
  );

  const start =
    clampedEnd -
    clampedSize;

  const visible =
    candles.slice(
      start,
      clampedEnd
    );

  const chartWidth = 960;
  const chartHeight = 440;

  const box = {
    top: 30,
    right: 78,
    bottom: 46,
    left: 20
  };

  const plotWidth =
    chartWidth -
    box.left -
    box.right;

  const plotHeight =
    chartHeight -
    box.top -
    box.bottom;

  const numericRange = (
    nmpRange || []
  )
    .map(chartNumber)
    .filter(
      (value) =>
        value !== null
    );

  const nmpTopValue =
    numericRange.length === 2
      ? Math.max(...numericRange)
      : null;

  const nmpBottomValue =
    numericRange.length === 2
      ? Math.min(...numericRange)
      : null;

  const nmpValue =
    chartNumber(nmpLevel);

  const visibleBounds =
    visible
      .flatMap(
        (row) => [
          row.high,
          row.low
        ]
      )
      .concat(
        Object
          .values(levels || {})
          .map(chartNumber)
          .filter(
            (value) =>
              value !== null
          )
      )
      .concat(numericRange);

  const minimum =
    Math.min(...visibleBounds);

  const maximum =
    Math.max(...visibleBounds);

  const span =
    Math.max(
      maximum -
      minimum,
      1e-8
    );

  const low =
    minimum -
    span *
    0.08;

  const high =
    maximum +
    span *
    0.08;

  const clamp = (
    value,
    minimumValue,
    maximumValue
  ) =>
    Math.max(
      minimumValue,
      Math.min(
        value,
        maximumValue
      )
    );

  const x = (index) =>
    box.left +
    index *
    plotWidth /
    Math.max(
      visible.length - 1,
      1
    );

  const y = (value) =>
    box.top +
    (
      high -
      value
    ) *
    plotHeight /
    (
      high -
      low
    );

  const candleWidth =
    Math.max(
      3,
      plotWidth /
      Math.max(
        visible.length,
        1
      ) *
      0.58
    );

  const colors = {
    activation: "#6ccf8d",
    arrival: "#d6b35a",
    review: "#79a9ff",
    invalidation: "#ee7b7b"
  };

  const labels = {
    activation: t("activation"),
    arrival: t("arrival"),
    review: t("review"),
    invalidation: t("invalidation")
  };

  const levelEntries =
    Object
      .entries(levels || {})
      .map(([key, value]) => {
        const numericValue =
          chartNumber(value);

        if (
          numericValue === null
        ) {
          return null;
        }

        return {
          key,
          value: numericValue,
          lineY: y(numericValue)
        };
      })
      .filter(Boolean);

  const nmpY =
    nmpValue === null
      ? null
      : y(nmpValue);

  const nmpTextY =
    nmpY === null
      ? null
      : clamp(
          nmpY - 21,
          box.top + 18,
          chartHeight -
          box.bottom -
          23
        );

  const panBy = (amount) => {
    const nextEnd =
      clamp(
        clampedEnd + amount,
        clampedSize,
        total
      );

    setWindowEnd(nextEnd);
    setHover(null);
  };

  const zoomTo = (
    nextSize,
    anchorRatio = 0.5
  ) => {
    const safeSize =
      clamp(
        Math.round(nextSize),
        Math.min(20, total),
        total
      );

    const currentAnchor =
      start +
      anchorRatio *
      clampedSize;

    const nextStart =
      clamp(
        Math.round(
          currentAnchor -
          anchorRatio *
          safeSize
        ),
        0,
        total -
        safeSize
      );

    setWindowSize(safeSize);
    setWindowEnd(
      nextStart +
      safeSize
    );
    setHover(null);
  };

  const resetLatest = () => {
    const nextSize =
      Math.min(
        80,
        total
      );

    setWindowSize(nextSize);
    setWindowEnd(total);
    setHover(null);
  };

  const handleWheel = (event) => {
    event.preventDefault();

    const bounds =
      event.currentTarget
        .getBoundingClientRect();

    const ratio =
      clamp(
        (
          event.clientX -
          bounds.left
        ) /
        Math.max(
          bounds.width,
          1
        ),
        0,
        1
      );

    const factor =
      event.deltaY > 0
        ? 1.18
        : 0.84;

    zoomTo(
      clampedSize *
      factor,
      ratio
    );
  };

  const handlePointerDown = (
    event
  ) => {
    event.currentTarget
      .setPointerCapture?.(
        event.pointerId
      );

    setDrag({
      pointerId:
        event.pointerId,
      clientX:
        event.clientX,
      end:
        clampedEnd
    });
  };

  const handlePointerMove = (
    event
  ) => {
    const bounds =
      event.currentTarget
        .getBoundingClientRect();

    if (
      drag &&
      drag.pointerId ===
      event.pointerId
    ) {
      const pixelsPerCandle =
        bounds.width /
        Math.max(
          clampedSize,
          1
        );

      const shift =
        Math.round(
          (
            drag.clientX -
            event.clientX
          ) /
          Math.max(
            pixelsPerCandle,
            1
          )
        );

      setWindowEnd(
        clamp(
          drag.end + shift,
          clampedSize,
          total
        )
      );

      return;
    }

    const ratio =
      clamp(
        (
          event.clientX -
          bounds.left
        ) /
        Math.max(
          bounds.width,
          1
        ),
        0,
        1
      );

    const relativeIndex =
      clamp(
        Math.round(
          ratio *
          (
            visible.length - 1
          )
        ),
        0,
        visible.length - 1
      );

    const priceRatio =
      clamp(
        (
          event.clientY -
          bounds.top
        ) /
        Math.max(
          bounds.height,
          1
        ),
        0,
        1
      );

    setHover({
      index: relativeIndex,
      x: x(relativeIndex),
      y:
        box.top +
        priceRatio *
        plotHeight,
      price:
        high -
        priceRatio *
        (
          high -
          low
        )
    });
  };

  const stopPointer = (event) => {
    event.currentTarget
      .releasePointerCapture?.(
        event.pointerId
      );

    setDrag(null);
  };

  const hoveredCandle =
    hover
      ? visible[hover.index]
      : null;

  const indicatorSeries =
    chartIndicatorSeries(candles);

  const activePanels =
    CHART_INDICATORS.filter(
      (indicator) =>
        activeIndicators[
          indicator.id
        ]
    );

  const firstTime =
    visible[0]?.time;

  const middleTime =
    visible[
      Math.floor(
        visible.length / 2
      )
    ]?.time;

  const lastTime =
    visible[
      visible.length - 1
    ]?.time;

  return (
    <div className="interactive-chart">
      <div className="interactive-chart-controls">
        <div className="interactive-chart-buttons">
          <button
            type="button"
            className="button secondary compact-chart-button"
            onClick={() =>
              panBy(
                -Math.max(
                  1,
                  Math.floor(
                    clampedSize *
                    0.35
                  )
                )
              )
            }
            disabled={start <= 0}
          >
            {CHART_COPY[lang].older}
          </button>

          <button
            type="button"
            className="button secondary compact-chart-button"
            onClick={() =>
              panBy(
                Math.max(
                  1,
                  Math.floor(
                    clampedSize *
                    0.35
                  )
                )
              )
            }
            disabled={
              clampedEnd >= total
            }
          >
            {CHART_COPY[lang].newer}
          </button>

          <button
            type="button"
            className="button secondary compact-chart-button"
            onClick={() =>
              zoomTo(
                clampedSize *
                0.8
              )
            }
            disabled={
              clampedSize <=
              Math.min(20, total)
            }
          >
            +
          </button>

          <button
            type="button"
            className="button secondary compact-chart-button"
            onClick={() =>
              zoomTo(
                clampedSize *
                1.25
              )
            }
            disabled={
              clampedSize >= total
            }
          >
            −
          </button>

          <button
            type="button"
            className="button secondary compact-chart-button"
            onClick={resetLatest}
          >
            {CHART_COPY[lang].latest}
          </button>
        </div>

        <span className="interactive-chart-range">
          {start + 1}–{clampedEnd} / {total}
        </span>
      </div>

      <div
        className={
          `chart-scroll interactive-chart-shell ${drag ? "dragging" : ""}`
        }
        onWheel={handleWheel}
        onPointerDown={handlePointerDown}
        onPointerMove={handlePointerMove}
        onPointerUp={stopPointer}
        onPointerCancel={stopPointer}
        onPointerLeave={() => {
          if (!drag) {
            setHover(null);
          }
        }}
      >
        <svg
          className="candle-chart"
          viewBox="0 0 960 440"
          role="img"
          aria-label="Interactive candlestick chart"
        >
          {[0, 0.25, 0.5, 0.75, 1].map(
            (part) => (
              <g key={part}>
                <line
                  x1={box.left}
                  x2={
                    chartWidth -
                    box.right
                  }
                  y1={
                    box.top +
                    part *
                    plotHeight
                  }
                  y2={
                    box.top +
                    part *
                    plotHeight
                  }
                  className="chart-grid"
                />

                <text
                  x={
                    chartWidth -
                    box.right +
                    8
                  }
                  y={
                    box.top +
                    part *
                    plotHeight +
                    4
                  }
                  className="chart-axis-label"
                >
                  {formatNumber(
                    high -
                    part *
                    (
                      high -
                      low
                    ),
                    lang,
                    4
                  )}
                </text>
              </g>
            )
          )}

          {
            nmpTopValue !== null &&
            nmpBottomValue !== null
              ? (
                  <rect
                    x={box.left}
                    width={plotWidth}
                    y={y(nmpTopValue)}
                    height={Math.max(
                      2,
                      y(nmpBottomValue) -
                      y(nmpTopValue)
                    )}
                    className="nmp-zone"
                  />
                )
              : null
          }

          {
            nmpY !== null
              ? (
                  <g className="nmp-level-group">
                    <line
                      x1={box.left}
                      x2={
                        chartWidth -
                        box.right
                      }
                      y1={nmpY}
                      y2={nmpY}
                      className="nmp-line"
                    />

                    <text
                      x={box.left + 26}
                      y={nmpTextY}
                      className="nmp-label"
                      direction="ltr"
                      style={{
                        unicodeBidi:
                          "plaintext"
                      }}
                      textAnchor="start"
                    >
                      NMP
                    </text>

                    <text
                      x={box.left + 26}
                      y={
                        nmpTextY + 14
                      }
                      className="nmp-price"
                      direction="ltr"
                      style={{
                        unicodeBidi:
                          "plaintext"
                      }}
                      textAnchor="start"
                    >
                      {formatNumber(
                        nmpValue,
                        lang,
                        4
                      )}
                    </text>
                  </g>
                )
              : null
          }

          {visible.map(
            (row, index) => (
              <g
                key={
                  `${row.time}-${index}`
                }
              >
                <line
                  x1={x(index)}
                  x2={x(index)}
                  y1={y(row.high)}
                  y2={y(row.low)}
                  className={
                    row.close >=
                    row.open
                      ? "candle-up"
                      : "candle-down"
                  }
                />

                <rect
                  x={
                    x(index) -
                    candleWidth / 2
                  }
                  width={candleWidth}
                  y={Math.min(
                    y(row.open),
                    y(row.close)
                  )}
                  height={Math.max(
                    1.5,
                    Math.abs(
                      y(row.open) -
                      y(row.close)
                    )
                  )}
                  className={
                    row.close >=
                    row.open
                      ? "candle-up"
                      : "candle-down"
                  }
                />
              </g>
            )
          )}

          {levelEntries.map(
            (entry) => (
              <line
                key={entry.key}
                x1={box.left}
                x2={
                  chartWidth -
                  box.right
                }
                y1={entry.lineY}
                y2={entry.lineY}
                stroke={
                  colors[
                    entry.key
                  ]
                }
                className="level-line"
              />
            )
          )}

          {hover && hoveredCandle
            ? (
                <g className="chart-crosshair">
                  <line
                    x1={hover.x}
                    x2={hover.x}
                    y1={box.top}
                    y2={
                      chartHeight -
                      box.bottom
                    }
                    className="crosshair-line"
                  />

                  <line
                    x1={box.left}
                    x2={
                      chartWidth -
                      box.right
                    }
                    y1={hover.y}
                    y2={hover.y}
                    className="crosshair-line"
                  />

                  <rect
                    x={
                      hover.x >
                      chartWidth *
                      0.62
                        ? hover.x - 230
                        : hover.x + 10
                    }
                    y={
                      clamp(
                        hover.y - 82,
                        box.top + 4,
                        chartHeight -
                        box.bottom -
                        112
                      )
                    }
                    width="220"
                    height="108"
                    rx="9"
                    className="chart-tooltip-bg"
                  />

                  <text
                    x={
                      hover.x >
                      chartWidth *
                      0.62
                        ? hover.x - 218
                        : hover.x + 22
                    }
                    y={
                      clamp(
                        hover.y - 62,
                        box.top + 24,
                        chartHeight -
                        box.bottom -
                        92
                      )
                    }
                    className="chart-tooltip-text"
                  >
                    <tspan
                      x={
                        hover.x >
                        chartWidth *
                        0.62
                          ? hover.x - 218
                          : hover.x + 22
                      }
                      dy="0"
                    >
                      {chartTimeLabel(
                        hoveredCandle.time,
                        lang,
                        true
                      )}
                    </tspan>

                    <tspan
                      x={
                        hover.x >
                        chartWidth *
                        0.62
                          ? hover.x - 218
                          : hover.x + 22
                      }
                      dy="18"
                    >
                      O {formatNumber(
                        hoveredCandle.open,
                        lang,
                        4
                      )} · H {formatNumber(
                        hoveredCandle.high,
                        lang,
                        4
                      )}
                    </tspan>

                    <tspan
                      x={
                        hover.x >
                        chartWidth *
                        0.62
                          ? hover.x - 218
                          : hover.x + 22
                      }
                      dy="18"
                    >
                      L {formatNumber(
                        hoveredCandle.low,
                        lang,
                        4
                      )} · C {formatNumber(
                        hoveredCandle.close,
                        lang,
                        4
                      )}
                    </tspan>

                    <tspan
                      x={
                        hover.x >
                        chartWidth *
                        0.62
                          ? hover.x - 218
                          : hover.x + 22
                      }
                      dy="18"
                    >
                      V {formatNumber(
                        hoveredCandle.volume,
                        lang,
                        2
                      )}
                    </tspan>
                  </text>

                  <rect
                    x={
                      chartWidth -
                      box.right +
                      3
                    }
                    y={hover.y - 10}
                    width={69}
                    height={20}
                    rx={5}
                    className="crosshair-price-bg"
                  />

                  <text
                    x={
                      chartWidth -
                      box.right +
                      37
                    }
                    y={hover.y + 4}
                    textAnchor="middle"
                    className="crosshair-price-text"
                  >
                    {formatNumber(
                      hover.price,
                      lang,
                      4
                    )}
                  </text>
                </g>
              )
            : null}

          <text
            x={box.left}
            y={chartHeight - 14}
            className="chart-time-label"
          >
            {chartTimeLabel(
              firstTime,
              lang,
              false
            )}
          </text>

          <text
            x={
              box.left +
              plotWidth / 2
            }
            y={chartHeight - 14}
            textAnchor="middle"
            className="chart-time-label"
          >
            {chartTimeLabel(
              middleTime,
              lang,
              false
            )}
          </text>

          <text
            x={
              chartWidth -
              box.right
            }
            y={chartHeight - 14}
            textAnchor="end"
            className="chart-time-label"
          >
            {chartTimeLabel(
              lastTime,
              lang,
              false
            )}
          </text>
        </svg>
      </div>

      {legend}

      <div className="interactive-chart-hint">
        <span>
          {CHART_COPY[lang].dragHint}
        </span>
        <span>
          {CHART_COPY[lang].hoverHint}
        </span>
      </div>

      {activePanels.length
        ? (
            <div className="indicator-panels">
              {activePanels.map(
                (indicator) => (
                  <IndicatorPanel
                    key={indicator.id}
                    id={indicator.id}
                    label={indicator.label}
                    values={
                      indicatorSeries[
                        indicator.id
                      ]
                    }
                    start={start}
                    end={clampedEnd}
                    lang={lang}
                  />
                )
              )}
            </div>
          )
        : null}
    </div>
  );
}
const PRIMARY_NAV = [
  ["commandCenter", "/command-center"], ["markets", "/markets"], ["pricesChart", "/prices-chart"],
  ["opportunities", "/opportunities"], ["decisionRoom", "/decision-room"], ["portfolio", "/portfolio"]
];
const MORE_NAV = [
  ["scenarios", "/scenarios"], ["publicLayers", "/layers"], ["riskChallenge", "/risk"],
  ["completed", "/completed"], ["dataHealth", "/data-health"], ["alerts", "/alerts"],
  ["guide", "/guide"], ["support", "/support"], ["account", "/account"],
  ["plans", "/plans"], ["settings", "/settings"], ["changeContext", "/context"]
];

function querySuffix(state) {
  const params = new URLSearchParams();
  CONTEXT_KEYS.forEach((key) => params.set(key, state[key]));
  return `?${params.toString()}`;
}

function Topbar() {
  const { state, patch } = useDecision();
  const { route, navigate } = useNavigation();
  const { t, lang } = useTranslate();
  const [drawer, setDrawer] = useState(false);
  const [more, setMore] = useState(false);
  const drawerRef = useRef(null);
  const menuRef = useRef(null);

  useEffect(() => {
    if (!drawer) return undefined;
    document.body.classList.add("drawer-open");
    const previous = document.activeElement;
    drawerRef.current?.querySelector("a,button")?.focus();
    const onKey = (event) => {
      if (event.key === "Escape") setDrawer(false);
    };
    document.addEventListener("keydown", onKey);
    return () => {
      document.body.classList.remove("drawer-open");
      document.removeEventListener("keydown", onKey);
      previous?.focus?.();
    };
  }, [drawer]);

  const go = (path) => {
    navigate(path);
    setDrawer(false);
    setMore(false);
  };
  const navButton = ([key, path], mobile = false) => <button key={path} onClick={() => go(path)} className={`nav-link ${route === path ? "active" : ""} ${mobile ? "drawer-link" : ""}`}>{t(key)}</button>;

  return <>
    <header className="topbar"><div className="topbar-inner">
      <button className="brand" onClick={() => go("/command-center")} aria-label={`${t("brand")} — ${t("brandFull")}`}><span className="brand-mark">N</span><span><strong>{t("brand")}</strong><small>{t("brandFull")}</small></span></button>
      <nav className="desktop-nav" aria-label="menu">{PRIMARY_NAV.map((item) => navButton(item))}<div className="more-wrap"><button className={`nav-link nav-button ${MORE_NAV.some(([, path]) => path === route) ? "active" : ""}`} onClick={() => setMore((value) => !value)}>{t("more")} <span className="caret">⌄</span></button>{more ? <div className="dropdown" onMouseLeave={() => setMore(false)}>{MORE_NAV.map((item) => navButton(item))}</div> : null}</div></nav>
      <div className="header-actions"><Badge tone="success">{t("live")}</Badge><button className="icon-button" onClick={() => patch({ lang: lang === "ar" ? "en" : "ar" })}><Icon name="globe"/><span className="action-text">{lang === "ar" ? "English" : "العربية"}</span></button><button ref={menuRef} className="icon-button mobile-menu" onClick={() => setDrawer(true)} aria-expanded={drawer}><Icon name="menu"/></button></div>
    </div></header>
    {drawer ? <div className="drawer-layer" data-dir={state.lang === "ar" ? "rtl" : "ltr"}><button className="drawer-backdrop" onClick={() => setDrawer(false)} aria-label="close"/><aside ref={drawerRef} className="drawer" role="dialog" aria-modal="true"><div className="drawer-head"><div className="brand"><span className="brand-mark">N</span><span><strong>{t("brand")}</strong><small>{t("brandFull")}</small></span></div><button className="icon-button" onClick={() => setDrawer(false)}><Icon name="close"/></button></div><div className="drawer-trial"><span>{t("commercialNotice")}</span></div><nav className="drawer-nav">{PRIMARY_NAV.map((item) => navButton(item, true))}<div className="drawer-separator">{t("more")}</div>{MORE_NAV.map((item) => navButton(item, true))}</nav></aside></div> : null}
  </>;
}

function ContextStrip() {
  const { state, patch } = useDecision();
  const { t, lang } = useTranslate();
  const setMarket = (market) => patch({ market, symbol: ASSETS.find((asset) => asset.market === market)?.symbol || state.symbol });
  return <div className="context-shell"><div className="context-strip" data-testid="context-strip">
    <label><span>{t("market")}</span><select value={state.market} onChange={(event) => setMarket(event.target.value)}>{MARKETS.map((market) => <option value={market} key={market}>{marketLabel(market, lang)}</option>)}</select></label>
    <label><span>{t("asset")}</span><select value={state.symbol} onChange={(event) => patch({ symbol: event.target.value })}>{ASSETS.filter((asset) => asset.market === state.market).map((asset) => <option value={asset.symbol} key={asset.symbol}>{assetName(asset, lang)} · {asset.symbol}</option>)}</select></label>
    <label><span>{t("timeframe")}</span><select value={state.timeframe} onChange={(event) => patch({ timeframe: event.target.value })}>{TIMEFRAMES.map((timeframe) => <option key={timeframe}>{timeframe}</option>)}</select></label>
    <label><span>{t("readingType")}</span><select value={state.mode} onChange={(event) => patch({ mode: event.target.value })}><option value="investment">{t("investment")}</option><option value="speculative">{t("speculative")}</option></select></label>
    <label><span>{t("viewLevel")}</span><select value={state.view} onChange={(event) => patch({ view: event.target.value })}><option value="beginner">{t("beginner")}</option><option value="professional">{t("professional")}</option></select></label>
  </div></div>;
}

function LegalModal() {
  const { accepted, acceptLegal } = useDecision();
  const { t } = useTranslate();
  if (accepted) return null;
  return <div className="modal-layer"><div className="modal-backdrop"/><div className="modal" role="dialog" aria-modal="true"><div className="modal-head"><h2>{t("legalTitle")}</h2></div><div className="modal-body"><p>{t("legalBody")}</p><div className="modal-actions"><button className="button primary" onClick={acceptLegal}>{t("accept")}</button></div></div></div></div>;
}

function ContextSummary() {
  const { state } = useDecision();
  const { t, lang } = useTranslate();
  return <div className="context-summary"><Badge>{marketLabel(state.market, lang)}</Badge><Badge tone="muted">{assetName(findAsset(state.symbol), lang)}</Badge><Badge tone="muted">{state.timeframe}</Badge><Badge tone="muted">{t(state.mode)}</Badge><Badge tone="muted">{t(state.view)}</Badge></div>;
}

function qualityRadar(quality, t) {
  return {
    labels: [t("dataQuality"), "TDL", t("momentum"), "NMP", t("macro"), t("readiness")],
    values: [
      quality?.decisionQuality,
      quality?.alignmentScore,
      quality?.cciValue === null ? null : Math.min(100, Math.abs(quality.cciValue)),
      quality?.nmp?.status === "AVAILABLE" ? 100 : 0,
      quality?.usdPressureScore === null ? null : Math.max(0, 100 - Math.min(100, Math.abs(quality.usdPressureScore))),
      quality?.confirmationScore
    ]
  };
}

function CommandCenterPage() {
  const { state } = useDecision();
  const { navigate } = useNavigation();
  const { t, lang } = useTranslate();

  const quality = useQuality(
    state.symbol,
    state.timeframe
  );

  const universe = useMarketUniverse(
    state.timeframe
  );

  const completed = useCompletedDecisions();
  const newsEvents = useNewsEvents(state.symbol, lang);

  if (quality.status === "loading") {
    return <EmptyState type="loading"/>;
  }

  if (quality.status === "error") {
    return (
      <EmptyState
        type="error"
        onRetry={quality.retry}
      />
    );
  }

  const value = quality.value;
  const radar = qualityRadar(value, t);
  const watchlist = readJsonStorage(
    WATCHLIST_STORAGE,
    []
  );

  const alertStore = normalizeAlertStore(
    readJsonStorage(
      ALERTS_STORAGE,
      {}
    )
  );

  const activeAlertCount = alertStore.rules
    .filter((row) => row?.enabled)
    .length;

  const opportunities = (
    Array.isArray(universe.rows)
      ? universe.rows
      : []
  )
    .filter(
      (row) =>
        row?.quality?.decisionQuality !== null &&
        row?.quality?.decisionQuality !== undefined
    )
    .sort(
      (a, b) =>
        (b?.quality?.decisionQuality || 0) -
        (a?.quality?.decisionQuality || 0)
    )
    .slice(0, 4);

  const monitored = (
    Array.isArray(universe.rows)
      ? universe.rows
      : []
  ).filter(
    (row) =>
      row?.quality?.scenario?.state ===
      "UNDER_MONITORING"
  ).length;

  const completedCount =
    completed.status === "ready"
      ? completed.rows.length
      : null;

  return (
    <>
      <PageHeader
        title={t("commandCenter")}
        subtitle={t("marketSummary")}
        actions={<ContextSummary/>}
      />

      <div className="commercial-banner">
        <Badge tone="success">
          {t("live")}
        </Badge>
        <span>
          {t("commercialNotice")}
        </span>
      </div>

      <div className="hero-grid">
        <Card
          title={t("currentDecision")}
          subtitle={
            `${assetName(
              findAsset(state.symbol),
              lang
            )} · ${state.symbol}`
          }
          className="decision-hero"
        >
          <div className="decision-hero-row">
            <div>
              <Badge tone="warning">
                {translateStateToken(
                  value.scenario.state,
                  t,
                  lang
                )}
              </Badge>

              <h3>
                {
                  value.scenario.directionalContext ||
                  t("unavailable")
                }
              </h3>

              <HorizonContext
                q={value}
                state={state}
                lang={lang}
                compact
              />

              <p>
                {sanitizeUserFacingText(
                  value.scenario.riskNote,
                  lang,
                  t("partial")
                )}
              </p>
            </div>

            <div className="hero-score">
              <strong>
                {formatNumber(
                  value.decisionQuality,
                  lang,
                  0
                )}%
              </strong>
              <span>{t("strength")}</span>
            </div>
          </div>

          <div className="mini-levels">
            <span>
              {t("activation")}{" "}
              <b>
                {formatNumber(
                  value.scenario.activation,
                  lang,
                  4
                )}
              </b>
            </span>

            <span>
              {t("arrival")}{" "}
              <b>
                {formatNumber(
                  value.scenario.arrival,
                  lang,
                  4
                )}
              </b>
            </span>

            <span>
              {t("review")}{" "}
              <b>
                {formatNumber(
                  value.scenario.review,
                  lang,
                  4
                )}
              </b>
            </span>

            <span>
              {t("invalidation")}{" "}
              <b>
                {formatNumber(
                  value.scenario.invalidation,
                  lang,
                  4
                )}
              </b>
            </span>
          </div>

          <DataMeta
            updatedAt={value.generatedAt}
          />

          <div className="inline-actions">
            <button
              className="button primary"
              onClick={() =>
                navigate("/decision-room")
              }
            >
              {t("openDecision")}{" "}
              <Icon name="arrow"/>
            </button>

            <button
              className="button secondary"
              onClick={() =>
                navigate("/prices-chart")
              }
            >
              {t("openChart")}{" "}
              <Icon name="chart"/>
            </button>
          </div>
        </Card>

        <Card title={t("readingStatus")}>
          <div className="metrics-grid two">
            <Metric
              label={t("strength")}
              value={`${formatNumber(
                value.decisionQuality,
                lang,
                0
              )}%`}
              tone="gold"
            />

            <Metric
              label={t("readiness")}
              value={`${formatNumber(
                value.confirmationScore,
                lang,
                0
              )}%`}
              tone="warning"
            />

            <Metric
              label={t("dataQuality")}
              value={`${formatNumber(
                value.decisionQuality,
                lang,
                0
              )}%`}
            />

            <Metric
              label={t("sourceStatus")}
              value={t("live")}
              tone="success"
            />
          </div>
        </Card>
      </div>

      <div className="metrics-grid dashboard-metrics">
        <Metric
          label={t("completedReads")}
          value={
            completedCount === null
              ? "—"
              : completedCount
          }
        />

        <Metric
          label={t("monitoredReads")}
          value={
            universe.status === "ready"
              ? monitored
              : "—"
          }
        />

        <Metric
          label={t("trackedAssets")}
          value={
            Array.isArray(watchlist)
              ? watchlist.length
              : 0
          }
        />

        <Metric
          label={t("activeAlerts")}
          value={activeAlertCount}
        />
      </div>

      <div className="content-grid two-wide">
        <Card title={t("marketSummary")}>
          <div className="market-strip">
            {MARKETS.map((market) => {
              const rows = (
                Array.isArray(universe.rows)
                  ? universe.rows
                  : []
              ).filter(
                (row) =>
                  row.market === market &&
                  row.quality?.liveChangePct !== null
              );

              const average = rows.length
                ? rows.reduce(
                    (sum, row) =>
                      sum +
                      row.quality.liveChangePct,
                    0
                  ) / rows.length
                : null;

              return (
                <button
                  key={market}
                  onClick={() =>
                    navigate("/markets")
                  }
                >
                  <span>
                    {marketLabel(
                      market,
                      lang
                    )}
                  </span>

                  <strong
                    className={
                      toneFromNumber(average) ===
                      "success"
                        ? "up"
                        : average === null
                          ? ""
                          : "down"
                    }
                  >
                    {
                      average === null
                        ? "—"
                        : `${average >= 0 ? "+" : ""}${formatNumber(
                            average,
                            lang,
                            2
                          )}%`
                    }
                  </strong>
                </button>
              );
            })}
          </div>

          <div className="brief-box">
            <h3>{t("dailyBrief")}</h3>
            <p>
              {sanitizeUserFacingText(
                value.raw
                  ?.allowed_public_outputs
                  ?.sanitized_summary ||
                value.scenario.riskNote,
                lang,
                t("partial")
              )}
            </p>
          </div>
        </Card>

        <Card title={t("keyRisks")}>
          <Radar
            values={radar.values}
            labels={radar.labels}
          />
        </Card>
      </div>

      <div className="content-grid two">
        <Card title={t("strongestOpportunities")}>
          <div className="list-stack">
            {
              opportunities.length
                ? opportunities.map((row) => (
                    <button
                      className="list-row"
                      key={row.symbol}
                      onClick={() =>
                        navigate("/opportunities")
                      }
                    >
                      <span>
                        <b>
                          {assetName(row, lang)}
                        </b>
                        <small>
                          {row.symbol} ·{" "}
                          {marketLabel(
                            row.market,
                            lang
                          )}
                        </small>
                      </span>

                      <Badge>
                        {formatNumber(
                          row.quality
                            .decisionQuality,
                          lang,
                          0
                        )}%
                      </Badge>
                    </button>
                  ))
                : <EmptyState/>
            }
          </div>
        </Card>

        <Card title={t("quickLinks")}>
          <div className="quick-grid">
            <button
              onClick={() =>
                navigate("/prices-chart")
              }
            >
              <Icon name="chart"/>
              <span>{t("pricesChart")}</span>
            </button>

            <button
              onClick={() =>
                navigate("/portfolio")
              }
            >
              <Icon name="user"/>
              <span>{t("portfolio")}</span>
            </button>

            <button
              onClick={() =>
                navigate("/alerts")
              }
            >
              <Icon name="bell"/>
              <span>{t("alerts")}</span>
            </button>

            <button
              onClick={() =>
                navigate("/guide")
              }
            >
              <Icon name="info"/>
              <span>{t("guide")}</span>
            </button>
          </div>
        </Card>
      </div>

      <div className="content-grid two">
        <Card title={t("news")}>
          <NewsList
            items={newsEvents.news}
            empty={t("noNews")}
            lang={lang}
          />
        </Card>

        <Card title={t("events")}>
          <NewsList
            items={newsEvents.events}
            empty={t("noEvents")}
            lang={lang}
          />
        </Card>
      </div>
    </>
  );
}

function NewsList({ items, empty, lang }) {
  if (!Array.isArray(items) || !items.length) {
    return <EmptyState message={empty}/>;
  }

  return (
    <div className="news-list">
      {items.slice(0, 8).map((item, index) => {
        const localizedTitle = localizedNewsTitle(item, lang);

        const originalTitle = pickFirstValue(item, [
          "title",
          "name",
          "headline",
          "event_title",
          "eventTitle",
          "event_name",
          "eventName",
          "summary"
        ]);

        const originalLooksArabic =
          /[\u0600-\u06FF]/.test(
            String(originalTitle || "")
          );

        const localizedForDisplay =
          Boolean(localizedTitle) ||
          (
            lang === "ar" &&
            originalLooksArabic
          );

        const displayTitle =
          localizedTitle ||
          originalTitle ||
          (
            lang === "ar"
              ? "عنوان غير متاح"
              : "Title unavailable"
          );

        const meta = localizedNewsMeta(
          item,
          lang
        );

        const timestamp = formatDate(
          item?.time ||
          item?.date ||
          item?.datetime,
          lang
        );

        return (
          <article
            key={
              `${
                item?.url ||
                item?.title ||
                item?.name ||
                item?.headline ||
                "item"
              }-${index}`
            }
          >
            <div>
              <strong
                className={
                  lang === "ar" &&
                  !localizedForDisplay
                    ? "news-title-original"
                    : ""
                }
                dir={
                  lang === "ar" &&
                  !localizedForDisplay
                    ? "ltr"
                    : undefined
                }
              >
                {displayTitle}
              </strong>

              <small>
                {meta ? `${meta} · ` : ""}
                {timestamp}
              </small>

              {
                lang === "ar" &&
                !localizedForDisplay
                  ? (
                      <span className="news-language-badge">
                        العنوان الأصلي · الترجمة العربية غير متاحة
                      </span>
                    )
                  : null
              }
            </div>

            {
              item?.url
                ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={
                        lang === "ar"
                          ? "فتح المصدر"
                          : "Open source"
                      }
                    >
                      ↗
                    </a>
                  )
                : null
            }
          </article>
        );
      })}
    </div>
  );
}

function MarketsPage() {
  const { state, patch } = useDecision();
  const { navigate } = useNavigation();
  const { t, lang } = useTranslate();
  const universe = useMarketUniverse(state.timeframe);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("ALL");
  const [watchlist, setWatchlist] = useState(() => readJsonStorage(WATCHLIST_STORAGE, []));
  useEffect(() => localStorage.setItem(WATCHLIST_STORAGE, JSON.stringify(watchlist)), [watchlist]);
  const rows = universe.rows.filter((row) => (filter === "ALL" || row.market === filter) && `${row.symbol} ${row.nameAr} ${row.nameEn}`.toLowerCase().includes(search.toLowerCase()));
  const open = (row, path) => { patch({ market: row.market, symbol: row.symbol }); navigate(path); };
  return <><PageHeader title={t("markets")} subtitle={t("marketSummary")} actions={<button className="button secondary" onClick={universe.retry}><Icon name="refresh"/> {t("refresh")}</button>}/><div className="toolbar"><label className="search-box"><Icon name="search"/><input value={search} onChange={(event) => setSearch(event.target.value)} placeholder={t("search")}/></label><select value={filter} onChange={(event) => setFilter(event.target.value)}><option value="ALL">{t("allMarkets")}</option>{MARKETS.map((market) => <option value={market} key={market}>{marketLabel(market, lang)}</option>)}</select></div>{universe.status === "loading" ? <EmptyState type="loading"/> : universe.status === "error" ? <EmptyState type="error" onRetry={universe.retry}/> : <div className="asset-grid">{rows.map((row) => { const q = row.quality; const watched = watchlist.includes(row.symbol); return <article className="asset-card" key={row.symbol}><div className="asset-top"><span className="asset-icon">{row.symbol.slice(0, 2)}</span><div><h2>{assetName(row, lang)}</h2><p>{row.symbol} · {marketLabel(row.market, lang)}</p></div><button className={`watch-button ${watched ? "active" : ""}`} onClick={() => setWatchlist((current) => watched ? current.filter((symbol) => symbol !== row.symbol) : [...current, row.symbol])}>★</button></div><div className="asset-price"><strong>{formatNumber(q?.instrument?.livePrice, lang, 5)}</strong><Badge tone={toneFromNumber(q?.liveChangePct)}>{q?.liveChangePct === null || q?.liveChangePct === undefined ? "—" : `${q.liveChangePct >= 0 ? "+" : ""}${formatNumber(q.liveChangePct, lang, 2)}%`}</Badge></div><DataMeta updatedAt={q?.generatedAt}/><div className="asset-actions"><button onClick={() => open(row, "/prices-chart")}>{t("openChart")}</button><button onClick={() => open(row, "/decision-room")}>{t("openDecision")}</button><button onClick={() => open(row, "/portfolio")}>{t("addPortfolio")}</button></div></article>; })}</div>}</>;
}

function PricesChartPage() {
  const { state, patch } = useDecision();
  const { t, lang } = useTranslate();

  const [fullscreen, setFullscreen] =
    useState(false);

  const [historyLimit, setHistoryLimit] =
    useState(250);

  const [activeIndicators, setActiveIndicators] =
    useState({
      rsi: true,
      macd: true,
      obv: false,
      cci: false
    });

  useEffect(() => {
    setHistoryLimit(250);
  }, [state.symbol, state.timeframe]);

  const quality =
    useQuality(
      state.symbol,
      state.timeframe
    );

  const candles =
    useChartCandles(
      state.symbol,
      state.timeframe,
      historyLimit
    );

  if (
    quality.status === "loading" ||
    candles.status === "loading"
  ) {
    return <EmptyState type="loading"/>;
  }

  if (quality.status === "error") {
    return (
      <EmptyState
        type="error"
        onRetry={quality.retry}
      />
    );
  }

  if (candles.status === "error") {
    return (
      <EmptyState
        type="error"
        onRetry={candles.retry}
      />
    );
  }

  const q = quality.value;

  const levels = {
    activation:
      q.scenario.activation,
    arrival:
      q.scenario.arrival,
    review:
      q.scenario.review,
    invalidation:
      q.scenario.invalidation
  };

  const nmp = q.nmp.level;

  const range =
    nmp === null
      ? []
      : [
          nmp * 0.998,
          nmp * 1.002
        ];

  const last =
    candles.value.at(-1);

  const toggleIndicator = (id) => {
    setActiveIndicators(
      (current) => ({
        ...current,
        [id]: !current[id]
      })
    );
  };

  const nextHistoryLimit =
    CHART_HISTORY_LIMITS.find(
      (value) =>
        value >
        historyLimit
    );

  const sourceReturnedLess =
    candles.value.length <
    historyLimit;

  const levelLegend = (
    <div className="chart-level-legend">
      {[
        ["activation", levels.activation],
        ["arrival", levels.arrival],
        ["review", levels.review],
        ["invalidation", levels.invalidation]
      ].map(([key, value]) => (
        <div
          className="chart-level-legend-item"
          key={key}
        >
          <i className={`l-${key}`}/>
          <span>{t(key)}</span>
          <b>
            {formatNumber(
              value,
              lang,
              4
            )}
          </b>
        </div>
      ))}

      <div className="chart-level-legend-item nmp-legend-item">
        <i className="l-nmp"/>
        <span>{t("nmpZone")}</span>
        <b>
          {formatNumber(
            nmp,
            lang,
            4
          )}
        </b>
      </div>
    </div>
  );

  const chart = (
    <CandleChart
      key={
        `${state.symbol}-${state.timeframe}-${historyLimit}`
      }
      candles={candles.value}
      levels={levels}
      nmpRange={range}
      nmpLevel={nmp}
      lang={lang}
      t={t}
      activeIndicators={
        activeIndicators
      }
      contextKey={
        `${state.symbol}-${state.timeframe}-${historyLimit}`
      }
      legend={levelLegend}
    />
  );

  return (
    <div className="prices-chart-page">
      <PageHeader
        title={t("chartTitle")}
        subtitle={
          `${assetName(
            findAsset(state.symbol),
            lang
          )} · ${state.symbol}`
        }
        actions={
          <div className="inline-actions">
            <button
              className="button secondary"
              onClick={() => {
                quality.retry();
                candles.retry();
              }}
            >
              <Icon name="refresh"/>
              {t("refresh")}
            </button>

            <button
              className="button secondary"
              onClick={() =>
                setFullscreen(true)
              }
            >
              <Icon name="fullscreen"/>
              {t("fullscreen")}
            </button>
          </div>
        }
      />

      <Card
        title={
          `${assetName(
            findAsset(state.symbol),
            lang
          )} · ${state.timeframe}`
        }
        actions={
          <DataMeta
            updatedAt={q.generatedAt}
          />
        }
      >
        <div className="chart-toolbar">
          <select
            value={state.symbol}
            onChange={(event) => {
              const asset =
                findAsset(
                  event.target.value
                );

              patch({
                market: asset.market,
                symbol: asset.symbol
              });
            }}
          >
            {ASSETS.map(
              (asset) => (
                <option
                  value={asset.symbol}
                  key={asset.symbol}
                >
                  {assetName(
                    asset,
                    lang
                  )} · {asset.symbol}
                </option>
              )
            )}
          </select>

          <div className="segmented chart-timeframes">
            {TIMEFRAMES.map(
              (timeframe) => (
                <button
                  type="button"
                  className={
                    state.timeframe ===
                    timeframe
                      ? "active"
                      : ""
                  }
                  onClick={() =>
                    patch({
                      timeframe
                    })
                  }
                  key={timeframe}
                >
                  {timeframe}
                </button>
              )
            )}
          </div>
        </div>

        <div className="chart-source-controls">
          <label>
            <span>
              {CHART_COPY[lang].history}
            </span>

            <select
              value={historyLimit}
              onChange={(event) =>
                setHistoryLimit(
                  Number(
                    event.target.value
                  )
                )
              }
            >
              {CHART_HISTORY_LIMITS.map(
                (value) => (
                  <option
                    value={value}
                    key={value}
                  >
                    {value}
                  </option>
                )
              )}
            </select>
          </label>

          <div className="chart-source-status">
            <strong>
              {candles.value.length}
            </strong>
            <span>
              {CHART_COPY[lang].loadedCandles}
            </span>
            <small>
              {candles.endpoint || "—"}
            </small>
          </div>

          <button
            type="button"
            className="button secondary"
            disabled={
              !nextHistoryLimit ||
              sourceReturnedLess
            }
            onClick={() => {
              if (nextHistoryLimit) {
                setHistoryLimit(
                  nextHistoryLimit
                );
              }
            }}
          >
            {CHART_COPY[lang].loadMore}
          </button>
        </div>

        <p className="chart-source-note">
          {sourceReturnedLess
            ? CHART_COPY[lang]
                .allAvailableLoaded
            : CHART_COPY[lang]
                .sourceLimit}
        </p>

        <div className="technical-toolbox">
          <strong>
            {CHART_COPY[lang].technicalTools}
          </strong>

          <div className="technical-tool-buttons">
            {CHART_INDICATORS.map(
              (indicator) => (
                <button
                  type="button"
                  key={indicator.id}
                  className={
                    activeIndicators[
                      indicator.id
                    ]
                      ? "active"
                      : ""
                  }
                  aria-pressed={
                    activeIndicators[
                      indicator.id
                    ]
                  }
                  onClick={() =>
                    toggleIndicator(
                      indicator.id
                    )
                  }
                >
                  {indicator.label}
                </button>
              )
            )}
          </div>
        </div>

        <div className="ohlc-row">
          <Metric
            label={t("open")}
            value={formatNumber(
              last?.open,
              lang,
              5
            )}
          />

          <Metric
            label={t("highPrice")}
            value={formatNumber(
              last?.high,
              lang,
              5
            )}
          />

          <Metric
            label={t("lowPrice")}
            value={formatNumber(
              last?.low,
              lang,
              5
            )}
          />

          <Metric
            label={t("closePrice")}
            value={formatNumber(
              last?.close,
              lang,
              5
            )}
            tone={
              last &&
              last.close >=
              last.open
                ? "success"
                : "danger"
            }
          />
        </div>

        {chart}
      </Card>

      <Card title={t("divergence")}>
        <div className="divergence-box">
          <Badge tone="muted">
            {q.raw?.cross_timeframe_divergence
              ? t("partial")
              : t("noDivergence")}
          </Badge>

          <p>
            {state.view === "professional"
              ? (
                  lang === "ar"
                    ? "يتم التحقق من الانحراف المنتظم والخفي على الإطار المختار دون نسخ نتائج إطار آخر."
                    : "Regular and hidden divergence are checked on the selected timeframe without copying another timeframe."
                )
              : t("noDivergence")}
          </p>
        </div>
      </Card>

      {fullscreen
        ? (
            <div className="modal-layer">
              <button
                className="modal-backdrop"
                onClick={() =>
                  setFullscreen(false)
                }
              />

              <div className="modal fullscreen-modal">
                <div className="modal-head">
                  <h2>
                    {t("chartTitle")}
                  </h2>

                  <button
                    className="icon-button"
                    onClick={() =>
                      setFullscreen(false)
                    }
                  >
                    <Icon name="close"/>
                  </button>
                </div>

                <div className="modal-body fullscreen-chart">
                  {chart}
                </div>
              </div>
            </div>
          )
        : null}
    </div>
  );
}
function OpportunitiesPage() {
  const { state, patch } = useDecision();
  const { navigate } = useNavigation();
  const { t, lang } = useTranslate();
  const universe = useMarketUniverse(state.timeframe);
  const [filter, setFilter] = useState("ALL");
  const rows = universe.rows
    .filter((row) => row.quality && (filter === "ALL" || row.market === filter))
    .sort((a, b) => (b.quality.decisionQuality || 0) - (a.quality.decisionQuality || 0));
  return <><PageHeader title={t("opportunities")} subtitle={t("explanatoryOnly")}/><div className="toolbar"><select value={filter} onChange={(event) => setFilter(event.target.value)}><option value="ALL">{t("allMarkets")}</option>{MARKETS.map((market) => <option value={market} key={market}>{marketLabel(market, lang)}</option>)}</select></div>{universe.status === "loading" ? <EmptyState type="loading"/> : <div className="table-wrap"><table><thead><tr><th>{t("asset")}</th><th>{t("market")}</th><th>{t("timeframe")}</th><th>{t("opportunityReason")}</th><th>{t("score")}</th><th>{t("readiness")}</th><th>{t("risk")}</th><th>{t("actions")}</th></tr></thead><tbody>{rows.map((row) => { const risk = riskLevel(row.quality); return <tr key={row.symbol}><td><b>{assetName(row, lang)}</b><small>{row.symbol}</small></td><td>{marketLabel(row.market, lang)}</td><td>{state.timeframe}</td><td>{row.quality.scenario.riskNote || t("partial")}</td><td><Badge>{formatNumber(row.quality.decisionQuality, lang, 0)}%</Badge></td><td>{formatNumber(row.quality.confirmationScore, lang, 0)}%</td><td><Badge tone={risk.tone}>{t(risk.key)}</Badge></td><td><button className="table-action" onClick={() => { patch({ market: row.market, symbol: row.symbol }); navigate("/decision-room"); }}>{t("view")}</button></td></tr>; })}</tbody></table></div>}</>;
}


function DecisionRoomPage() {
  const { state } = useDecision();
  const { t, lang } = useTranslate();

  const quality = useQuality(
    state.symbol,
    state.timeframe
  );

  const [alternative, setAlternative] =
    useState(false);

  if (quality.status === "loading") {
    return <EmptyState type="loading"/>;
  }

  if (quality.status === "error") {
    return (
      <EmptyState
        type="error"
        onRetry={quality.retry}
      />
    );
  }

  const q = quality.value;
  const risk = riskLevel(q);
  const horizon = horizonProfile(
    q,
    state,
    lang
  );

  const blockerReasons =
    blockerReasonList(q, lang);

  const governingStages = [
    "BLOCKED",
    "ALLOWED",
    "ARMED",
    "EXECUTED"
  ];

  const sections = [
    [
      t("decisionSummary"),
      <>
        <div className="decision-summary-main">
          <Badge tone="warning">
            {translateStateToken(
              q.scenario.state,
              t,
              lang
            )}
          </Badge>

          <h2>
            {
              q.scenario.directionalContext ||
              t("unavailable")
            }
          </h2>

          <HorizonContext
            q={q}
            state={state}
            lang={lang}
            compact
          />

          <p>{t("explanatoryOnly")}</p>
        </div>

        <DataMeta updatedAt={q.generatedAt}/>
      </>
    ],
    [
      t("governingState"),
      <div className="state-timeline">
        {governingStages.map(
          (stage, index) => {
            const current =
              String(
                q.scenario.state || ""
              ).toUpperCase() === stage;

            const done =
              !current &&
              stage === "BLOCKED" &&
              String(
                q.scenario.state || ""
              ).toUpperCase() !== "BLOCKED";

            return (
              <React.Fragment key={stage}>
                {index ? <i/> : null}
                <span
                  className={
                    current
                      ? "current"
                      : done
                        ? "done"
                        : ""
                  }
                >
                  {translateStateToken(
                    stage,
                    t,
                    lang
                  )}
                </span>
              </React.Fragment>
            );
          }
        )}
      </div>
    ],
    [
      t("strengthVsReadiness"),
      <div className="metrics-grid two">
        <Metric
          label={t("strength")}
          value={`${formatNumber(
            q.decisionQuality,
            lang,
            0
          )}%`}
          tone="gold"
        />

        <Metric
          label={t("readiness")}
          value={`${formatNumber(
            q.confirmationScore,
            lang,
            0
          )}%`}
          tone="warning"
        />
      </div>
    ],
    [
      t("incompleteReason"),
      <div className="callout warning">
        <Icon name="warning"/>

        <div>
          <strong>
            {
              sanitizeUserFacingText(
                q.scenario.riskNote,
                lang,
                t("partial")
              )
            }
          </strong>

          <p>
            {
              q.blockers.count
                ? `${q.blockers.count} ${
                    lang === "ar"
                      ? "سبب/أسباب تمنع اكتمال القراءة"
                      : "reason(s) prevent reading completion"
                  }`
                : (
                    lang === "ar"
                      ? "لا توجد أسباب عدم اكتمال معلنة."
                      : "No incompletion reasons were reported."
                  )
            }
          </p>

          <ul className="reason-list">
            {blockerReasons.map(
              (reason, index) => (
                <li
                  key={`${reason}-${index}`}
                >
                  {reason}
                </li>
              )
            )}
          </ul>
        </div>
      </div>
    ],
    [
      t("directionalContext"),
      <div className="narrative">
        <Badge
          tone={
            directionKey(
              q.scenario.directionalContext
            ) === "bullish"
              ? "success"
              : directionKey(
                  q.scenario.directionalContext
                ) === "bearish"
                ? "danger"
                : "muted"
          }
        >
          {
            q.scenario.directionalContext ||
            t("unavailable")
          }
        </Badge>

        <HorizonContext
          q={q}
          state={state}
          lang={lang}
        />

        <p>
          {
            lang === "ar"
              ? "السياق الاتجاهي منفصل عن جاهزية القرار النهائية."
              : "Directional context remains separate from final decision readiness."
          }
        </p>
      </div>
    ],
    [
      t("scenarioLevels"),
      <div className="level-grid decision-level-grid">
        <Metric
          label={t("activation")}
          value={formatNumber(
            q.scenario.activation,
            lang,
            4
          )}
          tone="success"
        />

        <Metric
          label={t("arrival")}
          value={formatNumber(
            q.scenario.arrival,
            lang,
            4
          )}
          tone="gold"
        />

        <Metric
          label={t("review")}
          value={formatNumber(
            q.scenario.review,
            lang,
            4
          )}
        />

        <Metric
          label={t("invalidation")}
          value={formatNumber(
            q.scenario.invalidation,
            lang,
            4
          )}
          tone="danger"
        />
      </div>
    ],
    [
      t("nmp"),
      <div className="nmp-card">
        <div className="nmp-meter">
          <span
            style={{
              width:
                String(
                  q.nmp.status || ""
                ).toUpperCase() === "AVAILABLE"
                  ? "100%"
                  : "12%"
            }}
          />
        </div>

        <strong>
          {translateNmpStatus(
            q.nmp.status,
            lang,
            t
          )}
        </strong>

        <b>{nmpPrimaryValue(q, lang)}</b>

        <p>{publicNmpNote(q, lang)}</p>
      </div>
    ],
    [
      t("riskChallenge"),
      <div className="risk-list">
        <span>
          {t("dataQuality")}
          <b>
            {formatNumber(
              q.decisionQuality,
              lang,
              0
            )}%
          </b>
        </span>

        <span>
          {t("risk")}
          <b>{t(risk.key)}</b>
        </span>

        <span>
          {t("timeframe")}
          <b>{state.timeframe}</b>
        </span>

        <span>
          {
            lang === "ar"
              ? "نوع الأفق"
              : "Horizon type"
          }
          <b>
            {horizon.scope} · {horizon.exposure}
          </b>
        </span>
      </div>
    ],
    [
      t("usdMacro"),
      <div className="narrative">
        <Badge
          tone={
            Math.abs(
              q.usdPressureScore || 0
            ) > 20
              ? "warning"
              : "muted"
          }
        >
          {formatNumber(
            q.usdPressureScore,
            lang,
            2
          )}
        </Badge>

        <p>
          {
            lang === "ar"
              ? "ضغط الدولار عامل سياقي محكوم ولا يغير TDL مباشرة."
              : "USD pressure is a governed contextual factor and does not directly change TDL."
          }
        </p>
      </div>
    ],
    [
      t("devilsAdvocate"),
      <div className="callout">
        <Icon name="warning"/>
        <div>
          <p>
            {
              sanitizeUserFacingText(
                q.scenario.riskNote ||
                q.golden.summary,
                lang,
                t("partial")
              )
            }
          </p>
        </div>
      </div>
    ],
    [
      t("evidence"),
      <div className="evidence-grid">
        <Metric
          label="TDL"
          value={`${formatNumber(
            q.alignmentScore,
            lang,
            0
          )}%`}
        />

        <Metric
          label="NMP"
          value={
            numeric(q.nmp.level) !== null
              ? formatNumber(q.nmp.level, lang, 4)
              : (lang === "ar"
                  ? "غير متاح من المصدر الحي"
                  : "Unavailable from live source")
          }
          hint={translateNmpStatus(
            q.nmp.status,
            lang,
            t
          )}
        />

        <Metric
          label="MACD"
          value={sourceMetricValue(
            q.macdHistogram,
            lang,
            2
          )}
        />

        <Metric
          label="OBV"
          value={sourceMetricValue(
            q.obvSlope,
            lang,
            2
          )}
        />

        <Metric
          label="CCI"
          value={sourceMetricValue(
            q.cciValue,
            lang,
            2
          )}
        />

        <Metric
          label={t("dataQuality")}
          value={`${formatNumber(
            q.decisionQuality,
            lang,
            0
          )}%`}
        />
      </div>
    ],
    [
      t("advancedDetails"),
      state.view === "professional"
        ? (
            <div className="advanced-list">
              <span>
                {
                  lang === "ar"
                    ? "تصنيف الأفق"
                    : "Horizon profile"
                }
                <b>
                  {horizon.scope} ·{" "}
                  {horizon.exposure}
                </b>
              </span>

              <span>
                {t("timeframe")}
                <b>{horizon.note}</b>
              </span>

              <span>
                {t("sourceStatus")}
                <b>{t("live")}</b>
              </span>

              <span>
                {t("lastUpdated")}
                <b>
                  {formatDate(
                    q.generatedAt,
                    lang
                  )}
                </b>
              </span>

              <span>
                Contract
                <b>
                  {
                    q.raw
                      ?.public_contract_version ||
                    "—"
                  }
                </b>
              </span>
            </div>
          )
        : (
            <div className="locked-inline">
              <Icon name="lock"/>
              <span>{t("professional")}</span>
            </div>
          )
    ]
  ];

  return (
    <>
      <PageHeader
        title={t("decisionRoom")}
        subtitle={
          `${assetName(
            findAsset(state.symbol),
            lang
          )} · ${state.symbol}`
        }
        actions={<ContextSummary/>}
      />

      <div className="decision-sections">
        {sections.map(
          ([title, content], index) => (
            <Card
              id={`decision-section-${index + 1}`}
              title={`${index + 1}. ${title}`}
              className={
                `decision-section section-${index + 1}`
              }
              key={title}
            >
              {content}
            </Card>
          )
        )}
      </div>

      <Card
        title={t("alternativeScenario")}
        actions={
          <button
            className="button secondary"
            onClick={() =>
              setAlternative(
                (value) => !value
              )
            }
          >
            {
              t(
                alternative
                  ? "hideAlternative"
                  : "showAlternative"
              )
            }
          </button>
        }
      >
        {
          alternative
            ? (
                <p>
                  {
                    lang === "ar"
                      ? "إذا تجاوز السعر مستوى الإلغاء، يعاد بناء السياق من البداية ولا تنسخ مستويات السيناريو السابق."
                      : "If price crosses invalidation, context is rebuilt from the start and previous scenario levels are not copied."
                  }
                </p>
              )
            : (
                <p>
                  {
                    lang === "ar"
                      ? "مغلق افتراضيًا لتجنب تشتيت المستخدم."
                      : "Closed by default to avoid distracting the user."
                  }
                </p>
              )
        }
      </Card>
    </>
  );
}

function PortfolioPage() {
  const { state } = useDecision();
  const { t, lang } = useTranslate();
  const universe = useMarketUniverse(state.timeframe);
  const [holdings, setHoldings] = useState(() => readJsonStorage(PORTFOLIO_STORAGE, []));
  const [symbol, setSymbol] = useState(state.symbol);
  const [quantity, setQuantity] = useState("");
  const [cost, setCost] = useState("");
  useEffect(() => localStorage.setItem(PORTFOLIO_STORAGE, JSON.stringify(holdings)), [holdings]);
  const liveMap = new Map(universe.rows.map((row) => [row.symbol, row.quality?.instrument?.livePrice]));
  const rows = holdings.map((holding) => {
    const asset = findAsset(holding.symbol);
    const price = numeric(liveMap.get(holding.symbol));
    const value = price === null ? null : price * numeric(holding.quantity);
    const costValue = numeric(holding.cost) * numeric(holding.quantity);
    return { ...holding, asset, price, value, costValue };
  });
  const total = rows.reduce((sum, row) => sum + (row.value || 0), 0);
  const totalCost = rows.reduce((sum, row) => sum + (row.costValue || 0), 0);
  const add = () => {
    const qty = numeric(quantity);
    const cst = numeric(cost);
    if (qty === null || qty <= 0 || cst === null || cst < 0) return;
    setHoldings((current) => [...current.filter((row) => row.symbol !== symbol), { symbol, quantity: qty, cost: cst }]);
    setQuantity(""); setCost("");
  };
  return <><PageHeader title={t("portfolio")} subtitle={t("local")}/><div className="portfolio-form card"><select value={symbol} onChange={(event) => setSymbol(event.target.value)}>{ASSETS.map((asset) => <option value={asset.symbol} key={asset.symbol}>{assetName(asset, lang)} · {asset.symbol}</option>)}</select><input value={quantity} onChange={(event) => setQuantity(event.target.value)} inputMode="decimal" placeholder={t("quantity")}/><input value={cost} onChange={(event) => setCost(event.target.value)} inputMode="decimal" placeholder={t("costBasis")}/><button className="button primary" onClick={add}>{t("addPortfolio")}</button></div><div className="metrics-grid dashboard-metrics"><Metric label={t("portfolioValue")} value={formatNumber(total, lang, 2)}/><Metric label={t("costBasis")} value={formatNumber(totalCost, lang, 2)}/><Metric label={t("profitLoss")} value={formatNumber(total - totalCost, lang, 2)} tone={total - totalCost >= 0 ? "success" : "danger"}/><Metric label={t("trackedAssets")} value={rows.length}/></div><Card title={t("holdings")}>{rows.length ? <div className="table-wrap"><table><thead><tr><th>{t("asset")}</th><th>{t("quantity")}</th><th>{t("costBasis")}</th><th>{t("price")}</th><th>{t("portfolioValue")}</th><th>{t("profitLoss")}</th><th>{t("actions")}</th></tr></thead><tbody>{rows.map((row) => <tr key={row.symbol}><td><b>{assetName(row.asset, lang)}</b><small>{row.symbol}</small></td><td>{formatNumber(row.quantity, lang, 6)}</td><td>{formatNumber(row.cost, lang, 4)}</td><td>{formatNumber(row.price, lang, 4)}</td><td>{formatNumber(row.value, lang, 2)}</td><td className={(row.value || 0) - row.costValue >= 0 ? "up" : "down"}>{row.value === null ? "—" : formatNumber(row.value - row.costValue, lang, 2)}</td><td><button className="icon-button compact" onClick={() => setHoldings((current) => current.filter((item) => item.symbol !== row.symbol))}><Icon name="trash"/></button></td></tr>)}</tbody></table></div> : <EmptyState/>}</Card></>;
}


function ScenariosPage() {
  const { state } = useDecision();
  const { t, lang } = useTranslate();

  const quality = useQuality(
    state.symbol,
    state.timeframe
  );

  if (quality.status !== "ready") {
    return (
      <EmptyState
        type={
          quality.status === "error"
            ? "error"
            : "loading"
        }
        onRetry={
          quality.status === "error"
            ? quality.retry
            : undefined
        }
      />
    );
  }

  const q = quality.value;

  return (
    <>
      <PageHeader
        title={t("scenarios")}
        subtitle={
          `${assetName(
            findAsset(state.symbol),
            lang
          )} · ${state.symbol}`
        }
      />

      <div className="level-grid large decision-level-grid">
        <Metric
          label={t("activation")}
          value={formatNumber(
            q.scenario.activation,
            lang,
            4
          )}
          tone="success"
        />

        <Metric
          label={t("arrival")}
          value={formatNumber(
            q.scenario.arrival,
            lang,
            4
          )}
          tone="gold"
        />

        <Metric
          label={t("review")}
          value={formatNumber(
            q.scenario.review,
            lang,
            4
          )}
        />

        <Metric
          label={t("invalidation")}
          value={formatNumber(
            q.scenario.invalidation,
            lang,
            4
          )}
          tone="danger"
        />
      </div>

      <Card title={t("nmpZone")}>
        <div className="nmp-card">
          <strong>
            {translateNmpStatus(
              q.nmp.status,
              lang,
              t
            )}
          </strong>

          <b>{nmpPrimaryValue(q, lang)}</b>

          <p>{publicNmpNote(q, lang)}</p>
        </div>
      </Card>
    </>
  );
}

function LayersPage() {
  const { state } = useDecision();
  const { t, lang } = useTranslate();

  const quality = useQuality(
    state.symbol,
    state.timeframe
  );

  if (quality.status !== "ready") {
    return (
      <EmptyState
        type={
          quality.status === "error"
            ? "error"
            : "loading"
        }
        onRetry={
          quality.status === "error"
            ? quality.retry
            : undefined
        }
      />
    );
  }

  const q = quality.value;

  const publicData = {
    tdl: {
      state:
        q.alignmentScore === null
          ? t("unavailable")
          : `${formatNumber(
              q.alignmentScore,
              lang,
              0
            )}%`,
      text:
        q.scenario.directionalContext
    },
    nmp: {
      state: translateNmpStatus(
        q.nmp.status,
        lang,
        t
      ),
      text: publicNmpNote(q, lang)
    },
    golden: {
      state: goldenStatusLabel(
        q.golden.status,
        lang,
        t
      ),
      text: goldenPublicSummary(
        q,
        lang,
        t
      )
    },
    enhancedGolden: {
      state:
        q.raw
          ?.enhanced_golden_alignment_active
          ? t("executed")
          : t("underMonitoring"),
      text: enhancedGoldenPublicText(
        q,
        lang
      )
    },
    devilsAdvocate: {
      state:
        q.blockers.count
          ? t("underMonitoring")
          : t("allowed"),
      text: sanitizeUserFacingText(
        q.scenario.riskNote,
        lang,
        t("partial")
      )
    }
  };

  return (
    <>
      <PageHeader
        title={
          lang === "ar"
            ? "الطبقات العامة 16 طبقة"
            : "Public Layers · 16 Layers"
        }
        subtitle={t("explanatoryOnly")}
      />

      <div className="layers-grid">
        {PUBLIC_LAYERS.map((layer) => (
          <Card
            title={layer.label[lang]}
            key={layer.id}
          >
            <div className="layer-public">
              <Badge>
                {
                  publicData[layer.id]
                    ?.state ||
                  "—"
                }
              </Badge>

              <p>
                {
                  publicData[layer.id]
                    ?.text ||
                  t("partial")
                }
              </p>

              {layer.id === "tdl" ? (
                <HorizonContext
                  q={q}
                  state={state}
                  lang={lang}
                  compact
                />
              ) : null}
            </div>
          </Card>
        ))}
      </div>

      <div className="callout">
        <Icon name="lock"/>
        <p>
          {
            lang === "ar"
              ? "الطبقات الداخلية الأخرى محمية ولا تعرض أسماؤها أو صيغها في واجهة المستخدم التجارية."
              : "Other internal layers are protected; their names and formulas are not exposed in the commercial UI."
          }
        </p>
      </div>
    </>
  );
}

function RiskPage() {
  const { state } = useDecision();
  const { t, lang } = useTranslate();

  const quality = useQuality(
    state.symbol,
    state.timeframe
  );

  if (quality.status !== "ready") {
    return (
      <EmptyState
        type={
          quality.status === "error"
            ? "error"
            : "loading"
        }
        onRetry={
          quality.status === "error"
            ? quality.retry
            : undefined
        }
      />
    );
  }

  const q = quality.value;
  const radar = qualityRadar(q, t);
  const risk = riskLevel(q);
  const reasons = blockerReasonList(q, lang);
  const horizon = horizonProfile(
    q,
    state,
    lang
  );

  return (
    <>
      <PageHeader
        title={t("riskChallenge")}
        subtitle={sanitizeUserFacingText(
          q.scenario.riskNote,
          lang,
          t("partial")
        )}
      />

      <div className="content-grid two">
        <Card title={t("keyRisks")}>
          <Radar
            values={radar.values}
            labels={radar.labels}
          />
        </Card>

        <Card title={t("devilsAdvocate")}>
          <div className="risk-list">
            <span>
              {t("risk")}
              <b>{t(risk.key)}</b>
            </span>

            <span>
              {
                lang === "ar"
                  ? "عدد أسباب عدم الاكتمال"
                  : "Incompletion reason count"
              }
              <b>{q.blockers.count}</b>
            </span>

            <span>
              {t("usdMacro")}
              <b>
                {formatNumber(
                  q.usdPressureScore,
                  state.lang,
                  2
                )}
              </b>
            </span>

            <span>
              {
                lang === "ar"
                  ? "نوع الأفق"
                  : "Horizon type"
              }
              <b>
                {horizon.scope} ·{" "}
                {horizon.exposure}
              </b>
            </span>
          </div>

          <div className="risk-reasons-box">
            <strong>
              {
                lang === "ar"
                  ? "أسباب عدم اكتمال القراءة"
                  : "Reading incompletion reasons"
              }
            </strong>

            <ul className="reason-list">
              {reasons.map(
                (reason, index) => (
                  <li
                    key={`${reason}-${index}`}
                  >
                    {reason}
                  </li>
                )
              )}
            </ul>
          </div>

          <div className="callout warning">
            <Icon name="warning"/>
            <p>
              {
                sanitizeUserFacingText(
                  q.scenario.riskNote,
                  lang,
                  t("partial")
                )
              }
            </p>
          </div>
        </Card>
      </div>
    </>
  );
}

function CompletedPage() {
  const { state } = useDecision();
  const completed = useCompletedDecisions();
  const { t, lang } = useTranslate();

  if (completed.status === "loading") {
    return <EmptyState type="loading"/>;
  }

  if (completed.status === "auth") {
    return (
      <>
        <PageHeader title={t("completed")}/>
        <EmptyState message={t("authRequired")}/>
      </>
    );
  }

  if (completed.status === "error") {
    return <EmptyState type="error" onRetry={completed.retry}/>;
  }

  const rows = (Array.isArray(completed.rows) ? completed.rows : [])
    .filter(isCompletedDecision);

  return (
    <>
      <PageHeader title={t("completed")}/>

      <Card title={t("completed")}>
        {rows.length ? (
          <div className="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>{t("asset")}</th>
                  <th>{t("status")}</th>
                  <th>{t("strength")}</th>
                  <th>{t("timeframe")}</th>
                  <th>{t("lastUpdated")}</th>
                </tr>
              </thead>

              <tbody>
                {rows.map((row, index) => {
                  const stateValue = resolveCompletedState(row);
                  const timeframeInfo = completedTimeframeInfo(
                    row,
                    state.timeframe
                  );
                  const qualityValue = numeric(
                    row.decision_quality ??
                    row.decisionQuality ??
                    row.quality?.decisionQuality
                  );

                  return (
                    <tr
                      key={row.id || row.asset_id || `${row.symbol}-${index}`}
                    >
                      <td>{resolveCompletedAsset(row, lang)}</td>
                      <td>
                        <Badge>
                          {translateStateToken(stateValue, t, lang)}
                        </Badge>
                      </td>
                      <td>
                        {qualityValue === null
                          ? "—"
                          : `${formatNumber(qualityValue, lang, 0)}%`}
                      </td>
                      <td>
                        <span className="timeframe-cell">
                          <b>{timeframeInfo.value}</b>
                          {timeframeInfo.inherited ? (
                            <small>
                              {lang === "ar"
                                ? "إطار العرض الحالي"
                                : "Current view timeframe"}
                            </small>
                          ) : null}
                        </span>
                      </td>
                      <td>
                        {formatDate(
                          row.updated_at ||
                          row.completed_at ||
                          row.generated_at,
                          lang
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <EmptyState
            message={
              lang === "ar"
                ? "لا توجد قرارات مكتملة فعلًا في المصدر الحالي. قرارات المتابعة لا تُعرض هنا."
                : "No strictly completed decisions are present in the current source. Monitoring decisions are excluded."
            }
          />
        )}
      </Card>
    </>
  );
}

function useHealthProbe() {
  const [state, setState] = useState({ status: "loading", rows: [] });
  const [revision, setRevision] = useState(0);
  const retry = () => setRevision((value) => value + 1);
  useEffect(() => {
    const controller = new AbortController();
    const checks = [
      ["API", "/api/health"],
      ["Quality", "/api/decision/quality-live?symbol=ETHUSDT&timeframe=weekly"],
      ["Candles", "/api/market/candles?symbol=ETHUSDT&timeframe=1h&interval=1h&limit=5"],
      ["News", "/api/news?symbol=ETHUSDT&limit=1"]
    ];
    Promise.all(checks.map(async ([name, path]) => {
      const started = performance.now();
      try {
        await fetchJson(path, { signal: controller.signal, timeout: 20_000 });
        return { name, ok: true, latency: Math.round(performance.now() - started), updatedAt: new Date().toISOString() };
      } catch (error) {
        return { name, ok: false, latency: null, error: error.message, updatedAt: new Date().toISOString() };
      }
    })).then((rows) => setState({ status: "ready", rows }));
    return () => controller.abort();
  }, [revision]);
  return { ...state, retry };
}

function DataHealthPage() {
  const { t } = useTranslate();
  const health = useHealthProbe();
  if (health.status === "loading") return <EmptyState type="loading"/>;
  return <><PageHeader title={t("dataHealth")} actions={<button className="button secondary" onClick={health.retry}><Icon name="refresh"/> {t("refresh")}</button>}/><div className="health-grid">{health.rows.map((row) => <Card title={row.name} key={row.name}><div className="health-status"><Badge tone={row.ok ? "success" : "danger"}>{row.ok ? t("serviceHealthy") : t("serviceUnavailable")}</Badge><strong>{row.latency === null ? "—" : `${row.latency} ms`}</strong></div><DataMeta updatedAt={row.updatedAt}/></Card>)}</div></>;
}


function AlertsPage() {
  const { state } = useDecision();
  const { t, lang } = useTranslate();

  const [store, setStore] = useState(
    () =>
      normalizeAlertStore(
        readJsonStorage(
          ALERTS_STORAGE,
          {}
        )
      )
  );

  const [event, setEvent] =
    useState("stateChange");

  useEffect(() => {
    localStorage.setItem(
      ALERTS_STORAGE,
      JSON.stringify(store)
    );
  }, [store]);

  const rules = store.rules;
  const channels = store.channels;

  const setChannels = (patch) => {
    setStore((current) => ({
      ...current,
      channels: {
        ...current.channels,
        ...patch
      }
    }));
  };

  const setRules = (updater) => {
    setStore((current) => ({
      ...current,
      rules:
        typeof updater === "function"
          ? updater(current.rules)
          : updater
    }));
  };

  const add = () => {
    setRules((current) => [
      ...current,
      {
        id: Date.now(),
        symbol: state.symbol,
        timeframe: state.timeframe,
        event,
        enabled: true,
        channels: {
          email: Boolean(
            channels.emailEnabled &&
            channels.email
          ),
          telegram: Boolean(
            channels.telegramEnabled &&
            channels.telegramChatId &&
            channels.telegramBotToken
          )
        }
      }
    ]);
  };

  return (
    <>
      <PageHeader
        title={t("alerts")}
        subtitle={t("local")}
        actions={
          <button
            className="button primary"
            onClick={add}
          >
            <Icon name="plus"/>{" "}
            {t("createRule")}
          </button>
        }
      />

      <div className="content-grid two">
        <Card
          title={
            lang === "ar"
              ? "قنوات التنبيه"
              : "Alert channels"
          }
        >
          <div className="context-form alert-config-grid">
            <label>
              <span>
                {
                  lang === "ar"
                    ? "البريد الإلكتروني"
                    : "Email"
                }
              </span>

              <input
                type="email"
                value={channels.email}
                onChange={(event) =>
                  setChannels({
                    email: event.target.value
                  })
                }
                placeholder="name@example.com"
              />
            </label>

            <label>
              <span>
                {
                  lang === "ar"
                    ? "رمز بوت تيليغرام"
                    : "Telegram Bot Token"
                }
              </span>

              <input
                type="password"
                value={
                  channels.telegramBotToken
                }
                onChange={(event) =>
                  setChannels({
                    telegramBotToken:
                      event.target.value
                  })
                }
                placeholder={
                  lang === "ar"
                    ? "أدخل الرمز"
                    : "Enter token"
                }
              />
            </label>

            <label>
              <span>
                {
                  lang === "ar"
                    ? "معرف محادثة تيليغرام"
                    : "Telegram Chat ID"
                }
              </span>

              <input
                type="text"
                value={
                  channels.telegramChatId
                }
                onChange={(event) =>
                  setChannels({
                    telegramChatId:
                      event.target.value
                  })
                }
                placeholder={
                  lang === "ar"
                    ? "أدخل المعرف"
                    : "Enter Chat ID"
                }
              />
            </label>
          </div>

          <div className="channel-toggle-stack">
            <label className="toggle-line">
              <input
                type="checkbox"
                checked={
                  channels.emailEnabled
                }
                onChange={(event) =>
                  setChannels({
                    emailEnabled:
                      event.target.checked
                  })
                }
              />
              <span>
                {
                  lang === "ar"
                    ? "تفعيل تنبيه البريد الإلكتروني"
                    : "Enable email alerts"
                }
              </span>
            </label>

            <label className="toggle-line">
              <input
                type="checkbox"
                checked={
                  channels.telegramEnabled
                }
                onChange={(event) =>
                  setChannels({
                    telegramEnabled:
                      event.target.checked
                  })
                }
              />
              <span>
                {
                  lang === "ar"
                    ? "تفعيل تنبيه تيليغرام"
                    : "Enable Telegram alerts"
                }
              </span>
            </label>
          </div>

          <div className="callout warning">
            <Icon name="info"/>
            <p>
              {
                lang === "ar"
                  ? "يتطلب الإرسال الفعلي للبريد الإلكتروني وتيليغرام وجود خدمة إرسال خلفية مفعلة."
                  : "Actual email and Telegram delivery requires an active backend delivery service."
              }
            </p>
          </div>
        </Card>

        <Card title={t("alertRules")}>
          <div className="toolbar">
            <select
              value={event}
              onChange={(event) =>
                setEvent(
                  event.target.value
                )
              }
            >
              <option value="stateChange">
                {eventLabel(
                  "stateChange",
                  lang
                )}
              </option>

              <option value="activation">
                {eventLabel(
                  "activation",
                  lang
                )}
              </option>

              <option value="stale">
                {eventLabel(
                  "stale",
                  lang
                )}
              </option>
            </select>
          </div>

          {
            rules.length
              ? (
                  <div className="table-wrap">
                    <table>
                      <thead>
                        <tr>
                          <th>{t("asset")}</th>
                          <th>{t("timeframe")}</th>
                          <th>
                            {
                              lang === "ar"
                                ? "الحدث"
                                : "Event"
                            }
                          </th>
                          <th>
                            {
                              lang === "ar"
                                ? "القنوات"
                                : "Channels"
                            }
                          </th>
                          <th>{t("status")}</th>
                          <th>{t("actions")}</th>
                        </tr>
                      </thead>

                      <tbody>
                        {rules.map((rule) => (
                          <tr key={rule.id}>
                            <td>{rule.symbol}</td>
                            <td>
                              {rule.timeframe}
                            </td>
                            <td>
                              {eventLabel(
                                rule.event,
                                lang
                              )}
                            </td>
                            <td>
                              <div className="rule-channel-badges">
                                <Badge
                                  tone={
                                    rule?.channels
                                      ?.email
                                      ? "success"
                                      : "muted"
                                  }
                                >
                                  {
                                    lang === "ar"
                                      ? "بريد"
                                      : "Email"
                                  }
                                </Badge>

                                <Badge
                                  tone={
                                    rule?.channels
                                      ?.telegram
                                      ? "success"
                                      : "muted"
                                  }
                                >
                                  {
                                    lang === "ar"
                                      ? "تيليغرام"
                                      : "Telegram"
                                  }
                                </Badge>
                              </div>
                            </td>
                            <td>
                              <button
                                className={
                                  `status-toggle ${
                                    rule.enabled
                                      ? "on"
                                      : ""
                                  }`
                                }
                                onClick={() =>
                                  setRules(
                                    (current) =>
                                      current.map(
                                        (row) =>
                                          row.id ===
                                          rule.id
                                            ? {
                                                ...row,
                                                enabled:
                                                  !row.enabled
                                              }
                                            : row
                                      )
                                  )
                                }
                              >
                                {
                                  rule.enabled
                                    ? "ON"
                                    : "OFF"
                                }
                              </button>
                            </td>
                            <td>
                              <button
                                className="icon-button compact"
                                onClick={() =>
                                  setRules(
                                    (current) =>
                                      current.filter(
                                        (row) =>
                                          row.id !==
                                          rule.id
                                      )
                                  )
                                }
                              >
                                <Icon name="trash"/>
                              </button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              : <EmptyState/>
          }
        </Card>
      </div>
    </>
  );
}

