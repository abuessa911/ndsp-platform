  { id: "tdl", label: { ar: "TDL", en: "TDL" } },
  { id: "nmp", label: { ar: "NMP", en: "NMP" } },
  { id: "golden", label: { ar: "إشارة نواف الذهبية", en: "Nawaf Golden Signal" } },
  { id: "enhancedGolden", label: { ar: "إشارة نواف الذهبية المعززة", en: "Enhanced Nawaf Golden Signal" } },
