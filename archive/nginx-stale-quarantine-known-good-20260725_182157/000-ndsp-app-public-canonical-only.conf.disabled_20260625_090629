# NDSP PUBLIC CANONICAL - rebuilt by NDSP_REBUILD_PUBLIC_REGISTER_PROXY_V6
# Scope: ndsp.app public landing + same-origin registration proxy only

server {
    listen 80;
    server_name ndsp.app www.ndsp.app;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
    }

    return 301 https://ndsp.app$request_uri;


    # NDSP_RESET_PASSWORD_ROUTE_V3_BEGIN
    location = /reset-password.html {
        root /var/www/html;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header X-NDSP-Reset-Route "v3" always;
        try_files /reset-password.html =404;
    }
    # NDSP_RESET_PASSWORD_ROUTE_V3_END

}

server {
    include /etc/nginx/snippets/ndsp-staged-commercial-security.conf;

    listen 443 ssl http2;
    server_name ndsp.app www.ndsp.app;

    root /var/www/ndsp;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/ndsp.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ndsp.app/privkey.pem;

    client_max_body_size 20m;

    add_header X-NDSP-Scope "public-landing" always;
    add_header X-NDSP-Serving-Root "/var/www/ndsp" always;

    location = /register.html.html {
        return 301 /register.html;
    }

    location = /register/ {
        return 301 /register.html;
    }


    # NDSP_PUBLIC_LOGIN_API_ROUTE
    location = /api/auth/login {
        proxy_pass http://127.0.0.1:9020/api/auth/login;
        proxy_http_version 1.1;
        proxy_set_header Host api.ndsp.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /api/trial/register/health {
        proxy_pass http://127.0.0.1:9019/api/trial/register/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location ^~ /api/trial/register/ {
        proxy_pass http://127.0.0.1:9019/api/trial/register/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location = /api/trial/invites/validate {
        proxy_pass http://127.0.0.1:9019/api/trial/invites/validate;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location = /api/trial/status {
        proxy_pass http://127.0.0.1:9001/api/trial/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/trial/seats {
        proxy_pass http://127.0.0.1:9064/api/trial/seats;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / {
        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }



    # NDSP_RESET_PASSWORD_ROUTE_V3_BEGIN
    location = /reset-password.html {
        root /var/www/html;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header X-NDSP-Reset-Route "v3" always;
        try_files /reset-password.html =404;
    }
    # NDSP_RESET_PASSWORD_ROUTE_V3_END

}
