server {
    listen 80;
    listen [::]:80;
    server_name admin.ndsp.app;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }

    include /etc/nginx/snippets/ndsp-layers-api-admin-location.conf;

    include /etc/nginx/snippets/ndsp-raw-cot-admin-location.conf;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.ndsp.app;

    ssl_certificate /etc/letsencrypt/live/admin.ndsp.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.ndsp.app/privkey.pem;

    root /var/www/ndsp-admin;
    index index.html;

    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;

    location = /api/admin/users/health {
        proxy_pass http://127.0.0.1:9068/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/admin/users/ {
        proxy_pass http://127.0.0.1:9068/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /data/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    include /etc/nginx/snippets/ndsp-layers-api-admin-location.conf;

    include /etc/nginx/snippets/ndsp-raw-cot-admin-location.conf;
}
