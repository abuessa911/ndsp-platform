server {
    include /etc/nginx/snippets/ndsp-staged-commercial-security.conf;

    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.ndsp.app;

    ssl_certificate /etc/letsencrypt/live/api.ndsp.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.ndsp.app/privkey.pem;

    location = /api/ui-bridge/health {
        proxy_pass http://127.0.0.1:9066;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api/dashboard/overview {
