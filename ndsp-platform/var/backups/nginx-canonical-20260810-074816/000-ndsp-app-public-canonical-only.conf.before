# NDSP PUBLIC CANONICAL - rebuilt by NDSP_REBUILD_PUBLIC_REGISTER_PROXY_V6
# Scope: ndsp.app public landing + same-origin registration proxy only

server {
    if ($host = www.ndsp.app) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = ndsp.app) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name ndsp.app www.ndsp.app;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
    }

    return 301 https://ndsp.app$request_uri;



    # NDSP_RESET_PASSWORD_ROUTE_V9_BEGIN
    location = /reset-password.html {
        root /var/www/html;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header X-NDSP-Reset-Route "v9" always;
        try_files /reset-password.html =404;
    }

    location = /ndsp-rp/reset {
        proxy_pass https://api.ndsp.app/api/auth/reset-password;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host api.ndsp.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering off;
        add_header X-NDSP-RP-Bridge "v9" always;
        add_header X-NDSP-RP-Upstream "/api/auth/reset-password" always;
    }
    # NDSP_RESET_PASSWORD_ROUTE_V9_END


    # NDSP_V15_COMPLETED_DECISIONS_API_BRIDGE_START
    location = /api/completed-decisions {
        default_type application/json;
        add_header X-NDSP-Bridge "v15-d2-static-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v15-api.json =404;
    }

    location = /api/completed-decisions/latest {
        default_type application/json;
        add_header X-NDSP-Bridge "v15-d2-static-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v15-api.json =404;
    }

    location = /api/v15/completed-decisions {
        default_type application/json;
        add_header X-NDSP-Bridge "v15-d2-static-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v15-api.json =404;
    }
    # NDSP_V15_COMPLETED_DECISIONS_API_BRIDGE_END


    # NDSP_V16_COMPLETED_DECISIONS_LIVE_ADAPTER_START
    location = /api/v16/completed-decisions {
        default_type application/json;
        add_header X-NDSP-Bridge "v16-live-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v16-live-adapter.json =404;
    }

    location = /api/completed-decisions-live {
        default_type application/json;
        add_header X-NDSP-Bridge "v16-live-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v16-live-adapter.json =404;
    }

    location = /api/completed-decisions-live/latest {
        default_type application/json;
        add_header X-NDSP-Bridge "v16-live-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v16-live-adapter.json =404;
    }
    # NDSP_V16_COMPLETED_DECISIONS_LIVE_ADAPTER_END

}

server {
    include /etc/nginx/snippets/ndsp-staged-commercial-security.conf;

    listen 443 ssl http2;
    server_name ndsp.app www.ndsp.app;

    root /var/www/ndsp;

    # NDSP_V15_AUTH_CANONICAL_BEGIN

    location = /login {
        return 301 /login/;
    }

    location = /login/ {
        root /var/www/ndsp-my;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        try_files /login/index.html =404;
    }

    location = /register {
        return 301 /register/;
    }

    location = /register.html {
        return 301 /register/;
    }

    location = /register/ {
        root /var/www/ndsp-my;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        try_files /register/index.html =404;
    }

    location = /forgot-password {
        return 301 /forgot-password/;
    }

    location = /forgot-password.html {
        root /var/www/ndsp-my;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        try_files /forgot-password.html =404;
    }

    location = /forgot-password/ {
        root /var/www/ndsp-my;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        try_files /forgot-password.html =404;
    }

    location = /owner {
        return 301 /owner/;
    }

    location = /owner/ {
        root /var/www/ndsp-my;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        try_files /owner/index.html =404;
    }

    location = /portal {
        return 301 /portal/;
    }

    location ^~ /portal/ {
        root /var/www/ndsp-my;
        try_files $uri $uri/index.html /portal/index.html;
    }

    location ^~ /api/public/ {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass_request_headers on;
    }

    location = /api/auth/session {
        proxy_pass http://127.0.0.1:9020/api/auth/session;
        proxy_http_version 1.1;

        proxy_set_header Host api.ndsp.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_pass_request_headers on;
    }

    location = /assets/ndsp-auth-surface-v1.css {
        root /var/www/ndsp-my;
        try_files $uri =404;
    }

    location = /assets/ndsp-register-v1.js {
        root /var/www/ndsp-my;
        try_files $uri =404;
    }

    location = /assets/ndsp-register-submit-bridge-v152.js {
        root /var/www/ndsp-my;
        try_files $uri =404;
    }

    location = /assets/ndsp-login-royal-v1.css {
        root /var/www/ndsp-my;
        try_files $uri =404;
    }

    location = /assets/ndsp-login-v1.js {
        root /var/www/ndsp-my;
        try_files $uri =404;
    }



    location = /api/auth/forgot-password {
        proxy_pass http://127.0.0.1:9027/api/auth/forgot-password;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass_request_headers on;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }


    location = /api/auth/logout {
        proxy_pass http://127.0.0.1:9020/api/auth/logout;
        proxy_http_version 1.1;

        proxy_set_header Host api.ndsp.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_pass_request_headers on;
    }


    location = /logout {
        return 302 /logout/;
    }

    location = /logout/ {
        proxy_pass http://127.0.0.1:9020/api/auth/logout-page;
        proxy_http_version 1.1;

        proxy_set_header Host api.ndsp.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_pass_request_headers on;
    }

    # NDSP_V15_AUTH_CANONICAL_END

    index index.html;
    ssl_certificate /etc/letsencrypt/live/api.ndsp.app/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.ndsp.app/privkey.pem; # managed by Certbot

    client_max_body_size 20m;

    add_header X-NDSP-Scope "public-landing" always;
    add_header X-NDSP-Serving-Root "/var/www/ndsp" always;

    location = /register.html.html {
        return 301 /register.html;
    }



    # NDSP_PUBLIC_LOGIN_API_ROUTE
    location = /api/auth/login {
        proxy_pass http://127.0.0.1:9020/api/auth/login;
        proxy_http_version 1.1;
        proxy_set_header Host api.ndsp.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /api/trial/register/health {
        proxy_pass http://127.0.0.1:9019/api/trial/register/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location ^~ /api/trial/register/ {
        proxy_pass http://127.0.0.1:9019/api/trial/register/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location = /api/trial/invites/validate {
        proxy_pass http://127.0.0.1:9019/api/trial/invites/validate;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    

    

    location = / {
        try_files /index.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }



    # NDSP_RESET_PASSWORD_ROUTE_V9_BEGIN
    location = /reset-password.html {
        root /var/www/html;
        default_type text/html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header X-NDSP-Reset-Route "v9" always;
        try_files /reset-password.html =404;
    }

    location = /ndsp-rp/reset {
        proxy_pass https://api.ndsp.app/api/auth/reset-password;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host api.ndsp.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering off;
        add_header X-NDSP-RP-Bridge "v9" always;
        add_header X-NDSP-RP-Upstream "/api/auth/reset-password" always;
    }
    # NDSP_RESET_PASSWORD_ROUTE_V9_END

    # NDSP V5.2 Backend Contract routes
    location = /api/decision/nmp-timeframes-live {
        proxy_pass http://127.0.0.1:9083/api/decision/nmp-timeframes-live$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api/decision/quality-contract-v52 {
        proxy_pass http://127.0.0.1:9083/api/decision/quality-contract-v52$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api/decision/v52/health {
        proxy_pass http://127.0.0.1:9083/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }


    # NDSP_V15_COMPLETED_DECISIONS_API_BRIDGE_START
    location = /api/completed-decisions {
        proxy_pass http://127.0.0.1:9087/api/completed-decisions$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_buffering off;
        add_header X-NDSP-Bridge "v35-evidence-registry-9087" always;
        add_header Cache-Control "no-store" always;
    }

    location = /api/completed-decisions/latest {
        proxy_pass http://127.0.0.1:9087/api/completed-decisions/latest$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_buffering off;
        add_header X-NDSP-Bridge "v35-evidence-registry-9087" always;
        add_header Cache-Control "no-store" always;
    }

    location = /api/v15/completed-decisions {
        default_type application/json;
        add_header X-NDSP-Bridge "v15-d2-static-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v15-api.json =404;
    }
    # NDSP_V15_COMPLETED_DECISIONS_API_BRIDGE_END


    # NDSP_V16_COMPLETED_DECISIONS_LIVE_ADAPTER_START
    location = /api/v16/completed-decisions {
        default_type application/json;
        add_header X-NDSP-Bridge "v16-live-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v16-live-adapter.json =404;
    }

    location = /api/completed-decisions-live {
        default_type application/json;
        add_header X-NDSP-Bridge "v16-live-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v16-live-adapter.json =404;
    }

    location = /api/completed-decisions-live/latest {
        default_type application/json;
        add_header X-NDSP-Bridge "v16-live-readonly" always;
        add_header Cache-Control "no-store" always;
        root /var/www/ndsp-my;
        try_files /data/completed-decisions-v16-live-adapter.json =404;
    }
    # NDSP_V16_COMPLETED_DECISIONS_LIVE_ADAPTER_END

    # NDSP_LAUNCH_CONTROL_V167_BEGIN
    location = /api/trial/status {
        proxy_pass http://127.0.0.1:9090/api/trial/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_headers on;
        proxy_buffering off;
        add_header X-NDSP-Launch-Control "v167" always;
        add_header Cache-Control "no-store" always;
    }

    location = /api/trial/seats {
        proxy_pass http://127.0.0.1:9090/api/trial/seats;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        add_header X-NDSP-Launch-Control "v167" always;
        add_header Cache-Control "no-store" always;
    }

    location = /api/launch/status {
        proxy_pass http://127.0.0.1:9090/api/launch/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        add_header X-NDSP-Launch-Control "v167" always;
        add_header Cache-Control "no-store" always;
    }
    # NDSP_LAUNCH_CONTROL_V167_END


    # NDSP V36 append-only completed-decision history.
    # Current/latest remain on their existing governed route.
    location = /api/completed-decisions/history {
        proxy_pass http://127.0.0.1:9088/api/completed-decisions/history$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/completed-decisions/history/integrity {
        proxy_pass http://127.0.0.1:9088/api/completed-decisions/history/integrity$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

}
