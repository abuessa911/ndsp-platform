<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#08090d">
<meta name="ndsp-reset-marker" content="NDSP_RESET_PASSWORD_EMAIL_PAYLOAD_V10_20260701_210715">
<title>إعادة تعيين كلمة المرور — NDSP</title>
<style>
:root{
  --bg:#08090d;
  --line:rgba(212,175,55,.55);
  --gold:#d4af37;
  --gold2:#efcc64;
  --text:#f4f6fb;
  --muted:#a4adbb;
  --ok:#66e3a1;
  --bad:#ff647c;
}
*{box-sizing:border-box}
html,body{
  margin:0;
  min-height:100%;
  background:var(--bg);
  color:var(--text);
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,Arial,sans-serif;
}
body{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:28px 16px;
  background:
    radial-gradient(circle at 50% -10%,rgba(212,175,55,.14),transparent 36%),
    linear-gradient(180deg,#07080c 0%,#090b10 100%);
}
.wrap{width:min(540px,100%)}
.brand{text-align:center;margin-bottom:22px}
.logo{display:inline-flex;align-items:center;justify-content:center;gap:12px}
.logo b{color:var(--gold);font-size:32px;letter-spacing:.08em}
.logo span{color:#7b8798;font-size:18px}
.card{
  border:1px solid var(--line);
  border-radius:26px;
  background:linear-gradient(180deg,rgba(17,20,29,.98),rgba(8,9,13,.98));
  box-shadow:0 24px 70px rgba(0,0,0,.48);
  padding:28px;
}
.kicker{color:var(--gold2);font-size:14px;margin-bottom:8px}
h1{margin:0 0 12px;font-size:clamp(28px,7vw,44px);line-height:1.2}
p{margin:0 0 20px;color:var(--muted);line-height:1.9;font-size:16px}
label{display:block;margin:16px 0 8px;color:#e4e8f0;font-weight:800}
input{
  width:100%;
  border:1px solid rgba(255,255,255,.15);
  background:#07090e;
  color:var(--text);
  border-radius:16px;
  padding:15px 16px;
  font-size:17px;
  outline:none;
}
input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.13)}
button{
  width:100%;
  margin-top:20px;
  border:1px solid rgba(212,175,55,.85);
  background:linear-gradient(180deg,#e6c65f,#caa33a);
  color:#08090d;
  border-radius:16px;
  padding:15px 16px;
  font-size:18px;
  font-weight:900;
  cursor:pointer;
}
button:disabled{opacity:.65;cursor:not-allowed}
.msg{
  display:none;
  margin-top:16px;
  border-radius:16px;
  padding:14px;
  line-height:1.8;
  font-weight:800;
  word-break:break-word;
}
.msg.ok{display:block;border:1px solid rgba(102,227,161,.42);background:rgba(102,227,161,.08);color:var(--ok)}
.msg.bad{display:block;border:1px solid rgba(255,100,124,.42);background:rgba(255,100,124,.08);color:var(--bad)}
.note{
  margin-top:16px;
  border:1px solid rgba(255,255,255,.1);
  background:rgba(255,255,255,.035);
  border-radius:16px;
  padding:13px 14px;
  color:var(--muted);
  font-size:14px;
  line-height:1.8;
}
.login-link{display:none;margin-top:14px;text-align:center}
.login-link a{color:var(--gold2);font-weight:900;text-decoration:none}
.small{margin-top:18px;text-align:center;color:#697386;font-size:12px}
@media(max-width:420px){.card{padding:22px 18px;border-radius:22px}}
</style>
</head>
<body>
<main class="wrap">
  <div class="brand">
    <div class="logo"><b>نواف</b><span>| NDSP</span></div>
  </div>

  <section class="card">
    <div class="kicker">NDSP — Password Reset</div>
    <h1>إعادة تعيين كلمة المرور</h1>
    <p>أدخل كلمة مرور جديدة لحسابك. الرابط صالح لفترة محدودة، وبعد نجاح التغيير يمكنك تسجيل الدخول من جديد.</p>

    <form id="resetForm" autocomplete="off">
      <label for="email">البريد الإلكتروني</label>
      <input id="email" name="email" type="email" autocomplete="email" required placeholder="أدخل البريد الموجود في رابط الاستعادة">

      <label for="newPassword">كلمة المرور الجديدة</label>
      <input id="newPassword" name="newPassword" type="password" minlength="8" autocomplete="new-password" required placeholder="أدخل كلمة مرور قوية">

      <label for="newPassword2">تأكيد كلمة المرور</label>
      <input id="newPassword2" name="newPassword2" type="password" minlength="8" autocomplete="new-password" required placeholder="أعد كتابة كلمة المرور">

      <button id="submitBtn" type="submit">تعيين كلمة المرور</button>
    </form>

    <div id="msg" class="msg"></div>

    <div id="loginLink" class="login-link">
      <a href="https://my.ndsp.app/">الانتقال إلى منصة NDSP</a>
    </div>

    <div class="note">إذا انتهت صلاحية الرابط، ارجع إلى صفحة الدخول واطلب رابط إعادة تعيين جديد.</div>
  </section>

  <div class="small">NDSP — Nawaf Decision Support Platform</div>
</main>

<script>
(function(){
  "use strict";

  const qs = new URLSearchParams(window.location.search);
  const token = (qs.get("token") || "").trim();
  const emailFromUrl = (qs.get("email") || "").trim();

  const form = document.getElementById("resetForm");
  const msg = document.getElementById("msg");
  const btn = document.getElementById("submitBtn");
  const loginLink = document.getElementById("loginLink");
  const emailInput = document.getElementById("email");

  if(emailFromUrl){
    emailInput.value = emailFromUrl;
  }

  function show(type, text){
    msg.className = "msg " + type;
    msg.textContent = text;
  }

  if(!token){
    show("bad", "الرابط غير مكتمل: لا يوجد رمز إعادة التعيين. اطلب رابطاً جديداً من صفحة الدخول.");
    btn.disabled = true;
    return;
  }

  async function resetPassword(email, newPassword){
    const res = await fetch("/ndsp-rp/reset", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      credentials: "include",
      cache: "no-store",
      body: JSON.stringify({
        token: token,
        email: email,
        newPassword: newPassword
      })
    });

    const text = await res.text();
    let data = null;

    try {
      data = text ? JSON.parse(text) : null;
    } catch(e) {
      data = { raw:text };
    }

    return { res:res, data:data, text:text };
  }

  form.addEventListener("submit", async function(e){
    e.preventDefault();

    const email = emailInput.value.trim();
    const p1 = document.getElementById("newPassword").value;
    const p2 = document.getElementById("newPassword2").value;

    if(!email){
      show("bad", "البريد الإلكتروني مطلوب.");
      return;
    }

    if(!p1 || p1.length < 8){
      show("bad", "كلمة المرور يجب أن تكون 8 أحرف على الأقل.");
      return;
    }

    if(p1 !== p2){
      show("bad", "كلمتا المرور غير متطابقتين.");
      return;
    }

    btn.disabled = true;
    btn.textContent = "جاري التعيين...";
    show("ok", "جاري معالجة الطلب...");

    try{
      const r = await resetPassword(email, p1);

      if(r.res.ok && (!r.data || r.data.ok !== false)){
        show("ok", "تم تعيين كلمة المرور بنجاح. يمكنك الآن تسجيل الدخول.");
        form.style.display = "none";
        loginLink.style.display = "block";
        return;
      }

      let err = "HTTP " + r.res.status;

      if(r.data && (r.data.error || r.data.message || r.data.detail)){
        err += " — " + String(r.data.error || r.data.message || r.data.detail);
      } else if(r.text) {
        err += " — " + r.text.slice(0, 180).replace(/\s+/g, " ");
      }

      show("bad", "لم ينجح تعيين كلمة المرور: " + err);
      btn.disabled = false;
      btn.textContent = "تعيين كلمة المرور";
    }catch(err){
      show("bad", "فشل الاتصال بخدمة إعادة التعيين: " + (err && err.message ? err.message : String(err)));
      btn.disabled = false;
      btn.textContent = "تعيين كلمة المرور";
    }
  });
})();
</script>
</body>
</html>
