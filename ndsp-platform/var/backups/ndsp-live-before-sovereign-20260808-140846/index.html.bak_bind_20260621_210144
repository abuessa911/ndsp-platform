      <button class="nav-toggle" id="navtoggle" aria-label="القائمة">☰</button>
    </div>
  </div>
</header>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow" data-i18n="hero.eyebrow">منصة ذكاء قرار مؤسسية</span>
      <h1 data-i18n-html="hero.h1">قرار قابل <span class="g">للتفسير</span>، وليس مجرّد تحليل</h1>
      <p class="lead" data-i18n="hero.lead">من البيانات الخام إلى حالة قرار موثّقة وقابلة للفهم والمراجعة، عبر طبقات ومحرّكات تحليل مترابطة.</p>
      <div class="hero-cta">
        <a href="/register" class="btn btn-gold" data-i18n="hero.ctaPrimary">ابدأ التجربة المجانية</a>
        <a href="#method" class="btn btn-ghost" data-i18n="hero.ctaMethod">تعرّف على المنهجية</a>
      </div>
      <div class="vstrip">
        <span class="vi" data-i18n-html="vs.1"><b>16</b> يوم تجربة كاملة</span>
        <span class="vi" data-i18n-html="vs.2"><b>16</b> محرّك قرار</span>
        <span class="vi" data-i18n-html="vs.3"><b>+5</b> محرّكات حوكمة واعتماد</span>
        <span class="vi" data-i18n="vs.4">يوميات قرار</span>
        <span class="vi" data-i18n="vs.5">تنبيهات ذكية</span>
      </div>
    </div>

    <div class="pipe">
      <div class="stage"><span class="idx">01</span><div class="body"><div class="t" data-i18n="p.1t">بيانات السوق</div><div class="d" data-i18n="p.1d">Market Data</div></div></div>
      <div class="connector"></div>
      <div class="stage"><span class="idx">02</span><div class="body"><div class="t" data-i18n="p.2t">السياق الكلّي</div><div class="d" data-i18n="p.2d">Macro Context</div></div></div>
      <div class="connector"></div>
      <div class="stage"><span class="idx">03</span><div class="body"><div class="t" data-i18n-html="p.3t">محرّك <span class="mono">TDL</span></div><div class="d" data-i18n="p.3d">TDL Engine</div></div></div>
      <div class="connector"></div>
      <div class="stage"><span class="idx">04</span><div class="body"><div class="t" data-i18n-html="p.4t">محرّك <span class="mono">NMP</span></div><div class="d" data-i18n="p.4d">NMP Engine</div></div></div>
      <div class="connector"></div>
      <div class="stage final"><span class="idx">05</span><div class="body"><div class="t" data-i18n="p.5t">حالة القرار</div><div class="d" data-i18n="p.5d">Decision State</div></div></div>
      <p class="pipe-note" data-i18n-html="pipe.note">تعمل هذه السلسلة بالاستناد إلى منظومة داخلية تضم <b>16 محرّك قرار</b>، إضافة إلى محرّكات حوكمة واعتماد وجودة داخلية غير معروضة للمستخدم، بهدف حماية المنهجية وتقديم حالة قرار قابلة للتفسير.</p>
      <div class="eng-chips">
        <span class="chip" data-i18n="chip.1">محرّكات قرار داخلية</span>
        <span class="chip" data-i18n="chip.2">محرّكات حوكمة واعتماد</span>
        <span class="chip" data-i18n="chip.3">محرّكات جودة وربط</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== HOW ===== -->
<section class="sec" id="how">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-i18n="how.eyebrow">كيف تعمل المنصة</span>
      <h2 data-i18n="how.h2">من البيانات الخام إلى حالة قرار قابلة للتفسير</h2>
      <p data-i18n="how.p">كل مرحلة تُغذّي التي تليها، وتبقى أسبابها موثّقة وقابلة للمراجعة عبر سلسلة القرار كاملة.</p>
    </div>
    <div class="flow reveal">
      <div class="flow-step"><div class="num">01</div><div class="ft" data-i18n="f.1t">بيانات السوق</div><div class="fk">MARKET DATA</div><div class="fd" data-i18n="f.1d">تدفّق أسعار ومؤشرات متعددة الأصول كمدخل أساسي.</div></div>
      <div class="flow-step"><div class="num">02</div><div class="ft" data-i18n="f.2t">السياق الكلّي</div><div class="fk">MACRO CONTEXT</div><div class="fd" data-i18n="f.2d">قراءة الظروف الاقتصادية الكلية التي تؤطّر السوق.</div></div>
      <div class="flow-step"><div class="num">03</div><div class="ft" data-i18n="f.3t">محرّك TDL</div><div class="fk">TDL ENGINE</div><div class="fd" data-i18n="f.3d">تحديد الاتجاه الحاكم وبنية الحركة عبر الطبقات.</div></div>
      <div class="flow-step"><div class="num">04</div><div class="ft" data-i18n="f.4t">محرّك NMP</div><div class="fk">NMP ENGINE</div><div class="fd" data-i18n="f.4d">معالجة وترجيح الإشارات إلى حالة مترابطة واحدة.</div></div>
      <div class="flow-step"><div class="num">05</div><div class="ft" data-i18n="f.5t">حالة القرار</div><div class="fk">DECISION STATE</div><div class="fd" data-i18n="f.5d">المخرَج النهائي: حالة قابلة للفهم والتفسير والمراجعة.</div></div>
    </div>
  </div>
</section>

<!-- ===== FEATURES ===== -->
<section class="sec" id="features">
