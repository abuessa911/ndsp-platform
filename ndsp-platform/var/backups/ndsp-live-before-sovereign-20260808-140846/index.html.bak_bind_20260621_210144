<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0b0b0c" />
<title>NDSP — منصة ذكاء القرار للأسواق المالية</title>
<meta name="description" content="NDSP منصة ذكاء قرار مؤسسية، وليست منصة تداول أو توصيات." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root{
    color-scheme:dark;
    --void:#0b0b0c;
    --surface:#151516;
    --surface-2:#1a1a1c;
    --line:#26262a;
    --line-strong:#34343a;
    --gold:#caa24a;
    --gold-hi:#d8b56a;
    --gold-soft:rgba(202,162,74,.10);
    --text:#ededee;
    --text-2:#a7a7ab;
    --text-3:#6d6d72;
    --pos:#4ea96b;
    --neg:#c8553d;
    --sans:'IBM Plex Sans Arabic',system-ui,sans-serif;
    --mono:'IBM Plex Mono',ui-monospace,monospace;
    --maxw:1180px;
  }
  html[lang="en"]{--sans:'IBM Plex Sans',system-ui,sans-serif}
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;background:var(--void)}
  html,body{min-height:100%}
  body{background:var(--void);color:var(--text);font-family:var(--sans);font-weight:400;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  ::selection{background:var(--gold-soft);color:var(--gold-hi)}

  /* ===== background ===== */
  .bg-base{position:fixed;inset:0;z-index:0;pointer-events:none;background:#0b0b0c}
  .bg-mark{position:fixed;inset:-25%;z-index:0;pointer-events:none;opacity:.035;transform:rotate(-14deg);background-repeat:repeat;background-size:560px 390px}
  .watermark{position:fixed;bottom:14px;inset-inline-start:16px;z-index:5;font-family:var(--mono);font-size:10px;letter-spacing:.28em;color:var(--text-3);opacity:.5;pointer-events:none;user-select:none}

  /* ===== shell ===== */
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;position:relative;z-index:1}
  .eyebrow{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:var(--gold);display:inline-block}
  .mono{font-family:var(--mono)}
  section{position:relative;z-index:1}

  /* ===== nav ===== */
  header{position:sticky;top:0;z-index:40;background:rgba(11,11,12,.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:64px}
  .brand{display:flex;align-items:center;gap:11px;font-weight:600;letter-spacing:.02em}
  .brand .mark{width:26px;height:26px;border:1px solid var(--gold);display:grid;place-items:center;font-family:var(--mono);font-size:13px;color:var(--gold);font-weight:600;border-radius:3px}
  .brand small{font-family:var(--mono);font-size:9.5px;letter-spacing:.22em;color:var(--text-3);display:block;margin-top:1px}
  .nav-links{display:flex;align-items:center;gap:34px}
  .nav-links a{font-size:14px;color:var(--text-2);transition:color .2s}
  .nav-links a:hover{color:var(--text)}
  .nav-actions{display:flex;align-items:center;gap:12px}
  .lang-btn{font-family:var(--mono);font-size:12px;color:var(--text-2);background:transparent;border:1px solid var(--line-strong);border-radius:5px;padding:7px 11px;cursor:pointer;transition:all .2s;min-width:38px}
  .lang-btn:hover{border-color:var(--gold);color:var(--gold)}
  .nav-toggle{display:none;background:none;border:1px solid var(--line);color:var(--text);width:38px;height:38px;border-radius:5px;cursor:pointer}

  /* ===== buttons ===== */
  .btn{display:inline-flex;align-items:center;gap:9px;font-family:var(--sans);font-size:14px;font-weight:500;padding:11px 22px;border-radius:5px;cursor:pointer;transition:all .2s;border:1px solid transparent;white-space:nowrap}
  .btn-gold{background:var(--gold);color:#15120a;font-weight:600}
  .btn-gold:hover{background:var(--gold-hi);transform:translateY(-1px)}
  .btn-ghost{background:transparent;color:var(--text);border-color:var(--line-strong)}
  .btn-ghost:hover{border-color:var(--gold);color:var(--gold)}
  .btn-sm{padding:8px 16px;font-size:13px}

  /* ===== hero ===== */
  .hero{padding:96px 0 84px;border-bottom:1px solid var(--line)}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}
  .hero h1{font-size:clamp(34px,5vw,56px);font-weight:600;line-height:1.18;letter-spacing:-.01em;margin:22px 0 0}
  .hero h1 .g{color:var(--gold)}
  .hero p.lead{font-size:18px;color:var(--text-2);max-width:32em;margin:24px 0 0;line-height:1.75}
  .hero-cta{display:flex;gap:14px;margin-top:36px;flex-wrap:wrap}
  .vstrip{display:flex;flex-wrap:wrap;gap:14px 26px;margin-top:34px;padding-top:24px;border-top:1px solid var(--line)}
  .vstrip .vi{display:flex;align-items:center;gap:9px;font-size:13.5px;color:var(--text-2)}
  .vstrip .vi::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--gold);flex:0 0 5px;opacity:.85}
  .vstrip .vi b{color:var(--gold);font-family:var(--mono);font-weight:600;font-size:13px;margin-inline-end:4px}

  /* ===== pipeline ===== */
  .pipe{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:26px 24px;position:relative}
  .pipe::before{content:"DECISION PIPELINE";position:absolute;top:-9px;inset-inline-end:22px;background:var(--void);padding:0 10px;font-family:var(--mono);font-size:9.5px;letter-spacing:.24em;color:var(--gold)}
  .stage{display:flex;align-items:center;gap:14px;padding:13px 14px;border:1px solid var(--line);border-radius:7px;background:rgba(255,255,255,.012);position:relative;transition:border-color .25s,transform .25s}
  .stage:hover{border-color:var(--line-strong)}
  .stage .idx{font-family:var(--mono);font-size:11px;color:var(--gold);width:22px;flex:0 0 22px;text-align:center}
  .stage .body{flex:1}
  .stage .t{font-size:14.5px;font-weight:500}
  .stage .d{font-size:12px;color:var(--text-3);margin-top:2px}
  .stage .d:empty{display:none}
  .stage.final{border-color:var(--gold);background:var(--gold-soft)}
  .stage.final .t{color:var(--gold-hi)}
  .connector{height:14px;width:1px;background:var(--line-strong);margin:0 24px}
  .pipe-note{font-size:12.5px;color:var(--text-3);line-height:1.85;margin-top:18px}
  .pipe-note b{color:var(--text-2);font-weight:600}
  .eng-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  .eng-chips .chip{font-family:var(--mono);font-size:10.5px;letter-spacing:.03em;color:var(--text-2);border:1px solid var(--line);border-radius:5px;padding:6px 10px;background:var(--surface)}

  /* ===== sections ===== */
  .sec{padding:84px 0;border-bottom:1px solid var(--line)}
  .sec-head{max-width:42em;margin-bottom:48px}
  .sec-head h2{font-size:clamp(26px,3.4vw,36px);font-weight:600;line-height:1.3;margin-top:14px;letter-spacing:-.01em}
  .sec-head p{color:var(--text-2);font-size:16px;margin-top:14px;line-height:1.75}

  /* ===== how ===== */
  .flow{display:grid;grid-template-columns:repeat(5,1fr);gap:0}
  .flow-step{padding:24px 20px;border:1px solid var(--line);border-inline-end:none;position:relative;transition:background .25s}
  .flow-step:first-child{border-start-end-radius:9px;border-end-end-radius:9px}
  .flow-step:last-child{border-inline-end:1px solid var(--line);border-start-start-radius:9px;border-end-start-radius:9px;background:var(--gold-soft)}
  .flow-step:hover{background:rgba(255,255,255,.02)}
  .flow-step:last-child:hover{background:var(--gold-soft)}
  .flow-step .num{font-family:var(--mono);font-size:11px;color:var(--gold);letter-spacing:.12em}
  .flow-step .ft{font-size:15px;font-weight:600;margin-top:14px}
  .flow-step .fk{font-family:var(--mono);font-size:10.5px;color:var(--text-3);letter-spacing:.08em;margin-top:5px;direction:ltr;text-align:start}
  .flow-step .fd{font-size:12.5px;color:var(--text-2);margin-top:12px;line-height:1.65}

  /* ===== features ===== */
  .features{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .feat{background:var(--surface);padding:30px 26px;transition:background .25s}
  .feat:hover{background:var(--surface-2)}
  .feat .fnum{font-family:var(--mono);font-size:11px;color:var(--gold);letter-spacing:.1em}
  .feat h3{font-size:17px;font-weight:600;margin-top:16px}
  .feat p{font-size:13.5px;color:var(--text-2);margin-top:10px;line-height:1.7}

  /* ===== methodology ===== */
  .method-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  .method-card{border:1px solid var(--line);border-radius:10px;padding:30px 28px;background:var(--surface)}
  .method-card.no{border-top:2px solid var(--neg)}
  .method-card.yes{border-top:2px solid var(--gold)}
  .method-card h3{font-size:17px;font-weight:600;display:flex;align-items:center;gap:10px}
  .tag{font-family:var(--mono);font-size:10px;letter-spacing:.14em;padding:3px 8px;border-radius:4px}
  .tag.tneg{color:var(--neg);border:1px solid rgba(200,85,61,.4)}
  .tag.tpos{color:var(--gold);border:1px solid rgba(202,162,74,.4)}
  .method-list{list-style:none;margin-top:20px;display:flex;flex-direction:column;gap:14px}
  .method-list li{display:flex;gap:12px;font-size:14.5px;color:var(--text-2);line-height:1.6}
  .method-list li .ic{flex:0 0 18px;margin-top:3px;font-family:var(--mono);font-size:13px}
  .no .ic{color:var(--neg)}
  .yes .ic{color:var(--gold)}
  .method-note{margin-top:28px;padding:20px 24px;border:1px dashed var(--line-strong);border-radius:8px;font-size:14px;color:var(--text-2);line-height:1.8;text-align:center}
  .method-note b{color:var(--text);font-weight:600}

  /* ===== pricing ===== */
  .price-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .plan{position:relative;border:1px solid var(--line);border-radius:11px;padding:28px 22px;background:var(--surface);display:flex;flex-direction:column}
  .plan.featured{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold-soft)}
  .plan .ptag{font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:var(--text-3);text-transform:uppercase}
  .plan.featured .ptag{color:var(--gold)}
  .plan h3{font-size:20px;font-weight:600;margin-top:10px}
  .plan .pdesc{font-size:12px;color:var(--text-3);margin:4px 0 0;line-height:1.6}
  .plan .badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--gold);color:#15120a;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.06em;padding:4px 13px;border-radius:20px;white-space:nowrap}
  .plan .price{display:flex;align-items:baseline;gap:8px;margin:18px 0 4px}
  .plan .price .amt{font-family:var(--mono);font-size:28px;font-weight:600;color:var(--text)}
  .plan .price .per{font-size:13px;color:var(--text-3)}
  .plan ul{list-style:none;margin:20px 0;display:flex;flex-direction:column;gap:12px;flex:1}
  .plan ul li{font-size:13px;color:var(--text-2);display:flex;gap:10px;line-height:1.5}
  .plan ul li::before{content:"—";color:var(--gold);font-family:var(--mono)}
  .plan .btn{width:100%;justify-content:center;margin-top:auto}
  .price-note{max-width:62em;margin:30px auto 0;text-align:center;font-size:13.5px;color:var(--text-2);line-height:1.85;padding:18px 26px;border:1px solid var(--line);border-radius:9px;background:var(--surface)}

  /* ===== footer ===== */
  footer{padding:56px 0 70px;position:relative;z-index:1}
  .foot-top{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;padding-bottom:32px;border-bottom:1px solid var(--line)}
  .foot-brand{max-width:30em}
  .foot-brand p{color:var(--text-3);font-size:13px;margin-top:14px;line-height:1.8}
  .foot-links{display:flex;gap:60px;flex-wrap:wrap}
  .foot-col h4{font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:var(--text-3);text-transform:uppercase;margin-bottom:16px}
  .foot-col a{display:block;font-size:13.5px;color:var(--text-2);margin-bottom:11px;transition:color .2s}
  .foot-col a:hover{color:var(--gold)}
  .foot-bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-top:26px;flex-wrap:wrap}
  .foot-bottom span{font-family:var(--mono);font-size:11px;color:var(--text-3);letter-spacing:.08em}

  /* ===== reveal ===== */
  .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:none}

  /* ===== responsive ===== */
  @media(max-width:900px){
    .hero-grid{grid-template-columns:1fr;gap:44px}
    .flow{grid-template-columns:1fr 1fr}
    .flow-step{border:1px solid var(--line)!important;border-radius:0!important}
    .features{grid-template-columns:1fr 1fr}
    .method-grid{grid-template-columns:1fr}
    .price-grid{grid-template-columns:repeat(2,1fr)}
    .nav-links{display:none}
    .nav-links.open{display:flex;position:absolute;top:64px;inset-inline:0;flex-direction:column;background:var(--surface);border-bottom:1px solid var(--line);padding:18px 28px;gap:18px}
    .nav-toggle{display:grid;place-items:center}
    .nav-actions .btn-ghost{display:none}
  }
  @media(max-width:560px){
    .wrap{padding:0 20px}
    .flow,.features,.price-grid{grid-template-columns:1fr}
  }
  @media(prefers-reduced-motion:reduce){
    *{scroll-behavior:auto!important}
    .reveal{opacity:1;transform:none;transition:none}
  }
</style>
</head>
<body>

<div class="bg-base" aria-hidden="true"></div>
<div class="bg-mark" aria-hidden="true"></div>
<div class="watermark">HUNTER_KSA1</div>

<!-- ===== NAV ===== -->
<header>
  <div class="wrap nav">
    <div class="brand">
      <div class="mark">N</div>
      <div>NDSP<small>DECISION INTELLIGENCE</small></div>
    </div>
    <nav class="nav-links" id="navlinks">
      <a href="#how" data-i18n="nav.how">كيف تعمل</a>
