  }

  .badge:empty,
  .layer-badge:empty,
  [class*="badge"]:empty {
    display: none !important;
  }
</style>

</head><body><div class="gov">
    ⚠️ NDSP - نظام دعم القرار المالي التحليلي<br>
    هذا النظام يقدم تحليل ودعم قرار فقط، وليس نظام تنفيذ صفقات. أنت مسؤول بالكامل عن قراراتك.
  </div><header class="top"><div class="brand"><div class="logo">ND</div><div><h1>منصة دعم القرار المالي المتقدم</h1><p>NDSP Command Center</p></div></div><div class="top-meta"><span class="pill ok" id="api-pill">API متصل</span><span class="pill">الأصل:
        <select id="asset" class="select"><option value="SPY">SPY</option><option value="GLD">GLD</option><option value="WTI">WTI</option><option value="EURUSD">EURUSD</option><option value="BTC">BTC</option></select></span><span class="pill" id="last-update">آخر تحديث: —</span></div></header><div class="layout"><aside class="side"><div class="side-title">📊 التحليل</div><button class="nav active" data-tab="overview">🏠 نظرة عامة</button><button class="nav" data-tab="layers">🔍 الطبقات التحليلية</button><button class="nav" data-tab="scenarios">🎯 السيناريوهات</button><button class="nav" data-tab="decision">إشارة نواف الذهبية</button><button class="nav" data-tab="macro">🌍 العوامل الكلية</button><button class="nav" data-tab="cot">📊 فئات السوق</button><button class="nav" data-tab="technical">📉 التأكيد الفني</button><button class="nav" data-tab="risk">طبقة محامي الشيطان</button><button class="nav" data-tab="status">📋 حالة النظام</button><button class="nav" data-tab="admin">👤 الحساب والصلاحيات</button></aside><main class="main"><div class="page-head"><h2 id="page-title">نظرة عامة</h2><div class="status-line" id="route-line">https://api.ndsp.app/api/ndsp16</div></div><section id="overview" class="tab"><div class="grid"><div class="card" data-layer="1"></div><div class="card" data-layer="2"></div><div class="card" data-layer="3"></div><div class="card" data-layer="4"></div></div></section><section id="layers" class="tab hidden"><div class="grid"><div class="card" data-layer="10"></div><div class="card" data-layer="13"></div><div class="card" data-layer="7"></div><div class="card" data-layer="8"></div></div></section><section id="scenarios" class="tab hidden"><div class="grid"><div class="card wide" data-layer="5"></div><div class="card wide" data-layer="6"></div></div></section><section id="decision" class="tab hidden"><div class="grid"><div class="card" data-layer="7"></div><div class="card" data-layer="8"></div></div><div class="note">هذه القراءة تحليلية فقط، ولا تمثل توصية شراء أو بيع أو تنفيذ.</div></section><section id="macro" class="tab hidden"><div class="grid"><div class="card wide" data-layer="9"></div></div></section><section id="cot" class="tab hidden"><div class="grid"><div class="card wide" data-layer="11"></div><div class="card wide" data-layer="12"></div></div></section><section id="technical" class="tab hidden"><div class="grid"><div class="card wide" data-layer="14"></div></div></section><section id="risk" class="tab hidden"><div class="grid"><div class="card wide" data-layer="15"></div></div></section><section id="status" class="tab hidden"><div class="grid"><div class="card wide" id="status-card"></div></div></section><section id="admin" class="tab hidden"><div class="grid"><div class="card wide" data-layer="16"></div></div></section></main></div><script>
    const API = 'https://api.ndsp.app/api/ndsp16';
    const USER_ID = 'user1';

    const ENDPOINTS = {
      1:'live-price',2:'market-reading',3:'tdl',4:'nmp',5:'scenario-levels',
      6:'scenario-state',7:'decision-state',8:'quality-decision',9:'macro',
      10:'day-logic',11:'cot-categories',12:'category-alignment',
      13:'correction',14:'technical-confirmation',15:'risk-invalidation'
    };

    const TITLES = {
      overview:'نظرة عامة',
      layers:'الطبقات التحليلية',
      scenarios:'السيناريوهات',
      decision:'إشارة نواف الذهبية',
      macro:'العوامل الكلية',
      cot:'فئات السوق',
      technical:'التأكيد الفني',
      risk:'المخاطر والإلغاء',
      status:'حالة النظام',
      admin:'الحساب والصلاحيات'
    };

    const LAYER_TITLES = {
      1:'السعر الحي',
      2:'قراءة السوق',
      3:'منطق القرار الزمني TDL',
      4:'نقاط التحول الحرجة NMP',
      5:'مستويات السيناريو',
      6:'حالات السيناريوهات',
      7:'إشارة نواف الذهبية',
      8:'جودة القرار',
      9:'العوامل الكلية',
      10:'منطق اليوم',
      11:'فئات COT',
      12:'توافق الفئات',
      13:'التصحيح',
      14:'التأكيد الفني',
      15:'المخاطر والإلغاء',
      16:'حوكمة المستخدم والصلاحيات'
    };

    const LABELS = {
      layerName:'اسم الطبقة', assetId:'الأصل', currentPrice:'السعر الحالي',
      previousClose:'الإغلاق السابق', dayHigh:'أعلى اليوم', dayLow:'أقل اليوم',
      volume:'الحجم', change24h:'التغير 24 ساعة',
      overallSentiment:'قراءة السوق', buyerPressure:'ضغط المشترين',
      sellerPressure:'ضغط البائعين', momentum:'الزخم', volatilityLevel:'التقلب',
      liquidityStatus:'السيولة', marketCondition:'حالة السوق',
      trend:'الاتجاه', trendStrength:'قوة الاتجاه', dominantPattern:'النمط السائد',
      decisionPattern:'نمط القرار', timeframeAlignment:'توافق الفترات',
      primaryCriticalLevel:'المستوى الحرج الأول', secondaryCriticalLevel:'المستوى الحرج الثاني',
      breakoutProbability:'احتمال الكسر', reversalProbability:'احتمال الانعكاس',
      referenceType:'نوع المرجع', probability:'الاحتمال', activationLevel:'مستوى التفعيل',
      targetLevel:'المستوى المستهدف', reviewLevel:'مستوى المراجعة',
      cancellationLevel:'مستوى الإلغاء', horizonStrength:'قوة الأفق',
      rangeHigh:'أعلى النطاق', rangeLow:'أقل النطاق', exitTrigger:'محفز الخروج',
      state:'الحالة', progressPercent:'نسبة التقدم', decisionState:'إشارة نواف الذهبية',
      confidenceScore:'درجة الثقة', readingCompleteness:'اكتمال القراءة',
      recommendation:'التوجيه التحليلي', federalRate:'الفائدة',
      inflationRate:'التضخم', gdpGrowth:'نمو الناتج', dollarIndex:'مؤشر الدولار',
      vixLevel:'مؤشر الخوف', macroEnvironment:'البيئة الكلية',
      nextMeeting:'الاجتماع القادم', expectedAction:'الإجراء المتوقع',
      impactOnAsset:'الأثر المتوقع', nextEvent:'الحدث القادم',
      daysUntil:'الأيام المتبقية', importance:'الأهمية',
      dayPattern:'نمط اليوم', dominantParticipant:'الفئة المسيطرة',
      volumeProfile:'حجم التداول', timeOfDay:'وقت اليوم',
      implicitCorrection:'تصحيح ضمني', explicitCorrection:'تصحيح صريح',
      correctionType:'نوع التصحيح', correctionStrength:'قوة التصحيح',
      detected:'مرصود', ongoing:'مستمر', allowsContinuation:'يسمح بالاستمرار',
      invalidationLevels:'مستويات الإلغاء', riskNotes:'اعتراضات محامي الشيطان',
      suspendConditions:'شروط التعليق', riskRewardRatio:'نسبة المخاطرة/العائد',
      safetyMargin:'هامش الأمان', overallRiskLevel:'مستوى المخاطر العام',
      activeFeatures:'الميزات المفعلة', scenarios:'السيناريوهات',
      conditions:'الشروط', missingConditions:'الشروط الناقصة'
    };

    const VALUES = {
      Uptrend:'صاعد', Downtrend:'هابط', Sideways:'جانبي', Neutral:'محايد',
      Strong:'قوي', Weak:'ضعيف', High:'مرتفع', Normal:'طبيعي', Low:'منخفض',
      Connected:'متصل', Trending:'اتجاه واضح', Consolidating:'تجميع',
      Reversing:'انعكاس محتمل', Aligned:'متوافق', Conflicted:'متعارض',
      Synchronized:'متزامن', Divergent:'متباعد', Bullish:'صاعد',
      Bearish:'هابط', bullish:'صاعد', bearish:'هابط', sideways:'جانبي',
      Moderate:'متوسط', Critical:'حرج', Incomplete:'غير مكتمل',
      Activated:'مفعل', Cancelled:'ملغى', 'Under Monitoring':'تحت المراقبة',
      'Needs Confirmation':'يحتاج تأكيد',
      'Wait for additional confirmation':'انتظار تأكيد إضافي',
      'Supportive for Equities':'داعمة للأسهم', 'Hold or Cut':'تثبيت أو خفض',
      'Non-Farm Payrolls':'تقرير الوظائف الأمريكية',
      'Break either boundary':'كسر أحد حدود النطاق'
    };

    const HIDE = new Set(['timestamp','lastUpdate','layerId','dataSource','connectionStatus','source','success','createdAt','userId']);

    function esc(x){
      return String(x ?? '—')
        .replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
        .replaceAll('"','&quot;').replaceAll("'","&#039;");
    }
    function label(k){ return LABELS[k] || k; }
    function fmt(v,k=''){
      if(v === null || v === undefined || v === '') return '—';
      if(typeof v === 'boolean') return v ? 'نعم' : 'لا';
      if(typeof v === 'number' && isFinite(v)){
        let n = Math.abs(v) >= 1000000 ? v.toLocaleString('en-US',{maximumFractionDigits:0})
          : Math.abs(v) >= 1000 ? v.toLocaleString('en-US',{maximumFractionDigits:2})
          : v.toLocaleString('en-US',{maximumFractionDigits:2});
        if(String(k).toLowerCase().includes('percent')) n += '%';
        return n;
      }
      return esc(VALUES[String(v)] || v);
    }
    function tile(k,v){
      let cls = '';
      if(typeof v === 'number' && v > 0 && String(k).includes('change')) cls='green';
      if(typeof v === 'number' && v < 0 && String(k).includes('change')) cls='red';
      return `<div class="tile"><div class="k">${esc(label(k))}</div><div class="v cyan ${cls}">${fmt(v,k)}</div></div>`;
    }
    function kv(k,v){
      return `<div class="kv"><div class="k">${esc(label(k))}</div><div class="v">${fmt(v,k)}</div></div>`;
    }
    function panel(title,body){
      return `<div class="panel"><h3>${esc(VALUES[title] || title)}</h3>${body}</div>`;
    }
    function renderObj(obj){
      if(obj === null || obj === undefined) return '';
      if(Array.isArray(obj)){
        if(!obj.length) return '<div class="k">لا توجد بيانات</div>';
        return `<div class="cards-list">${obj.map((x,i)=>panel(x?.name || `#${i+1}`, renderObj(x))).join('')}</div>`;
      }
      if(typeof obj !== 'object') return `<div class="v">${fmt(obj)}</div>`;
      let rows='', nested='';
      for(const [k,v] of Object.entries(obj)){
        if(HIDE.has(k) || v === null || v === undefined || v === '') continue;
        if(typeof v === 'object') nested += panel(label(k), renderObj(v));
        else rows += kv(k,v);
      }
      return rows + nested;
    }
    function selectedAsset(){ return document.getElementById('asset').value || 'SPY'; }
    function urlFor(layer){
      if(layer === 16) return `${API}/layers/16/user-governance/${USER_ID}`;
      return `${API}/layers/${layer}/${ENDPOINTS[layer]}/${encodeURIComponent(selectedAsset())}`;
    }
    async function getJson(url){
      const res = await fetch(url,{cache:'no-store',headers:{Accept:'application/json'}});
      const json = await res.json();
      if(!res.ok) throw new Error(`HTTP ${res.status}`);
      return json;
    }
    function renderLayer(layer,data){
      if(layer === 1) return `<div class="tiles">${tile('currentPrice',data.currentPrice)}${tile('change24h',data.change24h)}${tile('dayHigh',data.dayHigh)}${tile('dayLow',data.dayLow)}${tile('volume',data.volume)}</div>`;
      if(layer === 2) return `<div class="tiles">${tile('overallSentiment',data.overallSentiment)}${tile('buyerPressure',data.buyerPressure)}${tile('sellerPressure',data.sellerPressure)}${tile('momentum',data.momentum)}${tile('marketCondition',data.marketCondition)}</div>`;
      if(layer === 3) return `<div class="tiles">${tile('trend',data.trend)}${tile('trendStrength',data.trendStrength)}${tile('dominantPattern',data.dominantPattern)}${tile('decisionPattern',data.decisionPattern)}${tile('timeframeAlignment',data.timeframeAlignment)}</div>`;
      if(layer === 4) return `<div class="tiles">${tile('primaryCriticalLevel',data.primaryCriticalLevel)}${tile('secondaryCriticalLevel',data.secondaryCriticalLevel)}${tile('breakoutProbability',data.breakoutProbability)}${tile('reversalProbability',data.reversalProbability)}${tile('referenceType',data.referenceType)}</div>`;
      if(layer === 5 && Array.isArray(data.scenarios)) return renderObj(data.scenarios);
      if(layer === 9) return `<div class="tiles">${tile('federalRate',data.federalRate)}${tile('inflationRate',data.inflationRate)}${tile('gdpGrowth',data.gdpGrowth)}${tile('dollarIndex',data.dollarIndex)}${tile('vixLevel',data.vixLevel)}${tile('macroEnvironment',data.macroEnvironment)}</div>${data.fomc ? panel('FOMC',renderObj(data.fomc)) : ''}${data.economicCalendar ? panel('التقويم الاقتصادي',renderObj(data.economicCalendar)) : ''}`;
      if(layer === 8) return `<div class="tiles">${tile('confidenceScore',data.confidenceScore)}${tile('horizonStrength',data.horizonStrength)}${tile('readingCompleteness',data.readingCompleteness)}${tile('recommendation',data.recommendation)}</div>`;
      return renderObj(data);
    }
    async function loadLayer(card){
