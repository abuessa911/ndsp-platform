    ['sourceName', 'مصدر البيانات'],
    ['sourceSymbol', 'رمز المصدر'],
    ['publicName', 'اسم العرض'],
    ['updatedAt', 'آخر تحديث'],
    ['currentPrice', 'السعر الحالي'],
    ['previousClose', 'الإغلاق السابق'],
    ['dayHigh', 'أعلى اليوم'],
    ['dayLow', 'أقل اليوم'],
    ['change24h', 'التغير 24 ساعة'],
    ['buyerPressure', 'ضغط المشترين'],
    ['sellerPressure', 'ضغط البائعين'],
    ['overallSentiment', 'قراءة السوق'],
    ['marketCondition', 'حالة السوق'],
    ['momentumConfirmation', 'تأكيد الزخم'],
    ['volumeConfirmation', 'تأكيد الحجم'],
    ['indicatorAlignment', 'توافق المؤشرات'],
    ['confirmationStatus', 'حالة التأكيد'],
    ['overallRiskLevel', 'مستوى الاعتراض'],
    ['safetyMargin', 'هامش الأمان'],
    ['invalidationLevels', 'مستويات الإلغاء'],
    ['riskNotes', 'اعتراضات محامي الشيطان'],
    ['suspendConditions', 'شروط التعليق']
  ];

  function textReplace(s){
    if (!s) return s;

    let out = String(s);

    replacePairs.forEach(function(pair){
      out = out.split(pair[0]).join(pair[1]);
    });

    out = out.replace(/\bLAYER\s*[0-9]+\b/gi, '');
    out = out.replace(/\bLayer\s*[0-9]+\b/g, '');

    return out;
  }

  function polishTextNodes(root){
    const walker = document.createTreeWalker(
      root || document.body,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode(node){
          if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
          const p = node.parentElement;
          if (!p) return NodeFilter.FILTER_REJECT;
          if (['SCRIPT','STYLE','TEXTAREA','INPUT'].includes(p.tagName)) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        }
      }
    );

    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);

    nodes.forEach(function(node){
      const old = node.nodeValue;
      const neu = textReplace(old);
      if (neu !== old) node.nodeValue = neu;
    });
  }

  function cleanErrors(){
    document.querySelectorAll('.error, [class*="error"]').forEach(function(el){
      const t = (el.textContent || '').trim();

      if (/HTTP\s*404|NOT_FOUND/i.test(t)) {
        el.classList.add('ndsp-governance-message');
        el.innerHTML =
          'هذه القراءة غير مفعّلة للعامة حالياً.<br>' +
          'مصدر البيانات الحقيقي غير مربوط بعد.<br>' +
          'لا يتم عرض بيانات تقديرية أو مصطنعة.';
      }

      if (/REAL_DATA_NOT_CONNECTED|غير متصل بمصدر حقيقي/i.test(t)) {
        el.classList.add('ndsp-governance-message');
      }
    });
  }

  function hideApiRoutes(){
    document.querySelectorAll('body *').forEach(function(el){
      if (!el.children.length) {
        const t = (el.textContent || '').trim();
        if (t === API || t.includes('https://api.ndsp.app/api/ndsp16')) {
          el.style.display = 'none';
        }
      }
    });
  }

  function removeEmptyBadges(){
    document.querySelectorAll('.badge, .layer-badge, [class*="badge"]').forEach(function(el){
      const t = (el.textContent || '').trim();
      if (!t || /^LAYER\s*\d+$/i.test(t)) {
        el.textContent = '';
        el.style.display = 'none';
      }
    });
  }

  async function renderStatusIfEmpty(){
    const title = document.getElementById('page-title');
    const activeTitle = title ? title.textContent.trim() : '';

    if (!activeTitle.includes('حالة النظام')) return;

    let target =
      document.getElementById('status-card') ||
      document.getElementById('layers-status-content') ||
      document.querySelector('#status .card') ||
      document.querySelector('.tab:not(.hidden) .card') ||
      document.querySelector('.section.active .card');

    if (!target) return;

    const raw = (target.textContent || '').trim();

    if (raw && raw.length > 20 && !raw.includes('حالة الطبقات')) return;

    try {
      const res = await fetch(API + '/layers/status', {cache:'no-store', headers:{Accept:'application/json'}});
      const json = await res.json();

      const rows = json.layers || json.modules || [
        {name:'السعر الحي', status:'متصل'},
        {name:'TDL', status:'متصل'},
        {name:'NMP', status:'متصل'},
        {name:'إشارة نواف الذهبية', status:'متصل'},
        {name:'إشارة نواف الذهبية المعززة', status:'متصل'},
        {name:'طبقة محامي الشيطان', status:'متصل'}
      ];

      target.innerHTML =
        '<h3>حالة الطبقات</h3>' +
        '<div class="ndsp-status-grid">' +
        rows.map(function(x){
          const name = textReplace(x.name || x.publicName || 'عنصر');
          let status = textReplace(x.status || x.truth_status || 'متصل');

          if (/real_connected|real_derived_connected|REAL_SOURCE_CONNECTED/i.test(status)) {
            status = 'متصل بمصدر حقيقي';
          }

          if (/not_connected|real_source_not_connected|REAL_DATA_NOT_CONNECTED/i.test(status)) {
            status = 'غير مفعّل للعامة / يحتاج مصدر حقيقي';
          }

          return '<div class="ndsp-status-item">' +
            '<div class="ndsp-status-name">' + escapeHtml(name) + '</div>' +
            '<div class="ndsp-status-value">' + escapeHtml(status) + '</div>' +
          '</div>';
        }).join('') +
        '</div>';
    } catch(e) {
      target.innerHTML =
        '<h3>حالة الطبقات</h3>' +
        '<div class="ndsp-governance-message">تعذر تحميل حالة النظام حالياً، ولا يتم عرض أي بيانات تقديرية.</div>';
    }
  }

  function escapeHtml(s){
    return String(s ?? '')
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#039;');
  }

  function polish(){
    hideApiRoutes();
    removeEmptyBadges();
    cleanErrors();
    polishTextNodes(document.body);
    renderStatusIfEmpty();
  }

  const observer = new MutationObserver(function(){
    clearTimeout(window.__ndspPolishTimer);
    window.__ndspPolishTimer = setTimeout(polish, 120);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function(){
      polish();
      observer.observe(document.body, {childList:true, subtree:true, characterData:true});
    });
  } else {
    polish();
    observer.observe(document.body, {childList:true, subtree:true, characterData:true});
  }

  setInterval(polish, 1500);
})();
</script>

