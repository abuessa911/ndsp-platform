    padding: 14px !important;
    line-height: 1.8 !important;
  }

  .ndsp-status-name {
    color: #22d3ee !important;
    font-weight: 900 !important;
    margin-bottom: 6px !important;
  }

  .ndsp-status-value {
    color: #e5e7eb !important;
