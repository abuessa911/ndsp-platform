      try{
        const json = await getJson(urlFor(layer));
        const data = json.data || json;
        card.innerHTML = `<div class="card-head"><div class="card-title">${esc(LAYER_TITLES[layer] || 'طبقة')}</div><span class="badge"></span></div>${renderLayer(layer,data)}`;
