      const section = document.getElementById(tab);
      section.querySelectorAll('.card[data-layer]').forEach(loadLayer);
      document.getElementById('last-update').textContent = 'آخر تحديث: ' + new Date().toLocaleTimeString('ar-SA');
    }
    function switchTab(tab){
      document.querySelectorAll('.tab').forEach(s=>s.classList.add('hidden'));
      document.getElementById(tab).classList.remove('hidden');
      document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('active',n.dataset.tab===tab));
      document.getElementById('page-title').textContent = TITLES[tab] || 'NDSP';
      loadTab(tab);
    }
    document.querySelectorAll('.nav').forEach(n=>n.addEventListener('click',()=>switchTab(n.dataset.tab)));
    document.getElementById('asset').addEventListener('change',()=>switchTab(document.querySelector('.nav.active').dataset.tab));
    getJson(`${API}/health`).then(()=>{
      document.getElementById('api-pill').textContent='API متصل';
      document.getElementById('api-pill').classList.add('ok');
    }).catch(()=>{
      document.getElementById('api-pill').textContent='API غير متصل';
    });
    switchTab('overview');
  </script>
<script id="ndsp-final-governance-polish-js">
(function(){
  'use strict';

  const API = 'https://api.ndsp.app/api/ndsp16';

  const replacePairs = [
    ['https://api.ndsp.app/api/ndsp16', ''],
    ['sidewaysScenario', 'السيناريو الجانبي'],
    ['bullishScenario', 'السيناريو الصاعد'],
