<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta http-equiv="Cache-Control" content="no-store" /><title>NDSP - منصة دعم القرار المالي المتقدم</title><style>
    :root{
      --bg:#030303;
      --panel:#111;
      --panel2:#171717;
      --line:#262626;
      --cyan:#22d3ee;
      --gold:#f5b51b;
      --green:#10b981;
      --red:#ef4444;
      --muted:#9ca3af;
      --text:#f8fafc;
      --soft:rgba(34,211,238,.12);
    }
    *{box-sizing:border-box}
    html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:Tahoma,Arial,sans-serif;overflow:hidden}
    body{display:flex;flex-direction:column}
    .gov{
      background:linear-gradient(90deg,rgba(127,29,29,.55),rgba(120,53,15,.45));
      border-bottom:2px solid var(--gold);
      color:var(--gold);
      text-align:center;
      padding:12px 16px;
      font-weight:800;
      line-height:1.8;
      font-size:14px;
    }
    .top{
      height:64px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      background:#151515;
      border-bottom:1px solid var(--line);
      padding:0 22px;
      flex:0 0 auto;
    }
    .brand{display:flex;align-items:center;gap:12px}
    .logo{
      width:42px;height:42px;border-radius:999px;
      display:grid;place-items:center;
      background:#0d0d0d;border:1px solid rgba(245,181,27,.4);
      color:var(--gold);font-weight:900;
    }
    .brand h1{margin:0;font-size:18px}
    .brand p{margin:3px 0 0;color:var(--muted);font-size:12px}
    .top-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .pill{
      border:1px solid var(--line);
      background:#0c0c0c;
      color:var(--muted);
      border-radius:10px;
      padding:8px 12px;
      font-size:13px;
      white-space:nowrap;
    }
    .pill.ok{color:var(--green);border-color:rgba(16,185,129,.25);background:rgba(16,185,129,.08)}
    .select{
      background:#111827;color:var(--text);border:1px solid #374151;
      padding:8px 10px;border-radius:8px;min-width:170px;
    }
    .layout{display:grid;grid-template-columns:270px minmax(0,1fr);min-height:0;flex:1}
    .side{
      background:#080808;
      border-left:1px solid var(--line);
      padding:18px 0;
      overflow-y:auto;
    }
    .side-title{
      color:var(--cyan);
      font-weight:900;
      padding:0 20px 12px;
      font-size:14px;
    }
    .nav{
      display:block;
      width:100%;
      background:transparent;
      border:0;
      color:#e5e7eb;
      text-align:right;
      padding:13px 20px;
      cursor:pointer;
      font-size:15px;
      border-right:4px solid transparent;
    }
    .nav:hover{background:#121212;color:var(--cyan)}
    .nav.active{background:#181818;color:var(--cyan);border-right-color:var(--cyan);font-weight:900}
    .main{
      min-width:0;
      overflow:auto;
      padding:22px;
      background:
        radial-gradient(circle at 30% 5%,rgba(245,181,27,.05),transparent 28%),
        #020202;
    }
    .page-head{
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      margin-bottom:18px;
      border-bottom:1px solid var(--line);
      padding-bottom:14px;
    }
    .page-head h2{margin:0;font-size:24px}
    .status-line{color:var(--muted);font-size:13px;direction:ltr;text-align:left}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:16px;align-items:start}
    .wide{grid-column:1/-1}
    .card{
      background:linear-gradient(180deg,#171717,#101010);
      border:1px solid var(--line);
      border-radius:14px;
      padding:16px;
      box-shadow:0 0 0 1px rgba(255,255,255,.015) inset;
      min-width:0;
    }
    .card-head{
      display:flex;align-items:center;justify-content:space-between;gap:10px;
      margin-bottom:14px;
    }
    .card-title{color:var(--cyan);font-weight:900;font-size:15px;line-height:1.5}
    .badge{
      color:var(--cyan);
      border:1px solid rgba(34,211,238,.35);
      background:rgba(34,211,238,.08);
      padding:4px 9px;
      border-radius:6px;
      font-size:12px;
      font-weight:900;
      direction:ltr;
      white-space:nowrap;
    }
    .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
    .tile{
      background:#0b0b0b;
      border:1px solid rgba(255,255,255,.07);
      border-radius:10px;
      padding:10px;
      min-height:74px;
    }
    .k{color:var(--muted);font-size:12px;line-height:1.5;margin-bottom:6px}
    .v{color:var(--text);font-size:16px;font-weight:900;line-height:1.55;word-break:break-word}
    .v.cyan{color:var(--cyan)}
    .v.green{color:var(--green)}
    .v.red{color:var(--red)}
    .panel{
      background:#0c0c0c;
      border:1px solid rgba(34,211,238,.14);
      border-radius:12px;
      padding:13px;
      margin:10px 0;
    }
    .panel h3{margin:0 0 10px;color:var(--cyan);font-size:14px}
    .kv{
      display:grid;
      grid-template-columns:minmax(130px,38%) minmax(0,1fr);
      gap:12px;
      border-bottom:1px solid rgba(255,255,255,.06);
      padding:8px 0;
      line-height:1.7;
    }
    .kv:last-child{border-bottom:0}
    .kv .k{margin:0}
    .kv .v{font-size:14px}
    .cards-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
    .loading{
      color:var(--cyan);
      min-height:90px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      font-weight:800;
    }
    .spin{
      width:16px;height:16px;border:2px solid var(--cyan);border-top-color:transparent;
      border-radius:999px;animation:spin .7s linear infinite;
    }
    @keyframes spin{to{transform:rotate(360deg)}}
    .error{
      color:#fecaca;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.35);
      border-radius:10px;padding:12px;line-height:1.8;direction:ltr;text-align:left;
      white-space:normal;word-break:break-word;
    }
    .note{
      background:rgba(245,181,27,.08);
      border:1px solid rgba(245,181,27,.2);
      color:var(--gold);
      border-radius:12px;
      padding:13px;
      line-height:1.8;
      margin-top:14px;
    }
    .hidden{display:none!important}
    @media(max-width:900px){
      .layout{grid-template-columns:1fr}
      .side{height:auto;display:flex;overflow:auto;padding:8px}
      .side-title{display:none}
      .nav{white-space:nowrap;border-right:0;border-bottom:3px solid transparent}
      .nav.active{border-bottom-color:var(--cyan)}
      .grid{grid-template-columns:1fr}
      .top{height:auto;align-items:flex-start;flex-direction:column;padding:14px}
    }
  </style>
<style id="ndsp-final-governance-polish-css">
  #route-line,
  .route-line,
  .api-route,
  .api-url,
  .data-source,
  [data-source],
  [class*="data-source"] {
    display: none !important;
  }

  .ndsp-governance-message {
    background: rgba(245,181,27,0.08) !important;
