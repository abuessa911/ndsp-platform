<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>منصة نواف لدعم القرار</title>
  <style>
    :root{
      --bg:#050505;
      --panel:#111111;
      --panel2:#17130a;
      --line:rgba(245,196,76,.22);
      --line2:rgba(255,255,255,.08);
      --gold:#f5c44c;
      --gold2:#d7a92f;
      --text:#f4f4f4;
      --muted:#aaa;
      --green:#35d083;
      --red:#ff5b61;
      --radius:28px;
      --shadow:0 30px 90px rgba(0,0,0,.55);
    }

    *{box-sizing:border-box}

    body{
      margin:0;
      min-height:100vh;
      background:
        radial-gradient(circle at 75% 0%, rgba(245,196,76,.13), transparent 30%),
        radial-gradient(circle at 16% 35%, rgba(245,196,76,.08), transparent 32%),
        linear-gradient(180deg,#050505 0%,#070707 55%,#030303 100%);
      color:var(--text);
      font-family:system-ui,-apple-system,"Segoe UI",Tahoma,Arial,sans-serif;
    }

    a{text-decoration:none;color:inherit}
    button,input,select,textarea{font:inherit}

    .topbar{
      position:sticky;
      top:0;
      z-index:20;
      min-height:104px;
      padding:22px 48px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:22px;
      background:rgba(5,5,5,.9);
      backdrop-filter:blur(18px);
      border-bottom:1px solid var(--line2);
    }

    .brand{
      display:flex;
      align-items:center;
      gap:16px;
    }

    .mark{
      width:58px;
      height:58px;
      display:grid;
      place-items:center;
      border-radius:50%;
      color:var(--gold);
      font-weight:950;
      background:rgba(245,196,76,.08);
      border:1px solid var(--line);
    }

    .brand strong{
      display:block;
      font-size:28px;
      font-weight:950;
    }

    .brand span{
      display:block;
      color:var(--muted);
      margin-top:5px;
      font-size:14px;
    }

    .actions{
      display:flex;
      align-items:center;
      justify-content:flex-end;
      gap:12px;
      flex-wrap:wrap;
    }

    .pill{
      height:48px;
      padding:0 17px;
      border-radius:15px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      white-space:nowrap;
      border:1px solid var(--line2);
      background:rgba(255,255,255,.035);
      color:#c9c9c9;
      font-weight:800;
      font-size:14px;
    }

    .pill.gold{
      color:var(--gold);
      border-color:rgba(245,196,76,.35);
      background:rgba(245,196,76,.08);
    }

    .pill.green{
      color:var(--green);
      border-color:rgba(53,208,131,.28);
      background:rgba(53,208,131,.10);
    }

    .btn{
      min-height:54px;
      padding:0 24px;
      border-radius:16px;
      border:0;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      white-space:nowrap;
      font-weight:950;
      transition:.18s ease;
    }

    .btn.primary{
      background:linear-gradient(135deg,#ffe077,#f5c44c,#d7a92f);
      color:#0b0b0b;
      box-shadow:0 14px 34px rgba(245,196,76,.16);
    }

    .btn.secondary{
      border:1px solid rgba(245,196,76,.34);
      background:rgba(255,255,255,.035);
      color:var(--gold);
    }

    .btn:hover{transform:translateY(-1px)}
    .btn:disabled{opacity:.55;cursor:not-allowed;transform:none}

    .page{
      width:min(1480px,calc(100% - 80px));
      margin:0 auto;
      padding:54px 0 60px;
    }

    .layout{
      display:grid;
      grid-template-columns:.94fr 1.06fr;
      gap:34px;
      align-items:stretch;
    }

    .card{
      border:1px solid var(--line);
      border-radius:34px;
      box-shadow:var(--shadow);
      background:
        radial-gradient(circle at 78% 0%, rgba(245,196,76,.17), transparent 34%),
        linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.016));
      overflow:hidden;
    }

    .info{
      padding:54px;
      display:flex;
      flex-direction:column;
      justify-content:center;
      min-height:690px;
    }

    .tag{
      width:max-content;
      max-width:100%;
      padding:10px 16px;
      border:1px solid rgba(245,196,76,.25);
      border-radius:999px;
      background:rgba(245,196,76,.08);
      color:var(--gold);
      font-weight:900;
      margin-bottom:24px;
    }

    h1{
      margin:0;
      font-size:clamp(42px,5vw,76px);
      line-height:1.08;
      font-weight:950;
      letter-spacing:-1px;
    }

    .lead{
      margin:28px 0 0;
      color:#c7c7c7;
      font-size:22px;
      line-height:1.9;
    }

    .notice{
      margin-top:32px;
      padding:24px;
      border-radius:24px;
      border:1px solid rgba(245,196,76,.24);
      background:linear-gradient(135deg,rgba(245,196,76,.10),rgba(255,255,255,.02));
      color:#d8d8d8;
      line-height:1.9;
      font-size:17px;
    }

    .notice b{color:var(--gold)}

    .steps{
      margin-top:32px;
      display:grid;
      gap:13px;
    }

    .step{
      display:flex;
      align-items:center;
      gap:14px;
      padding:17px;
      border-radius:18px;
      border:1px solid var(--line2);
      background:rgba(0,0,0,.22);
      color:#d8d8d8;
      font-weight:800;
    }

    .step span{
      width:34px;
      height:34px;
      display:grid;
      place-items:center;
      flex:0 0 34px;
      border-radius:12px;
      border:1px solid rgba(245,196,76,.22);
      background:rgba(245,196,76,.10);
      color:var(--gold);
      font-weight:950;
    }

    .form-card{
      padding:34px;
      min-height:690px;
      background:
        radial-gradient(circle at 15% 0%, rgba(245,196,76,.12), transparent 36%),
        linear-gradient(150deg,rgba(22,19,12,.88),rgba(14,14,14,.98));
    }

    .form-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:16px;
      margin-bottom:24px;
    }

    .form-head h2{
      margin:0;
      font-size:40px;
      line-height:1.2;
      font-weight:950;
    }

    .form-head p{
      margin:12px 0 0;
      color:var(--muted);
      line-height:1.8;
    }

    form{display:grid;gap:14px}

    .grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
    }

    label{
      display:block;
      margin-bottom:8px;
      color:#d8d8d8;
      font-size:14px;
      font-weight:850;
    }

    input,select,textarea{
      width:100%;
      min-height:56px;
      border-radius:17px;
      border:1px solid rgba(255,255,255,.10);
      background:rgba(0,0,0,.38);
      color:var(--text);
      outline:none;
      padding:16px 17px;
      transition:.18s ease;
    }

    textarea{
      min-height:108px;
      resize:vertical;
      line-height:1.7;
    }

    input::placeholder,textarea::placeholder{color:#777}

    input:focus,select:focus,textarea:focus{
      border-color:rgba(245,196,76,.56);
      box-shadow:0 0 0 4px rgba(245,196,76,.08);
    }

    .full{grid-column:1/-1}

    .message{
      display:none;
      padding:15px 16px;
      border-radius:18px;
      line-height:1.8;
      font-weight:850;
      white-space:pre-wrap;
    }

    .message.ok{
      display:block;
      color:#75e7aa;
      background:rgba(53,208,131,.10);
      border:1px solid rgba(53,208,131,.26);
    }

    .message.err{
      display:block;
      color:#ff999d;
      background:rgba(255,91,97,.12);
      border:1px solid rgba(255,91,97,.28);
    }

    .submit{
      margin-top:6px;
      display:grid;
      gap:12px;
    }

    .submit .btn{
      width:100%;
      min-height:60px;
      font-size:17px;
    }

    .fine{
      margin:0;
      color:#8e8e8e;
      font-size:13px;
      line-height:1.8;
    }

    @media(max-width:1100px){
      .topbar{
        padding:20px;
        align-items:stretch;
        flex-direction:column;
      }
      .actions{justify-content:flex-start}
      .page{width:min(100% - 32px,780px)}
      .layout{grid-template-columns:1fr}
      .info,.form-card{min-height:auto}
    }

    @media(max-width:640px){
      .info,.form-card{padding:26px}
      h1{font-size:42px}
      .lead{font-size:18px}
      .grid{grid-template-columns:1fr}
    }
