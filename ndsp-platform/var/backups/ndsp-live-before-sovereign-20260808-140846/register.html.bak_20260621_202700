<script>
(function(){
  "use strict";

  function clean(v){
    return String(v || "").trim();
  }

  function bySelector(selectors){
    for (var i = 0; i < selectors.length; i++){
      var el = document.querySelector(selectors[i]);
      if (el) return el;
    }
    return null;
  }

  function findInputByText(words, tagList){
    tagList = tagList || ["input", "textarea", "select"];
    var nodes = [];
    tagList.forEach(function(tag){
      document.querySelectorAll(tag).forEach(function(el){
        nodes.push(el);
      });
    });

    for (var i = 0; i < nodes.length; i++){
      var el = nodes[i];
      var txt = [
        el.name,
        el.id,
        el.placeholder,
        el.getAttribute("aria-label"),
        el.getAttribute("data-field"),
        el.getAttribute("autocomplete")
      ].join(" ").toLowerCase();

      for (var j = 0; j < words.length; j++){
        if (txt.indexOf(words[j].toLowerCase()) !== -1){
          return el;
        }
      }
    }
    return null;
  }

  function getValue(selectors, words, tagList){
    var el = bySelector(selectors) || findInputByText(words, tagList);
    return el ? clean(el.value) : "";
  }

  function getUserType(){
    var el =
      bySelector([
        'select[name="segment"]',
        'select[name="user_type"]',
        'select[name="type"]',
        'select[name="plan"]',
        'select'
      ]) || findInputByText(["نوع", "segment", "user", "type"], ["select", "input"]);

    var raw = el ? clean(el.value || (el.options && el.options[el.selectedIndex] ? el.options[el.selectedIndex].text : "")) : "";
    var txt = raw.toLowerCase();

    if (
      txt.indexOf("professional") !== -1 ||
      txt.indexOf("pro") !== -1 ||
      txt.indexOf("متخصص") !== -1 ||
      txt.indexOf("أكاديمي") !== -1 ||
      txt.indexOf("اكاديمي") !== -1 ||
      txt.indexOf("محترف") !== -1
    ){
      return "professional";
    }

    if (
      txt.indexOf("private") !== -1 ||
      txt.indexOf("invite") !== -1 ||
      txt.indexOf("خاص") !== -1 ||
      txt.indexOf("دعوة") !== -1 ||
      txt.indexOf("مميز") !== -1
    ){
      return "private-invite";
    }

    return "ordinary";
  }

  function endpointFor(segment){
    if (segment === "professional") {
      return "/api/trial/register/professional";
    }
    if (segment === "private-invite") {
      return "/api/trial/register/private-invite";
    }
    return "/api/trial/register/ordinary";
  }

  function findSubmitButton(){
    var buttons = Array.prototype.slice.call(document.querySelectorAll("button, input[type='submit'], a"));
    for (var i = 0; i < buttons.length; i++){
      var b = buttons[i];
      var txt = clean(b.innerText || b.value || b.textContent);
      if (
        txt.indexOf("إرسال طلب التسجيل") !== -1 ||
        txt.indexOf("ارسال طلب التسجيل") !== -1 ||
        txt.indexOf("طلب التسجيل") !== -1 ||
        txt.indexOf("إرسال الطلب") !== -1 ||
        txt.indexOf("ارسال الطلب") !== -1
      ){
        return b;
      }
    }
    return document.querySelector('button[type="submit"], input[type="submit"]');
  }

  function showMessage(type, msg){
    var box = document.querySelector("[data-register-message]");

    if (!box){
      box = document.createElement("div");
      box.setAttribute("data-register-message", "1");

      var btn = findSubmitButton();
      var form = document.querySelector("form");

      if (btn && btn.parentElement){
        btn.parentElement.insertBefore(box, btn);
      } else if (form) {
        form.appendChild(box);
      } else {
        document.body.appendChild(box);
      }
    }

    box.textContent = msg;
    box.style.display = "block";
    box.style.margin = "16px 0";
    box.style.padding = "16px 18px";
    box.style.borderRadius = "18px";
    box.style.fontWeight = "800";
    box.style.lineHeight = "1.8";
    box.style.whiteSpace = "pre-wrap";
    box.style.direction = "rtl";

    if (type === "ok"){
      box.style.background = "rgba(20, 120, 70, 0.22)";
      box.style.border = "1px solid rgba(55, 220, 130, 0.42)";
      box.style.color = "#7CFFB2";
    } else {
      box.style.background = "rgba(140, 35, 35, 0.30)";
      box.style.border = "1px solid rgba(255, 95, 95, 0.50)";
      box.style.color = "#FFB4B4";
    }
  }

  function setLoading(loading){
    var btn = findSubmitButton();
    if (!btn) return;

    if (loading){
      btn.setAttribute("data-old-text", btn.innerText || btn.value || "");
      if (btn.tagName.toLowerCase() === "input") {
        btn.value = "جاري إرسال الطلب...";
      } else {
        btn.innerText = "جاري إرسال الطلب...";
      }
      btn.disabled = true;
      btn.style.opacity = "0.75";
      btn.style.pointerEvents = "none";
    } else {
      var old = btn.getAttribute("data-old-text") || "إرسال طلب التسجيل";
      if (btn.tagName.toLowerCase() === "input") {
        btn.value = old;
      } else {
        btn.innerText = old;
      }
      btn.disabled = false;
      btn.style.opacity = "";
      btn.style.pointerEvents = "";
    }
  }

  async function submitRegister(ev){
    if (ev){
      ev.preventDefault();
      ev.stopPropagation();
      if (ev.stopImmediatePropagation) ev.stopImmediatePropagation();
    }

    var name = getValue(
      ['input[name="name"]','input[name="full_name"]','input[name="fullName"]'],
      ["name", "full", "الاسم", "اسم"]
    );

    var email = getValue(
      ['input[name="email"]','input[type="email"]'],
      ["email", "mail", "البريد", "الإلكتروني", "الالكتروني"]
    );

    var phone = getValue(
      ['input[name="phone"]','input[name="mobile"]','input[type="tel"]'],
      ["phone", "mobile", "tel", "الجوال", "الهاتف"]
    );

    var invite_code = getValue(
      ['input[name="invite"]','input[name="invite_code"]','input[name="inviteCode"]','input[name="code"]'],
      ["invite", "code", "رمز", "الدعوة"]
    );

    var password = getValue(
      ['input[name="password"]','input[type="password"]'],
      ["password", "كلمة المرور"]
    );

    var confirm_password = getValue(
      ['input[name="confirm_password"]','input[name="password_confirm"]','input[name="confirmPassword"]'],
      ["confirm", "تأكيد"]
    );

    var notes = getValue(
      ['textarea[name="notes"]','textarea[name="note"]','textarea'],
      ["notes", "note", "ملاحظات"],
      ["textarea"]
    );

    var segment = getUserType();
    var endpoint = endpointFor(segment);

    if (!name || !email || !phone){
      showMessage("err", "أكمل الاسم والبريد الإلكتروني ورقم الجوال.");
      return false;
    }

    if (password && confirm_password && password !== confirm_password){
      showMessage("err", "كلمة المرور وتأكيد كلمة المرور غير متطابقين.");
      return false;
    }

    var payload = {
      name: name,
      full_name: name,
      email: email,
      phone: phone,
      mobile: phone,
      segment: segment,
      user_type: segment,
      type: segment,
      invite_code: invite_code,
      invite: invite_code,
      code: invite_code,
      notes: notes,
      note: notes,
      password: password,
      confirm_password: confirm_password,
      source: "ndsp_public_register_page_same_origin",
      page: "register.html"
    };

    setLoading(true);
    showMessage("ok", "جاري إرسال طلب التسجيل...");

    try {
      var res = await fetch(endpoint, {
        method: "POST",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        body: JSON.stringify(payload)
      });

      var text = await res.text();
      var data = null;

      try {
        data = JSON.parse(text);
      } catch(e) {
        data = null;
      }

      if (!res.ok){
        var errMsg = "";

        if (data && (data.detail || data.message || data.error)){
          errMsg = data.detail || data.message || data.error;
        } else {
          errMsg = text || ("HTTP: " + res.status);
        }

        showMessage("err", "تعذر إرسال الطلب.\nHTTP: " + res.status + "\n" + errMsg);
        setLoading(false);
        return false;
      }

      showMessage(
        "ok",
        "تم إرسال طلب التسجيل بنجاح.\nسيتم مراجعة الطلب وتفعيل الحساب حسب سياسة التجربة."
      );

      setLoading(false);
      return true;

    } catch (err){
      showMessage("err", "تعذر إرسال الطلب. تحقق من الاتصال أو إعدادات الخادم.\n" + String(err && err.message ? err.message : err));
      setLoading(false);
      return false;
    }
  }

  document.addEventListener("submit", function(ev){
    var form = ev.target;
    if (!form || form.tagName.toLowerCase() !== "form") return;
    submitRegister(ev);
  }, true);

  document.addEventListener("click", function(ev){
    var btn = ev.target.closest ? ev.target.closest("button, input[type='submit'], a") : null;
    if (!btn) return;

    var txt = clean(btn.innerText || btn.value || btn.textContent);
    if (
      txt.indexOf("إرسال طلب التسجيل") !== -1 ||
      txt.indexOf("ارسال طلب التسجيل") !== -1 ||
      txt.indexOf("طلب التسجيل") !== -1 ||
      txt.indexOf("إرسال الطلب") !== -1 ||
      txt.indexOf("ارسال الطلب") !== -1
    ){
      submitRegister(ev);
    }
  }, true);

  window.NDSP_REGISTER_SAME_ORIGIN_FIX = {
    endpointFor: endpointFor,
    submit: submitRegister
  };
})();
</script>
<!-- NDSP_REGISTER_SAME_ORIGIN_FIX_END -->


