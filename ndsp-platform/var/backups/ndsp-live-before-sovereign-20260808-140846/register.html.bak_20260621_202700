    return String(url)
      .replace("/api/trial/register/", "/api/trial/register/")
      .replace("/api/trial/register/", "/api/trial/register/")
      .replace("/api/trial/register/", "/api/trial/register/")
      .replace("/api/trial/register/", "/api/trial/register/")
      .replace("/api/trial/invites/validate", "/api/trial/invites/validate")
