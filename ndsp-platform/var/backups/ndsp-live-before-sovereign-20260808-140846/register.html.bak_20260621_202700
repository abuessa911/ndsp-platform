  <script>
    const form = document.getElementById("trialForm");
    const msg = document.getElementById("message");
    const submitBtn = document.getElementById("submitBtn");

    function endpointBySegment(segment){
      if(segment === "professional") return "/api/trial/register/professional";
      if(segment === "private-invite") return "/api/trial/register/private-invite";
      return "/api/trial/register/ordinary";
    }

    function showMessage(type, text){
      msg.className = "message " + type;
      msg.textContent = text;
      msg.scrollIntoView({behavior:"smooth", block:"center"});
    }

    function normalizePhone(phone){
      let v = String(phone || "").trim();
      v = v.replace(/[^\d+]/g, "");
      if(v.startsWith("00966")) v = "+966" + v.slice(5);
      if(v.startsWith("966") && !v.startsWith("+966")) v = "+" + v;
      if(v.startsWith("05")) v = "+966" + v.slice(1);
      if(v.startsWith("5")) v = "+966" + v;
      return v;
    }

    function extractErrorText(data, fallback){
      if(!data) return fallback;
      if(typeof data === "string") return data || fallback;
      if(typeof data.message === "string") return data.message;
      if(typeof data.error === "string") return data.error;
      if(typeof data.detail === "string") return data.detail;
      if(Array.isArray(data.detail)) return data.detail.map(x => x.msg || JSON.stringify(x)).join("\\n");
      try { return JSON.stringify(data, null, 2); } catch(e) { return fallback; }
    }

    async function readResponse(res){
      const text = await res.text();
      if(!text) return null;
      try { return JSON.parse(text); } catch(e) { return text; }
    }

    form.addEventListener("submit", async function(e){
      e.preventDefault();

      const fd = new FormData(form);

      const name = String(fd.get("name") || "").trim();
      const email = String(fd.get("email") || "").trim();
      const phone = normalizePhone(fd.get("phone"));
      const segment = String(fd.get("segment") || "ordinary");
      const invite_code = String(fd.get("invite_code") || "").trim();
      const notes = String(fd.get("notes") || "").trim();
      const password = String(fd.get("password") || "");
      const password_confirm = String(fd.get("password_confirm") || "");

      if(!name || !email || !phone){
        showMessage("err", "أكمل الاسم والبريد ورقم الجوال.");
        return;
      }

      if(password.length < 8){
        showMessage("err", "كلمة المرور يجب أن تكون 8 أحرف على الأقل.");
        return;
      }

      if(password !== password_confirm){
        showMessage("err", "كلمة المرور وتأكيدها غير متطابقين.");
        return;
      }

      const endpoint = endpointBySegment(segment);

      /*
        نرسل أكثر من اسم للحقل لأن بوابات التسجيل القديمة والجديدة قد تستخدم:
        name أو full_name
        invite_code أو invite
        password_confirm أو confirm_password
      */
      const payload = {
        name,
        full_name: name,
        email,
        phone,
        mobile: phone,
        segment,
        user_type: segment,
        invite_code,
        invite: invite_code,
        notes,
        message: notes,
        password,
        password_confirm,
        confirm_password: password_confirm
      };

      submitBtn.disabled = true;
      submitBtn.textContent = "جاري إرسال الطلب...";
      showMessage("ok", "جاري إرسال الطلب إلى بوابة التسجيل...");

      try{
        const res = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          credentials: "include",
          body: JSON.stringify(payload)
        });

        const data = await readResponse(res);

        if(res.ok){
          showMessage("ok", "تم إرسال طلب التسجيل بنجاح. راجع بريدك أو انتظر مراجعة التفعيل.");
          form.reset();
          return;
        }

        const errorText = extractErrorText(
          data,
          "تعذر إرسال الطلب."
        );

        showMessage(
          "err",
          "تعذر إرسال الطلب.\n" +
          "HTTP: " + res.status + "\n" +
          errorText
        );
      }catch(err){
        showMessage(
          "err",
          "تعذر الاتصال بخدمة التسجيل من المتصفح.\n" +
          "السبب: " + (err && err.message ? err.message : String(err))
        );
      }finally{
        submitBtn.disabled = false;
        submitBtn.textContent = "إرسال طلب التسجيل";
      }
    });
  </script>




