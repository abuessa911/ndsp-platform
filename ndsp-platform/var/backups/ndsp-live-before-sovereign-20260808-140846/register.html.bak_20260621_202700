      .replace("/api/trial/invites/validate", "/api/trial/invites/validate")
      .replace("/api/trial/invites/validate", "/api/trial/invites/validate");
  }

  var oldFetch = window.fetch;
  if (oldFetch) {
    window.fetch = function(input, init){
      try {
        if (typeof input === "string") {
          input = fixUrl(input);
